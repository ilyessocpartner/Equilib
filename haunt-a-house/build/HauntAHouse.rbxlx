	{ Id = "mini_reaper", Name = "Mini Faucheuse", Rarity = "Epic", Power = 40, Visual = V("Cylinder", { 30, 30, 40 }, "Fabric", "glow", "none", "hood", "glow", { 120, 255, 160 }, 1.1) },

	-- Cercueil en Fer
