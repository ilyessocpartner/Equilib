	{ Id = "nightmare_clown", Name = "Clown Cauchemar", Rarity = "Legendary", Power = 3500, KeepOnRebirth = true, Visual = V("Ball", { 250, 250, 250 }, "SmoothPlastic", "angry", "smile", "jester", "none", { 255, 40, 40 }, 1.15) },
