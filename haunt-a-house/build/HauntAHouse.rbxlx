      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Acces aux objets distants. Le serveur les cree, le client les attend.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.FolderName = "Remotes"
Net.Names = {
	Request = "Request", -- RemoteFunction client -> serveur (action, payload)
	ServerEvent = "ServerEvent", -- RemoteEvent serveur -> client (nom, payload)
	ClientEvent = "ClientEvent", -- RemoteEvent client -> serveur (nom, payload)
}

local function getFolder()
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(Net.FolderName)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = Net.FolderName
			folder.Parent = ReplicatedStorage
		end
		return folder
	end
	return ReplicatedStorage:WaitForChild(Net.FolderName)
end

local function getRemote(name, className)
	local folder = getFolder()
	if RunService:IsServer() then
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
		return remote
	end
	return folder:WaitForChild(name)
end

function Net.request()
	return getRemote(Net.Names.Request, "RemoteFunction")
end

function Net.serverEvent()
	return getRemote(Net.Names.ServerEvent, "RemoteEvent")
end

function Net.clientEvent()
	return getRemote(Net.Names.ClientEvent, "RemoteEvent")
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Offers</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Logique pure des offres : pack de demarrage et offres flash tournantes.
local Config = require(script.Parent.Config)

local Offers = {}

-- Retourne l'index de l'offre flash active et le temps restant avant rotation.
function Offers.getFlashDeal(now)
	local deals = Config.FlashDeals.Deals
	local rotation = Config.FlashDeals.RotationSeconds
	local slot = math.floor(now / rotation)
	local index = (slot % #deals) + 1
	local remaining = rotation - (now % rotation)
	return index, deals[index], remaining
end

-- Temps restant (secondes) du pack de demarrage, 0 si expire ou deja achete.
function Offers.starterRemaining(firstJoin, purchased, now)
	if purchased then
		return 0
	end
	if not firstJoin or firstJoin <= 0 then
		return Config.StarterPack.WindowSeconds
	end
	local remaining = (firstJoin + Config.StarterPack.WindowSeconds) - now
	return math.max(0, remaining)
end

return Offers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Raretes des monstres : ordre, couleurs et multiplicateurs de revente.
local Rarity = {}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Rarity.Info = {
	Common = { Rank = 1, Label = "Commun", Color = { 190, 190, 200 }, SellFactor = 0.15, Announce = false },
	Uncommon = { Rank = 2, Label = "Peu commun", Color = { 90, 220, 110 }, SellFactor = 0.4, Announce = false },
	Rare = { Rank = 3, Label = "Rare", Color = { 70, 150, 255 }, SellFactor = 1.2, Announce = false },
	Epic = { Rank = 4, Label = "Epique", Color = { 190, 90, 255 }, SellFactor = 4, Announce = false },
	Legendary = { Rank = 5, Label = "Legendaire", Color = { 255, 170, 40 }, SellFactor = 15, Announce = true },
	Mythic = { Rank = 6, Label = "Mythique", Color = { 255, 70, 120 }, SellFactor = 60, Announce = true },
	Secret = { Rank = 7, Label = "Secret", Color = { 40, 40, 50 }, SellFactor = 300, Announce = true },
}

function Rarity.rank(name)
	local info = Rarity.Info[name]
	return info and info.Rank or 1
end

function Rarity.label(name)
	local info = Rarity.Info[name]
	return info and info.Label or name
end

function Rarity.color(name)
	local info = Rarity.Info[name]
	if not info then
		return 200, 200, 200
	end
	return info.Color[1], info.Color[2], info.Color[3]
end

return Rarity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SeasonPass</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Passe de saison : paliers, XP et recompenses (logique pure).
local SeasonPass = {}

SeasonPass.TierCount = 20

function SeasonPass.xpForTier(tier)
	return 1200 + 250 * tier
end

function SeasonPass.totalXpForTier(tier)
	local total = 0
	for t = 1, tier do
		total += SeasonPass.xpForTier(t)
	end
	return total
end

-- Palier atteint pour une quantite d'XP
function SeasonPass.tierForXp(xp)
	local tier = 0
	local acc = 0
	for t = 1, SeasonPass.TierCount do
		acc += SeasonPass.xpForTier(t)
		if xp >= acc then
			tier = t
		else
			break
		end
	end
	return tier
end

-- Progression dans le palier courant : xp dans le palier, xp requis
function SeasonPass.progress(xp)
	local tier = SeasonPass.tierForXp(xp)
	if tier >= SeasonPass.TierCount then
		return tier, 1, 1
	end
	local base = SeasonPass.totalXpForTier(tier)
	local need = SeasonPass.xpForTier(tier + 1)
	return tier, xp - base, need
end

local function coins(amount)
	return { Type = "Coins", Amount = amount }
end

SeasonPass.Rewards = {
	[1] = { Free = coins(500), Premium = coins(2500) },
	[2] = { Free = coins(800), Premium = { Type = "CoinsBoost", Minutes = 20 } },
	[3] = { Free = coins(1200), Premium = coins(5000) },
	[4] = { Free = { Type = "CoinsBoost", Minutes = 10 }, Premium = { Type = "LuckBoost", Minutes = 30 } },
	[5] = { Free = coins(2500), Premium = { Type = "NightmareCoffin", Amount = 2 } },
	[6] = { Free = coins(3500), Premium = coins(12000) },
	[7] = { Free = { Type = "LuckBoost", Minutes = 10 }, Premium = { Type = "CoinsBoost", Minutes = 45 } },
	[8] = { Free = coins(5000), Premium = coins(20000) },
	[9] = { Free = coins(6500), Premium = { Type = "LuckBoost", Minutes = 45 } },
	[10] = { Free = { Type = "NightmareCoffin", Amount = 1 }, Premium = { Type = "Monster", Id = "pass_phantom" } },
	[11] = { Free = coins(9000), Premium = coins(35000) },
	[12] = { Free = { Type = "CoinsBoost", Minutes = 15 }, Premium = { Type = "CoinsBoost", Minutes = 60 } },
	[13] = { Free = coins(12000), Premium = coins(50000) },
	[14] = { Free = coins(15000), Premium = { Type = "NightmareCoffin", Amount = 3 } },
	[15] = { Free = { Type = "LuckBoost", Minutes = 15 }, Premium = { Type = "LuckBoost", Minutes = 60 } },
	[16] = { Free = coins(20000), Premium = coins(80000) },
	[17] = { Free = coins(25000), Premium = { Type = "CoinsBoost", Minutes = 90 } },
	[18] = { Free = { Type = "NightmareCoffin", Amount = 1 }, Premium = { Type = "NightmareCoffin", Amount = 5 } },
	[19] = { Free = coins(35000), Premium = coins(150000) },
	[20] = { Free = { Type = "NightmareCoffin", Amount = 2 }, Premium = { Type = "Monster", Id = "season_reaper" } },
}

function SeasonPass.describe(reward)
	if reward.Type == "Coins" then
		return tostring(reward.Amount) .. " coins"
	elseif reward.Type == "CoinsBoost" then
		return "2x Coins " .. reward.Minutes .. " min"
	elseif reward.Type == "LuckBoost" then
		return "2x Chance " .. reward.Minutes .. " min"
	elseif reward.Type == "NightmareCoffin" then
		return reward.Amount .. " Cercueil(s) Cauchemar"
	elseif reward.Type == "Monster" then
		return "Monstre exclusif"
	end
	return "?"
end

return SeasonPass
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Petits utilitaires partages.
local HttpService = game:GetService("HttpService")

local Util = {}

function Util.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = Util.deepCopy(v)
	end
	return copy
end

function Util.uid()
	return HttpService:GenerateGUID(false)
end

function Util.now()
	return os.time()
end

function Util.isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function Util.color(rgb)
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

-- Reessaie une fonction avec attente exponentielle. Retourne ok, resultat/erreur.
function Util.retry(attempts, baseDelay, fn, ...)
	local lastError
	for attempt = 1, attempts do
		local ok, result = pcall(fn, ...)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < attempts then
			task.wait(baseDelay * (2 ^ (attempt - 1)))
		end
	end
	return false, lastError
end

-- Cree une Part avec des proprietes en une ligne.
function Util.part(props)
	local className = props.ClassName or "Part"
	local part = Instance.new(className)
	part.Anchored = true
	part.CanCollide = props.CanCollide ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape and className == "Part" then
		part.Shape = Enum.PartType[props.Shape]
	end
	part.Size = props.Size or Vector3.new(1, 1, 1)
	part.CFrame = props.CFrame or CFrame.new()
	if props.Color then
		part.Color = typeof(props.Color) == "Color3" and props.Color or Util.color(props.Color)
	end
	part.Material = Enum.Material[props.Material or "SmoothPlastic"]
	part.Transparency = props.Transparency or 0
	part.Name = props.Name or className
	part.CastShadow = props.CastShadow ~= false
	if props.Parent then
		part.Parent = props.Parent
	end
	return part
end

function Util.weld(a, b)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = a
	weld.Part1 = b
	weld.Parent = a
	return weld
end

function Util.clamp(n, lo, hi)
	return math.max(lo, math.min(hi, n))
end

function Util.round(n)
	return math.floor(n + 0.5)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
