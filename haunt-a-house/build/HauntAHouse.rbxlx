	InstantRebirth = { Id = 0, Price = 349, Name = "Rebirth instantane" },
	StarterPack = { Id = 0, Price = 99, Name = "Pack de demarrage" },
	FlashCoinVault = { Id = 0, Price = 399, Name = "Offre flash : Coffre +50%" },
