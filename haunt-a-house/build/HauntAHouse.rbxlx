      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">NetServer</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Reception des requetes clients : validation, limitation de debit, dispatch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)

local NetServer = {}

local handlers = {} -- [action] = { Fn = function, Limit = string }
local eventHandlers = {} -- [name] = function
local buckets = {} -- [player] = { [limitKey] = { Count, Window } }
local S

local function allowed(player, limitKey)
	local limit = Config.RateLimits[limitKey] or Config.RateLimits.Default
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local now = os.clock()
	local bucket = playerBuckets[limitKey]
	if not bucket or now - bucket.Window >= 1 then
		bucket = { Count = 0, Window = now }
		playerBuckets[limitKey] = bucket
	end
	bucket.Count += 1
	return bucket.Count <= limit
end

function NetServer.register(action, limitKey, fn)
	handlers[action] = { Fn = fn, Limit = limitKey or "Default" }
end

function NetServer.onEvent(name, fn)
	eventHandlers[name] = fn
end

function NetServer.fire(player, name, payload)
	if player and player.Parent then
		Net.serverEvent():FireClient(player, name, payload)
	end
end

function NetServer.fireAll(name, payload)
	Net.serverEvent():FireAllClients(name, payload)
end

function NetServer.notify(player, text, kind)
	NetServer.fire(player, "Notify", { Text = text, Kind = kind or "info" })
end

function NetServer.announce(text, kind)
	NetServer.fireAll("Announce", { Text = text, Kind = kind or "info" })
end

function NetServer.init(services)
	S = services
	Net.request().OnServerInvoke = function(player, action, payload)
		if type(action) ~= "string" then
			return { ok = false, message = "Requête invalide." }
		end
		local handler = handlers[action]
		if not handler then
			return { ok = false, message = "Action inconnue." }
		end
		if not allowed(player, handler.Limit) then
			return { ok = false, message = "Trop rapide ! Patiente une seconde." }
		end
		if not S.Data.isLoaded(player) then
			return { ok = false, message = "Tes données se chargent encore..." }
		end
		if payload ~= nil and type(payload) ~= "table" then
			return { ok = false, message = "Requête invalide." }
		end
		local ok, result = pcall(handler.Fn, player, payload or {})
		if not ok then
			warn("[NetServer] Erreur dans l'action " .. action .. " : " .. tostring(result))
			return { ok = false, message = "Erreur serveur, réessaie." }
		end
		if type(result) ~= "table" then
			return { ok = true }
		end
		return result
	end

	Net.clientEvent().OnServerEvent:Connect(function(player, name, payload)
		if type(name) ~= "string" then
			return
		end
		local handler = eventHandlers[name]
		if not handler then
			return
		end
		if not allowed(player, name) then
			return
		end
		if not S.Data.isLoaded(player) then
			return
		end
		if payload ~= nil and type(payload) ~= "table" then
			return
		end
		local ok, err = pcall(handler, player, payload or {})
		if not ok then
			warn("[NetServer] Erreur dans l'évènement " .. name .. " : " .. tostring(err))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return NetServer
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">BossService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Raid cooperatif de Minuit : tout le serveur clique sur le Capitaine Chasseur.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Economy = require(ReplicatedStorage.Shared.Economy)

local BossService = {}
local S

local state = { Active = false, Hp = 0, MaxHp = 0, EndsAt = 0, Damage = {}, Model = nil, Dirty = false }
local lastHit = {} -- [player] = os.clock

local function buildBoss(origin)
	local model = Instance.new("Model")
	model.Name = Config.Boss.Name
	local root = Util.part({ Name = "Root", Size = Vector3.new(1, 1, 1), CFrame = origin, Transparency = 1, CanCollide = false, Parent = model })
	model.PrimaryPart = root
	local function add(props)
		props.Parent = model
		props.CanCollide = false
		local part = Util.part(props)
		part.CanTouch = false
		Util.weld(root, part)
		return part
	end
	local body = add({ Name = "Body", Size = Vector3.new(7, 8, 4), CFrame = origin * CFrame.new(0, 6, 0), Color = { 40, 70, 45 }, Material = "Fabric" })
	add({ Name = "Belt", Size = Vector3.new(7.2, 1, 4.2), CFrame = origin * CFrame.new(0, 4.5, 0), Color = { 60, 40, 25 }, Material = "Leather" })
	add({ Name = "Head", Shape = "Ball", Size = Vector3.new(4.2, 4.2, 4.2), CFrame = origin * CFrame.new(0, 12, 0), Color = { 220, 180, 150 } })
	add({ Name = "HatBrim", Shape = "Cylinder", Size = Vector3.new(0.3, 6.5, 6.5), CFrame = origin * CFrame.new(0, 13.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = { 40, 30, 25 } })
	add({ Name = "HatTop", Shape = "Cylinder", Size = Vector3.new(3, 4, 4), CFrame = origin * CFrame.new(0, 15.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = { 40, 30, 25 } })
	for _, side in ipairs({ -1, 1 }) do
		add({ Name = "Eye", Shape = "Ball", Size = Vector3.new(0.9, 0.9, 0.9), CFrame = origin * CFrame.new(side * 0.8, 12.4, -1.9), Color = { 255, 40, 40 }, Material = "Neon" })
		add({ Name = "Arm", Size = Vector3.new(2, 7, 2), CFrame = origin * CFrame.new(side * 4.6, 6, 0) * CFrame.Angles(0, 0, side * math.rad(-15)), Color = { 40, 70, 45 }, Material = "Fabric" })
		add({ Name = "Leg", Size = Vector3.new(2.4, 4, 2.4), CFrame = origin * CFrame.new(side * 1.8, 2, 0), Color = { 50, 40, 35 } })
	end
	add({ Name = "Vacuum", Shape = "Cylinder", Size = Vector3.new(7, 2.2, 2.2), CFrame = origin * CFrame.new(-6, 4, -2) * CFrame.Angles(0, math.rad(30), 0), Color = { 160, 160, 170 }, Material = "Metal" })
	local tank = add({ Name = "Tank", Shape = "Cylinder", Size = Vector3.new(6, 4, 4), CFrame = origin * CFrame.new(0, 7, 3.5) * CFrame.Angles(0, 0, math.rad(90)), Color = { 120, 60, 200 }, Material = "Glass", Transparency = 0.3 })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(180, 80, 255)
	light.Range = 30
	light.Brightness = 2
	light.Parent = tank
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 80, 80), Color3.fromRGB(120, 0, 40))
	emitter.Rate = 25
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(3, 6)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.LightEmission = 1
	emitter.Parent = body

	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = Config.Boss.Range
	click.Parent = model
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root then
			part.CanQuery = true
		end
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(340, 90)
	gui.StudsOffset = Vector3.new(0, 19, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "⚔️ " .. Config.Boss.Name .. "\nCLIQUE POUR ATTAQUER !"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(255, 90, 90)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = root
	CollectionService:AddTag(model, "Boss")
	return model, click
end

local function broadcast()
	S.Net.fireAll("Boss", { Active = state.Active, Hp = math.max(0, state.Hp), MaxHp = state.MaxHp, EndsAt = state.EndsAt, Name = Config.Boss.Name })
end

local function finish(victory)
	if not state.Active then
		return
	end
	state.Active = false
	local participants = {}
	for player, damage in pairs(state.Damage) do
		if player.Parent and damage > 0 then
			table.insert(participants, { Player = player, Damage = damage })
		end
	end
	table.sort(participants, function(a, b)
		return a.Damage > b.Damage
	end)
	if victory then
		S.Net.announce("🏆 Le " .. Config.Boss.Name .. " est vaincu ! Récompenses distribuées aux " .. #participants .. " combattants.", "boss")
		for rank, info in ipairs(participants) do
			local player = info.Player
			local data = S.Data.get(player)
			if data then
				local st = S.Economy.getState(player)
				local coins = math.floor(info.Damage * Config.Boss.CoinsPerDamage * st.Multiplier)
				S.Economy.addCoins(player, coins)
				data.Stats.BossKills += 1
				S.Season.addXp(player, Config.Boss.XpReward)
				local coffins = 0
				if rank <= Config.Boss.NightmareCoffinTopCount then
					coffins = 1
				elseif math.random() < Config.Boss.NightmareCoffinChanceOthers then
					coffins = 1
				end
				if coffins > 0 then
					data.NightmareCoffins += coffins
					player:SetAttribute("NightmareCoffins", data.NightmareCoffins)
				end
				S.Net.notify(player, "⚔️ Raid gagné ! +" .. Economy.format(coins) .. " coins" .. (coffins > 0 and " + 1 Cercueil Cauchemar" or "") .. (rank <= 3 and " (Top " .. rank .. " !)" or ""), "success")
				S.Player.sendState(player)
			end
		end
	else
		S.Net.announce("💨 Le " .. Config.Boss.Name .. " s'est enfui... Il reviendra dans " .. math.floor(Config.Boss.IntervalSeconds / 60) .. " min !", "boss")
	end
	state.Damage = {}
	broadcast()
	local model = state.Model
	state.Model = nil
	if model then
		task.delay(1.5, function()
			model:Destroy()
		end)
	end
end

local function onHit(player)
	if not state.Active then
		return
	end
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.clock()
	if lastHit[player] and now - lastHit[player] < Config.Boss.ClickCooldown then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not state.Model or (root.Position - state.Model.PrimaryPart.Position).Magnitude > Config.Boss.Range + 12 then
		return
	end
	lastHit[player] = now
	local st = S.Economy.getState(player)
	local damage = math.max(Config.Boss.MinClickDamage, math.floor(st.BasePower))
	state.Hp -= damage
	state.Damage[player] = (state.Damage[player] or 0) + damage
	state.Dirty = true
	S.Net.fire(player, "BossHit", { Damage = damage })
	if state.Hp <= 0 then
		finish(true)
	end
end

local function startRaid()
	local totalPower = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if S.Data.get(player) then
			totalPower += S.Economy.getState(player).BasePower
		end
	end
	state.MaxHp = math.floor(Config.Boss.BaseHealth + totalPower * Config.Boss.HealthPerPower)
	state.Hp = state.MaxHp
	state.EndsAt = os.time() + Config.Boss.DurationSeconds
	state.Damage = {}
	state.Active = true
	local model, click = buildBoss(S.Map.Points.BossSpawn)
	model.Parent = workspace.Map
	state.Model = model
	click.MouseClick:Connect(onHit)
	S.Net.announce("⚔️ MINUIT ! Le " .. Config.Boss.Name .. " attaque l'Arène ! Tous ensemble, cliquez dessus !", "boss")
	broadcast()
	local startedAt = os.time()
	while state.Active and os.time() < startedAt + Config.Boss.DurationSeconds do
		task.wait(0.25)
		if state.Dirty then
			state.Dirty = false
			broadcast()
		end
	end
	if state.Active then
		finish(false)
	end
end

function BossService.init(services)
	S = services
	Players.PlayerRemoving:Connect(function(player)
		lastHit[player] = nil
		state.Damage[player] = nil
	end)
	S.Net.register("BossState", "Default", function()
		return { ok = true, data = { Active = state.Active, Hp = math.max(0, state.Hp), MaxHp = state.MaxHp, EndsAt = state.EndsAt, Name = Config.Boss.Name } }
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Boss.IntervalSeconds - Config.Boss.WarningSeconds)
			if #Players:GetPlayers() > 0 then
				S.Net.announce("🌙 Minuit approche : le " .. Config.Boss.Name .. " arrive dans " .. Config.Boss.WarningSeconds .. " s à l'Arène !", "boss")
				S.Net.fireAll("BossWarning", { Seconds = Config.Boss.WarningSeconds })
			end
			task.wait(Config.Boss.WarningSeconds)
			if #Players:GetPlayers() > 0 then
				local ok, err = pcall(startRaid)
				if not ok then
					warn("[BossService] " .. tostring(err))
					state.Active = false
					if state.Model then
						state.Model:Destroy()
						state.Model = nil
					end
				end
			end
		end
	end)
end

return BossService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">CodesService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Codes promotionnels (usage unique par joueur).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local CodesService = {}
local S

function CodesService.redeem(player, code)
	if type(code) ~= "string" then
		return { ok = false, message = "Code invalide." }
	end
	code = string.upper((string.gsub(code, "%s", "")))
	if #code == 0 or #code > 24 then
		return { ok = false, message = "Code invalide." }
	end
	local data = S.Data.get(player)
	local reward = Config.Codes[code]
	if not reward then
		return { ok = false, message = "Ce code n'existe pas." }
	end
	if data.Codes[code] then
		return { ok = false, message = "Code déjà utilisé." }
	end
	local text = S.Reward.grant(player, reward, true)
	data.Codes[code] = true
	S.Player.sendState(player)
	return { ok = true, message = "Code accepté : " .. tostring(text) }
end

function CodesService.init(services)
	S = services
	S.Net.register("RedeemCode", "Shop", function(player, payload)
		return CodesService.redeem(player, payload.Code)
	end)
end

return CodesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CoffinService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ouverture des cercueils (gacha en monnaie du jeu, probabilites affichees et calculees cote serveur).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local CoffinData = require(ReplicatedStorage.Shared.CoffinData)
local MonsterData = require(ReplicatedStorage.Shared.MonsterData)
local GachaMath = require(ReplicatedStorage.Shared.GachaMath)
local Rarity = require(ReplicatedStorage.Shared.Rarity)

local CoffinService = {}
local S

local rng = Random.new()

local function entriesFor(coffin)
	local entries = {}
	for _, item in ipairs(coffin.Contents) do
		local def = MonsterData.get(item.Id)
		table.insert(entries, { Id = item.Id, Weight = item.Weight, Rank = Rarity.rank(def.Rarity) })
	end
	return entries
end

local function nearCrypt(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return (root.Position - S.Map.Points.Crypt.Position).Magnitude <= 45
end

-- Ouvre `count` cercueils deja payes. Retourne la liste des resultats.
local function hatch(player, coffin, count)
	local data = S.Data.get(player)
	local st = S.Economy.getState(player)
	local entries = entriesFor(coffin)
	local results = {}
	local bestRank = 0
	local bestDef = nil
	for _ = 1, count do
		local id = GachaMath.roll(entries, st.Luck, function()
			return rng:NextNumber()
		end)
		local entry, isNew = S.Inventory.addMonster(player, id, true)
		local def = MonsterData.get(id)
		table.insert(results, { Uid = entry.Uid, Id = id, New = isNew, Placed = entry.Room > 0 })
		data.Stats.Hatches += 1
		local rank = Rarity.rank(def.Rarity)
		if rank > bestRank then
			bestRank = rank
			bestDef = def
		end
	end
	S.Season.addXp(player, Config.Season.XpHatch * count)
	if bestDef and Rarity.Info[bestDef.Rarity].Announce then
		S.Net.announce("🎉 " .. player.DisplayName .. " a trouvé un monstre " .. string.upper(Rarity.label(bestDef.Rarity)) .. " : " .. bestDef.Name .. " !", "rare")
	end
	S.Player.sendState(player)
	return results
end

function CoffinService.buy(player, coffinId, count)
	local data = S.Data.get(player)
	local coffin = CoffinData.get(coffinId)
	if not coffin or coffin.EventOnly then
		return { ok = false, message = "Cercueil inconnu." }
	end
	count = tonumber(count) or 1
	if count ~= 1 and count ~= 3 then
		return { ok = false, message = "Quantité invalide." }
	end
	if count == 3 and not S.Shop.ownsPass(player, "TripleHatch") then
		return { ok = false, message = "Le pass Triple Cercueil est nécessaire pour ouvrir 3 cercueils d'un coup." }
	end
	if data.Rebirths < coffin.RebirthRequired then
		return { ok = false, message = "Ce cercueil se débloque au rebirth " .. coffin.RebirthRequired .. "." }
	end
	if not nearCrypt(player) then
		return { ok = false, message = "Va à la Crypte pour ouvrir des cercueils." }
	end
	if #data.Monsters + count > Config.Inventory.MaxMonsters then
		return { ok = false, message = "Inventaire plein (" .. Config.Inventory.MaxMonsters .. ") ! Vends des monstres." }
	end
	local total = coffin.Cost * count
	if not S.Economy.spendCoins(player, total) then
		return { ok = false, message = "Il te manque " .. Economy.format(total - data.Coins) .. " coins." }
	end
	local results = hatch(player, coffin, count)
	return { ok = true, data = { Coffin = coffin.Id, Results = results } }
end

function CoffinService.openNightmare(player, count)
	local data = S.Data.get(player)
	count = tonumber(count) or 1
	if count ~= 1 and count ~= 3 then
		return { ok = false, message = "Quantité invalide." }
	end
	if count == 3 and not S.Shop.ownsPass(player, "TripleHatch") then
		return { ok = false, message = "Le pass Triple Cercueil est nécessaire pour ouvrir 3 cercueils d'un coup." }
	end
	if data.NightmareCoffins < count then
		return { ok = false, message = "Tu n'as pas assez de Cercueils Cauchemar. Gagne-les lors des raids de Minuit, la série quotidienne et le Passe Spooky." }
	end
	if #data.Monsters + count > Config.Inventory.MaxMonsters then
		return { ok = false, message = "Inventaire plein ! Vends des monstres." }
	end
	data.NightmareCoffins -= count
	player:SetAttribute("NightmareCoffins", data.NightmareCoffins)
	local results = hatch(player, CoffinData.get("nightmare"), count)
	return { ok = true, data = { Coffin = "nightmare", Results = results } }
end

function CoffinService.init(services)
	S = services
	S.Net.register("BuyCoffin", "Hatch", function(player, payload)
		return CoffinService.buy(player, payload.CoffinId, payload.Count)
	end)
	S.Net.register("OpenNightmare", "Hatch", function(player, payload)
		return CoffinService.openNightmare(player, payload.Count)
	end)
end

return CoffinService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DailyRewardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Recompense quotidienne avec serie.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DailyRewards = require(ReplicatedStorage.Shared.DailyRewards)
local Economy = require(ReplicatedStorage.Shared.Economy)

local DailyRewardService = {}
local S

function DailyRewardService.claim(player)
	local data = S.Data.get(player)
	local now = os.time()
	local result = DailyRewards.evaluate(data.Daily.LastClaim, data.Daily.Streak, now)
	if not result.CanClaim then
		return { ok = false, message = "Reviens dans " .. Economy.formatTime(result.SecondsUntil) .. " pour ta prochaine récompense." }
	end
	local reward = DailyRewards.rewardForStreak(result.Streak)
	local texts = {}
	local text = S.Reward.grant(player, reward, true)
	if text then
		table.insert(texts, text)
	end
	if reward.Coins then
		local bonus = S.Reward.grant(player, { Type = "Coins", Amount = reward.Coins }, true)
		if bonus then
			table.insert(texts, bonus)
		end
	end
	data.Daily.LastClaim = now
	data.Daily.Streak = result.Streak
	S.Season.addXp(player, Config.Season.XpDaily)
	S.Player.refreshAttributes(player)
	local message = "Jour " .. DailyRewards.dayForStreak(result.Streak) .. " de ta série : " .. table.concat(texts, " + ")
	if result.Reset then
		message = "Série perdue, on repart de zéro ! " .. message
	end
	S.Net.notify(player, "🎁 " .. message, "success")
	return { ok = true, message = message, data = { Streak = result.Streak } }
end

function DailyRewardService.init(services)
	S = services
	S.Net.register("ClaimDaily", "Shop", function(player)
		return DailyRewardService.claim(player)
	end)
end

return DailyRewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sauvegarde des joueurs : DataStore avec verrou de session, reessais, autosave et BindToClose.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = {}

local LOCK_TIMEOUT = 180 -- secondes avant qu'un verrou d'une autre session soit considere mort
local AUTOSAVE_INTERVAL = 60
local LOAD_ATTEMPTS = 4
local MAX_RECEIPTS = 100

local TEMPLATE = {
	Version = Config.DataVersion,
	Coins = 300, -- coins de depart : deux Cercueils en Bois immediatement
	TotalCoins = 0,
	Rebirths = 0,
	RoomsPurchased = 0,
	Monsters = {}, -- { Uid = string, Id = string, Room = number (0 = inventaire) }
	Index = {}, -- [monsterId] = true
	Boosts = { Coins = 0, Luck = 0 }, -- timestamps de fin (os.time)
	Daily = { LastClaim = 0, Streak = 0 },
	Codes = {}, -- [code] = true
	Starter = { FirstJoin = 0, Purchased = false },
	Season = { Id = Config.Season.Id, Xp = 0, ClaimedFree = {}, ClaimedPremium = {} },
	NightmareCoffins = 0,
	VipMonsterGranted = false,
	Stats = { Hatches = 0, Scares = 0, BossKills = 0, PlayTime = 0, BestPower = 0 },
	Receipts = {},
	SessionLock = nil,
}

local profiles = {} -- [player] = { Data, Key, Loaded, Released, LastSave }
local store = nil
local memoryMode = false
local S

local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			data[key] = Util.deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
end

local function migrate(data)
	-- Point d'extension pour les versions futures : on ne fait que remonter la version.
	data.Version = Config.DataVersion
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

-- Tente de charger et verrouiller. Retourne "ok", data | "locked" | "error", err
local function tryLoad(key)
	local loaded = nil
	local lockedByOther = false
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			if type(old) ~= "table" then
				old = Util.deepCopy(TEMPLATE)
			end
			local lock = old.SessionLock
			if lock and lock.JobId ~= game.JobId and (os.time() - (tonumber(lock.Time) or 0)) < LOCK_TIMEOUT then
				lockedByOther = true
				return nil
			end
			old.SessionLock = { JobId = game.JobId, Time = os.time() }
			loaded = old
			return old
		end)
	end)
	if not ok then
		return "error", err
	end
	if lockedByOther then
		return "locked"
	end
	return "ok", loaded
end

local function writeProfile(profile, release)
	if memoryMode then
		return true
	end
	local data = profile.Data
	if release then
		data.SessionLock = nil
	else
		data.SessionLock = { JobId = game.JobId, Time = os.time() }
	end
	local ok, err = Util.retry(3, 1, function()
		store:UpdateAsync(profile.Key, function()
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Échec de sauvegarde pour " .. profile.Key .. " : " .. tostring(err))
	end
	return ok
end

function DataService.init(services)
	S = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		memoryMode = true
		warn("[DataService] DataStore indisponible, mode mémoire : " .. tostring(result))
	end
	if store and RunService:IsStudio() then
		local okTest = pcall(function()
			store:GetAsync("__test_access")
		end)
		if not okTest then
			memoryMode = true
			warn("[DataService] Studio sans accès aux API : les données ne seront PAS sauvegardées. Active 'Enable Studio Access to API Services' dans Game Settings > Security.")
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	pcall(game.BindToClose, game, function()
		if memoryMode then
			return
		end
		local pending = 0
		for player, profile in pairs(profiles) do
			if profile.Loaded and not profile.Released then
				pending += 1
				task.spawn(function()
					profile.Released = true
					writeProfile(profile, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player, profile in pairs(profiles) do
				if profile.Loaded and not profile.Released and player.Parent then
					writeProfile(profile, false)
					profile.LastSave = os.clock()
				end
			end
		end
	end)
end

-- Charge le profil (bloquant). Retourne les donnees ou nil si le joueur a ete expulse.
function DataService.load(player)
	local profile = { Key = keyFor(player), Loaded = false, Released = false, LastSave = os.clock() }
	profiles[player] = profile

	local data = nil
	if memoryMode then
		data = Util.deepCopy(TEMPLATE)
	else
		for attempt = 1, LOAD_ATTEMPTS do
			local status, result = tryLoad(profile.Key)
			if status == "ok" then
				data = result
				break
			elseif status == "locked" then
				if attempt < LOAD_ATTEMPTS then
					task.wait(4)
				end
			else
				warn("[DataService] Erreur de chargement (" .. attempt .. ") : " .. tostring(result))
				if attempt < LOAD_ATTEMPTS then
					task.wait(2 * attempt)
				end
			end
			if not player.Parent then
				profiles[player] = nil
				return nil
			end
		end
	end

	if not data then
		profiles[player] = nil
		player:Kick("Tes données sont encore utilisées par un autre serveur ou indisponibles. Réessaie dans une minute !")
		return nil
	end

	reconcile(data, TEMPLATE)
	migrate(data)
	profile.Data = data
	profile.Loaded = true

	if not player.Parent then
		DataService.release(player)
		return nil
	end
	return data
end

function DataService.get(player)
	local profile = profiles[player]
	if profile and profile.Loaded and not profile.Released then
		return profile.Data
	end
	return nil
end

function DataService.isLoaded(player)
	return DataService.get(player) ~= nil
end

function DataService.isMemoryMode()
	return memoryMode
end

-- Sauvegarde immediate (ex : apres un achat Robux). Retourne true si ecrit.
function DataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.Loaded or profile.Released then
		return false
	end
	local ok = writeProfile(profile, false)
	profile.LastSave = os.clock()
	return ok
end

function DataService.release(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	if profile.Loaded and not profile.Released then
		profile.Released = true
		writeProfile(profile, true)
	end
	profiles[player] = nil
end

-- Enregistre un recu d'achat (idempotence). Retourne false si deja traite.
function DataService.recordReceipt(data, purchaseId)
	for _, id in ipairs(data.Receipts) do
		if id == purchaseId then
			return false
		end
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	return true
end

function DataService.hasReceipt(data, purchaseId)
	for _, id in ipairs(data.Receipts) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function DataService.template()
	return TEMPLATE
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Revenus passifs, collecte, boosts et multiplicateurs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local MonsterData = require(ReplicatedStorage.Shared.MonsterData)
local Util = require(ReplicatedStorage.Shared.Util)

local EconomyService = {}
local S

local states = {} -- [player] = { BasePower, Multiplier, Income, Luck, Uncollected, CoinsBoost, LuckBoost, ServerLuck }
EconomyService.ServerLuckUntil = 0

local function countIndex(index)
	local n = 0
	for _ in pairs(index) do
		n += 1
	end
	return n
end

local function getState(player)
	local st = states[player]
	if not st then
		st = { BasePower = 0, Multiplier = 1, Income = 0, Luck = 1, Uncollected = 0, CoinsBoost = false, LuckBoost = false, ServerLuck = false }
		states[player] = st
	end
	return st
end

local function refreshCoinAttributes(player, data)
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("TotalCoins", data.TotalCoins)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local coins = stats:FindFirstChild("Coins")
		if coins then
			coins.Value = Economy.format(data.Coins)
		end
	end
end

function EconomyService.getState(player)
	return getState(player)
end

function EconomyService.recalculate(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local st = getState(player)
	local base = 0
	for _, entry in ipairs(data.Monsters) do
		if entry.Room > 0 then
			local def = MonsterData.get(entry.Id)
			if def then
				base += def.Power
			end
		end
	end
	local now = os.time()
	st.CoinsBoost = data.Boosts.Coins > now
	st.LuckBoost = data.Boosts.Luck > now
	st.ServerLuck = EconomyService.ServerLuckUntil > now
	local flags = {
		Rebirths = data.Rebirths,
		DoubleCoins = S.Shop.ownsPass(player, "DoubleCoins"),
		VIP = S.Shop.ownsPass(player, "VIP"),
		CoinsBoost = st.CoinsBoost,
		IndexCount = countIndex(data.Index),
		InGroup = S.Player.isInGroup(player),
	}
	st.BasePower = base
	st.Multiplier = Economy.incomeMultiplier(flags)
	st.Income = base * st.Multiplier
	st.Luck = Economy.luckMultiplier({
		LuckyPass = S.Shop.ownsPass(player, "Lucky"),
		LuckBoost = st.LuckBoost,
		ServerLuck = st.ServerLuck,
	})
	if base > (data.Stats.BestPower or 0) then
		data.Stats.BestPower = base
	end
	player:SetAttribute("BasePower", base)
	player:SetAttribute("Multiplier", st.Multiplier)
	player:SetAttribute("Income", st.Income)
	player:SetAttribute("Luck", st.Luck)
	player:SetAttribute("CoinsBoostEnd", data.Boosts.Coins)
	player:SetAttribute("LuckBoostEnd", data.Boosts.Luck)
	player:SetAttribute("AutoCollect", S.Shop.ownsPass(player, "AutoCollect"))
end

function EconomyService.addCoins(player, amount)
	local data = S.Data.get(player)
	if not data or not Util.isFinite(amount) or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	data.Coins += amount
	data.TotalCoins += amount
	refreshCoinAttributes(player, data)
	return true
end

function EconomyService.spendCoins(player, amount)
	local data = S.Data.get(player)
	if not data or not Util.isFinite(amount) or amount < 0 then
		return false
	end
	if data.Coins < amount then
		return false
	end
	data.Coins -= amount
	refreshCoinAttributes(player, data)
	return true
end

function EconomyService.collect(player)
	local st = getState(player)
	local amount = math.floor(st.Uncollected)
	if amount < 1 then
		S.Net.notify(player, "Rien à collecter pour l'instant. Place des monstres !", "info")
		return
	end
	st.Uncollected = 0
	EconomyService.addCoins(player, amount)
	S.Plot.updateBooth(player, 0)
	S.Net.fire(player, "Collected", { Amount = amount })
end

-- kind : "Coins" | "Luck"
function EconomyService.addBoost(player, kind, seconds)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local now = os.time()
	local current = data.Boosts[kind] or 0
	data.Boosts[kind] = math.max(now, current) + seconds
	EconomyService.recalculate(player)
end

function EconomyService.activateServerLuck(seconds, byPlayer)
	local now = os.time()
	EconomyService.ServerLuckUntil = math.max(now, EconomyService.ServerLuckUntil) + seconds
	ReplicatedStorage:SetAttribute("ServerLuckEnd", EconomyService.ServerLuckUntil)
	local who = byPlayer and byPlayer.DisplayName or "Quelqu'un"
	S.Net.announce("🍀 " .. who .. " a activé CHANCE x2 pour tout le serveur pendant " .. math.floor(seconds / 60) .. " min !", "luck")
	for _, player in ipairs(Players:GetPlayers()) do
		EconomyService.recalculate(player)
	end
end

local function tick()
	local now = os.time()
	local serverLuckActive = EconomyService.ServerLuckUntil > now
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.Data.get(player)
		if data then
			local st = getState(player)
			local coinsBoostActive = data.Boosts.Coins > now
			local luckBoostActive = data.Boosts.Luck > now
			if coinsBoostActive ~= st.CoinsBoost or luckBoostActive ~= st.LuckBoost or serverLuckActive ~= st.ServerLuck then
				local coinsEnded = st.CoinsBoost and not coinsBoostActive
				local luckEnded = st.LuckBoost and not luckBoostActive
				EconomyService.recalculate(player)
				if coinsEnded then
					S.Net.notify(player, "Ton boost 2x Coins est terminé.", "info")
				end
				if luckEnded then
					S.Net.notify(player, "Ton boost 2x Chance est terminé.", "info")
				end
			end
			local income = st.Income * Config.Income.TickSeconds
			if income > 0 then
				if S.Shop.ownsPass(player, "AutoCollect") then
					EconomyService.addCoins(player, income)
				else
					local cap = st.Income * Config.Income.MaxUncollectedSeconds
					st.Uncollected = math.min(st.Uncollected + income, cap)
					S.Plot.updateBooth(player, st.Uncollected)
				end
			end
			data.Stats.PlayTime += Config.Income.TickSeconds
		end
	end
end

function EconomyService.init(services)
	S = services
	ReplicatedStorage:SetAttribute("ServerLuckEnd", 0)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Income.TickSeconds)
			local ok, err = pcall(tick)
			if not ok then
				warn("[EconomyService] " .. tostring(err))
			end
		end
	end)
	S.Net.register("Collect", "Default", function(player)
		local plot = S.Plot.get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not plot or not root or (root.Position - plot.Booth.Position).Magnitude > 20 then
			return { ok = false, message = "Approche-toi de ta caisse pour collecter." }
		end
		EconomyService.collect(player)
		return { ok = true }
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Inventaire des monstres : ajout, placement, vente, auto-equipement, rebirth.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local MonsterData = require(ReplicatedStorage.Shared.MonsterData)
local CoffinData = require(ReplicatedStorage.Shared.CoffinData)
local Rarity = require(ReplicatedStorage.Shared.Rarity)
local Util = require(ReplicatedStorage.Shared.Util)

local InventoryService = {}
local S

local function findEntry(data, uid)
	for index, entry in ipairs(data.Monsters) do
		if entry.Uid == uid then
			return entry, index
		end
	end
	return nil
end

local function occupiedRooms(data)
	local occupied = {}
	for _, entry in ipairs(data.Monsters) do
		if entry.Room > 0 then
			occupied[entry.Room] = entry
		end
	end
	return occupied
end

local function firstFreeRoom(player, data)
	local count = S.Plot.roomCount(player)
	local occupied = occupiedRooms(data)
	for room = 1, count do
		if not occupied[room] then
			return room
		end
	end
	return nil
end

function InventoryService.count(data)
	return #data.Monsters
end

-- Ajoute un monstre a l'inventaire. Retourne entry, isNewDiscovery (nil si inventaire plein)
function InventoryService.addMonster(player, monsterId, force)
	local data = S.Data.get(player)
	local def = MonsterData.get(monsterId)
	if not data or not def then
		return nil, false
	end
	if not force and #data.Monsters >= Config.Inventory.MaxMonsters then
		return nil, false
	end
	local entry = { Uid = Util.uid(), Id = monsterId, Room = 0 }
	table.insert(data.Monsters, entry)
	local isNew = false
	if not data.Index[monsterId] then
		data.Index[monsterId] = true
		isNew = true
	end
	-- Placement automatique s'il reste une salle libre (gratification immediate)
	local room = firstFreeRoom(player, data)
	if room then
		entry.Room = room
		S.Plot.renderMonster(player, entry)
	end
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	return entry, isNew
end

function InventoryService.removeMonster(player, uid)
	local data = S.Data.get(player)
	if not data then
		return false
	end
	local entry, index = findEntry(data, uid)
	if not entry then
		return false
	end
	if entry.Room > 0 then
		S.Plot.removeModel(player, uid)
	end
	table.remove(data.Monsters, index)
	return true
end

function InventoryService.renderAll(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	S.Plot.clearModels(player)
	local count = S.Plot.roomCount(player)
	for _, entry in ipairs(data.Monsters) do
		if entry.Room > count then
			entry.Room = 0
		end
		if entry.Room > 0 then
			S.Plot.renderMonster(player, entry)
		end
	end
	S.Plot.refreshPads(player)
end

function InventoryService.sellValue(entry)
	local def = MonsterData.get(entry.Id)
	if not def then
		return 0
	end
	return Economy.sellPrice(def.Rarity, CoffinData.referenceCost(entry.Id))
end

function InventoryService.equip(player, uid)
	local data = S.Data.get(player)
	local entry = findEntry(data, uid)
	if not entry then
		return { ok = false, message = "Monstre introuvable." }
	end
	if entry.Room > 0 then
		return { ok = false, message = "Ce monstre est déjà placé." }
	end
	local room = firstFreeRoom(player, data)
	if not room then
		return { ok = false, message = "Toutes tes salles sont pleines ! Retire un monstre ou achète une salle." }
	end
	entry.Room = room
	S.Plot.renderMonster(player, entry)
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	S.Player.sendState(player)
	return { ok = true }
end

function InventoryService.unequip(player, uid)
	local data = S.Data.get(player)
	local entry = findEntry(data, uid)
	if not entry then
		return { ok = false, message = "Monstre introuvable." }
	end
	if entry.Room == 0 then
		return { ok = false, message = "Ce monstre n'est pas placé." }
	end
	S.Plot.removeModel(player, uid)
	entry.Room = 0
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	S.Player.sendState(player)
	return { ok = true }
end

function InventoryService.sell(player, uid)
	local data = S.Data.get(player)
	local entry = findEntry(data, uid)
	if not entry then
		return { ok = false, message = "Monstre introuvable." }
	end
	local def = MonsterData.get(entry.Id)
	if def.Exclusive then
		return { ok = false, message = "Les monstres exclusifs ne peuvent pas être vendus." }
	end
	local value = InventoryService.sellValue(entry)
	InventoryService.removeMonster(player, uid)
	S.Economy.addCoins(player, value)
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	S.Player.sendState(player)
	return { ok = true, message = def.Name .. " vendu pour " .. Economy.format(value) .. " coins.", data = { Value = value } }
end

-- Vend tous les monstres non places de rarete Rare ou moins (jamais les exclusifs)
function InventoryService.sellUnplaced(player)
	local data = S.Data.get(player)
	local total = 0
	local sold = 0
	for index = #data.Monsters, 1, -1 do
		local entry = data.Monsters[index]
		local def = MonsterData.get(entry.Id)
		if entry.Room == 0 and def and not def.Exclusive and Rarity.rank(def.Rarity) <= Rarity.rank("Rare") then
			total += InventoryService.sellValue(entry)
			table.remove(data.Monsters, index)
			sold += 1
		end
	end
	if sold == 0 then
		return { ok = false, message = "Aucun monstre commun, peu commun ou rare à vendre." }
	end
	S.Economy.addCoins(player, total)
	S.Economy.recalculate(player)
	S.Player.sendState(player)
	return { ok = true, message = sold .. " monstres vendus pour " .. Economy.format(total) .. " coins.", data = { Value = total, Count = sold } }
end

-- Place automatiquement les meilleurs monstres
function InventoryService.autoEquip(player)
	local data = S.Data.get(player)
	local count = S.Plot.roomCount(player)
	local sorted = table.clone(data.Monsters)
	table.sort(sorted, function(a, b)
		local pa = MonsterData.get(a.Id).Power
		local pb = MonsterData.get(b.Id).Power
		if pa == pb then
			return a.Uid < b.Uid
		end
		return pa > pb
	end)
	for index, entry in ipairs(sorted) do
		entry.Room = index <= count and index or 0
	end
	InventoryService.renderAll(player)
	S.Economy.recalculate(player)
	S.Player.sendState(player)
	return { ok = true, message = "Tes meilleurs monstres sont en place !" }
end

-- Retire les monstres non conserves lors d'un rebirth
function InventoryService.wipeForRebirth(player)
	local data = S.Data.get(player)
	for index = #data.Monsters, 1, -1 do
		local entry = data.Monsters[index]
		local def = MonsterData.get(entry.Id)
		if not (def and def.KeepOnRebirth) then
			table.remove(data.Monsters, index)
		end
	end
	local room = 0
	for _, entry in ipairs(data.Monsters) do
		room += 1
		entry.Room = room
	end
	InventoryService.renderAll(player)
end

function InventoryService.init(services)
	S = services
	S.Net.register("Equip", "Default", function(player, payload)
		if type(payload.Uid) ~= "string" then
			return { ok = false, message = "Requête invalide." }
		end
		return InventoryService.equip(player, payload.Uid)
	end)
	S.Net.register("Unequip", "Default", function(player, payload)
		if type(payload.Uid) ~= "string" then
			return { ok = false, message = "Requête invalide." }
		end
		return InventoryService.unequip(player, payload.Uid)
	end)
	S.Net.register("Sell", "Default", function(player, payload)
		if type(payload.Uid) ~= "string" then
			return { ok = false, message = "Requête invalide." }
		end
		return InventoryService.sell(player, payload.Uid)
	end)
	S.Net.register("SellUnplaced", "Shop", function(player)
		return InventoryService.sellUnplaced(player)
	end)
	S.Net.register("AutoEquip", "Shop", function(player)
		return InventoryService.autoEquip(player)
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Classements globaux (OrderedDataStore) affiches sur les tableaux du hub.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)

local LeaderboardService = {}
local S

local BOARDS = {
	{ Key = "Coins", Store = "HAH_TopCoins_v1", Value = function(data) return data.TotalCoins end },
	{ Key = "Rebirths", Store = "HAH_TopRebirths_v1", Value = function(data) return data.Rebirths end },
	{ Key = "Power", Store = "HAH_TopPower_v1", Value = function(data) return data.Stats.BestPower end },
}

local stores = {}
local nameCache = {}
local MAX_VALUE = 2 ^ 53

local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		nameCache[userId] = online.DisplayName
		return online.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Joueur " .. userId)
	return nameCache[userId]
end

local function setBoardText(key, text)
	local label = S.Map.Leaderboards[key]
	if label then
		label.Text = text
	end
end

local function refresh()
	if S.Data.isMemoryMode() then
		for _, board in ipairs(BOARDS) do
			setBoardText(board.Key, "Classement indisponible en Studio.\nActive l'accès API dans Game Settings > Security.")
		end
		return
	end
	for _, board in ipairs(BOARDS) do
		local store = stores[board.Key]
		if store then
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.Data.get(player)
				if data then
					local value = math.clamp(math.floor(board.Value(data) or 0), 0, MAX_VALUE)
					if value > 0 then
						pcall(function()
							store:SetAsync(tostring(player.UserId), value)
						end)
					end
				end
			end
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, Config.Leaderboards.Entries)
			end)
			if ok and pages then
				local okPage, page = pcall(function()
					return pages:GetCurrentPage()
				end)
				if okPage and page then
					local lines = {}
					for rank, entry in ipairs(page) do
						local userId = tonumber(entry.key)
						local medal = rank == 1 and "🥇" or rank == 2 and "🥈" or rank == 3 and "🥉" or (rank .. ".")
						table.insert(lines, string.format("%s %s  <font color=\"#ffd166\">%s</font>", medal, nameOf(userId), Economy.format(entry.value)))
					end
					if #lines == 0 then
						table.insert(lines, "Sois le premier au classement !")
					end
					setBoardText(board.Key, table.concat(lines, "\n"))
				end
			end
		end
	end
end

function LeaderboardService.init(services)
	S = services
	for _, board in ipairs(BOARDS) do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.Store)
		end)
		if ok then
			stores[board.Key] = store
		end
	end
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[LeaderboardService] " .. tostring(err))
			end
			task.wait(Config.Leaderboards.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Construit la carte du hub par script : place centrale, crypte, boutique, autel, coffre, tableaux, arene.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Util = require(ReplicatedStorage.Shared.Util)
local CoffinData = require(ReplicatedStorage.Shared.CoffinData)
local Economy = require(ReplicatedStorage.Shared.Economy)

local MapBuilder = {}

MapBuilder.Points = {}
MapBuilder.CoffinDisplays = {}
MapBuilder.Leaderboards = {}

local S
local mapFolder
local rng = Random.new(1337)

local COLORS = {
	Ground = { 34, 52, 38 },
	Plaza = { 70, 66, 80 },
	Path = { 92, 86, 100 },
	Stone = { 96, 96, 108 },
	DarkStone = { 58, 58, 70 },
	Wood = { 88, 58, 36 },
	Orange = { 255, 140, 30 },
	Purple = { 150, 80, 255 },
	Gold = { 255, 200, 60 },
}

local function billboard(parent, text, size, color, offsetY, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(260, 60)
	gui.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 120
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(10, 5, 20)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = parent
	return gui
end

local function prompt(parent, actionText, objectText, distance, callback)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = actionText
	p.ObjectText = objectText
	p.MaxActivationDistance = distance or 10
	p.HoldDuration = 0
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Default
	p.Parent = parent
	p.Triggered:Connect(function(player)
		callback(player)
	end)
	return p
end

local function lamp(parent, position)
	local post = Util.part({ Name = "LampPost", Shape = "Cylinder", Size = Vector3.new(9, 0.6, 0.6), CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = COLORS.DarkStone, Material = "Metal", Parent = parent })
	local bulb = Util.part({ Name = "LampBulb", Shape = "Ball", Size = Vector3.new(1.6, 1.6, 1.6), CFrame = CFrame.new(position + Vector3.new(0, 9.6, 0)), Color = COLORS.Orange, Material = "Neon", CanCollide = false, Parent = parent })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 80)
	light.Range = 28
	light.Brightness = 1.6
	light.Parent = bulb
	return post
end

local function deadTree(parent, position, scale)
	scale = scale or 1
	local trunkHeight = 10 * scale
	Util.part({ Name = "Trunk", Shape = "Cylinder", Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale), CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 50, 38, 30 }, Material = "Wood", Parent = parent })
	for i = 1, 4 do
		local angle = i * math.pi / 2 + rng:NextNumber(-0.4, 0.4)
		local length = (4 + rng:NextNumber(0, 3)) * scale
		local branch = Util.part({ Name = "Branch", Size = Vector3.new(0.6 * scale, length, 0.6 * scale), Color = { 50, 38, 30 }, Material = "Wood", CanCollide = false, Parent = parent })
		local base = position + Vector3.new(0, trunkHeight * (0.55 + i * 0.1), 0)
		branch.CFrame = CFrame.new(base) * CFrame.Angles(0, angle, math.rad(50)) * CFrame.new(0, length / 2, 0)
	end
end

local function tombstone(parent, cframe)
	Util.part({ Name = "Tomb", Size = Vector3.new(2.2, 2.6, 0.6), CFrame = cframe * CFrame.new(0, 1.3, 0), Color = COLORS.Stone, Material = "Slate", Parent = parent })
	Util.part({ Name = "TombTop", Shape = "Cylinder", Size = Vector3.new(0.6, 2.2, 2.2), CFrame = cframe * CFrame.new(0, 2.6, 0) * CFrame.Angles(0, math.rad(90), 0), Color = COLORS.Stone, Material = "Slate", Parent = parent })
end

local function fenceLine(parent, from, to, height)
	height = height or 3
	local delta = to - from
	local length = delta.Magnitude
	local dir = delta.Unit
	local count = math.max(1, math.floor(length / 6))
	for i = 0, count do
		local pos = from + dir * (length * i / count)
		Util.part({ Name = "FencePost", Size = Vector3.new(0.7, height, 0.7), CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)), Color = COLORS.DarkStone, Material = "Metal", Parent = parent })
	end
	local mid = (from + to) / 2
	for _, y in ipairs({ height * 0.45, height * 0.85 }) do
		Util.part({ Name = "FenceRail", Size = Vector3.new(length, 0.3, 0.3), CFrame = CFrame.lookAt(mid + Vector3.new(0, y, 0), mid + Vector3.new(0, y, 0) + dir) * CFrame.Angles(0, math.rad(90), 0), Color = COLORS.DarkStone, Material = "Metal", CanCollide = false, Parent = parent })
	end
end

local function sign(parent, cframe, text, width, color)
	local board = Util.part({ Name = "Sign", Size = Vector3.new(width or 12, 3, 0.5), CFrame = cframe, Color = COLORS.Wood, Material = "Wood", CanCollide = false, Parent = parent })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.fromRGB(255, 220, 160)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = board
	return board
end

local function leaderboard(parent, cframe, title)
	local board = Util.part({ Name = "Leaderboard_" .. title, Size = Vector3.new(20, 14, 1), CFrame = cframe, Color = COLORS.DarkStone, Material = "Slate", Parent = parent })
	Util.part({ Name = "Frame", Size = Vector3.new(21, 15, 0.6), CFrame = cframe * CFrame.new(0, 0, 0.1), Color = COLORS.Wood, Material = "Wood", Parent = parent })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	local header = Instance.new("TextLabel")
	header.Name = "Title"
	header.Size = UDim2.fromScale(1, 0.14)
	header.BackgroundColor3 = Color3.fromRGB(120, 60, 200)
	header.BorderSizePixel = 0
	header.Text = title
	header.Font = Enum.Font.FredokaOne
	header.TextScaled = true
	header.TextColor3 = Color3.fromRGB(255, 255, 255)
	header.Parent = gui
	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.Size = UDim2.fromScale(0.94, 0.84)
	body.Position = UDim2.fromScale(0.03, 0.15)
	body.BackgroundTransparency = 1
	body.Text = "Chargement..."
	body.Font = Enum.Font.GothamBold
	body.TextSize = 34
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.TextColor3 = Color3.fromRGB(240, 235, 255)
	body.RichText = true
	body.Parent = gui
	gui.Parent = board
	return board, body
end

local function buildAtmosphere()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.38
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(120, 95, 170)
	atmosphere.Decay = Color3.fromRGB(60, 30, 110)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 2.2
	atmosphere.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local color = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.1
	color.Contrast = 0.08
	color.TintColor = Color3.fromRGB(235, 225, 255)
	color.Parent = Lighting
end

local function buildGround(parent)
	Util.part({ Name = "Ground", Size = Vector3.new(1600, 4, 1600), CFrame = CFrame.new(0, -2, 0), Color = COLORS.Ground, Material = "Grass", Parent = parent })
	Util.part({ Name = "Plaza", Shape = "Cylinder", Size = Vector3.new(0.6, 150, 150), CFrame = CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = COLORS.Plaza, Material = "Cobblestone", Parent = parent })
	Util.part({ Name = "PlazaRing", Shape = "Cylinder", Size = Vector3.new(0.4, 156, 156), CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = COLORS.DarkStone, Material = "Slate", Parent = parent })
	for i = 0, 7 do
		local angle = i * math.pi / 4 + math.pi / 8
		lamp(parent, Vector3.new(math.cos(angle) * 66, 0.6, math.sin(angle) * 66))
	end
	for _ = 1, 60 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(320, 700)
		deadTree(parent, Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), rng:NextNumber(0.8, 1.6))
	end
end

local function buildSpawn(parent)
	local spawnPart = Instance.new("SpawnLocation")
	spawnPart.Name = "MainSpawn"
	spawnPart.Size = Vector3.new(12, 1, 12)
	spawnPart.CFrame = CFrame.new(0, 0.9, 28)
	spawnPart.Anchored = true
	spawnPart.Color = Color3.fromRGB(110, 70, 170)
	spawnPart.Material = Enum.Material.Neon
	spawnPart.Transparency = 0.3
	spawnPart.Neutral = true
	spawnPart.Duration = 0
	spawnPart.TopSurface = Enum.SurfaceType.Smooth
	spawnPart.Parent = parent
	MapBuilder.Points.Spawn = spawnPart.CFrame * CFrame.new(0, 3, 0)
	sign(parent, CFrame.new(0, 6, 38) * CFrame.Angles(0, math.rad(180), 0), "👻 Bienvenue dans Haunt a House !", 26, Color3.fromRGB(255, 240, 200))
	sign(parent, CFrame.new(0, 3.2, 38) * CFrame.Angles(0, math.rad(180), 0), "Ouvre des cercueils, place tes monstres, fais peur aux visiteurs !", 26, Color3.fromRGB(220, 200, 255))
end

local function buildCrypt(parent)
	local center = Vector3.new(0, 0, -55)
	local folder = Instance.new("Folder")
	folder.Name = "Crypt"
	folder.Parent = parent
	Util.part({ Name = "Floor", Size = Vector3.new(36, 1, 26), CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)), Color = COLORS.DarkStone, Material = "Slate", Parent = folder })
	local wallHeight = 14
	local function wall(size, offset)
		Util.part({ Name = "Wall", Size = size, CFrame = CFrame.new(center + offset + Vector3.new(0, wallHeight / 2, 0)), Color = COLORS.Stone, Material = "Slate", Parent = folder })
	end
	wall(Vector3.new(36, wallHeight, 1.5), Vector3.new(0, 0, -12.25))
	wall(Vector3.new(1.5, wallHeight, 26), Vector3.new(-17.25, 0, 0))
	wall(Vector3.new(1.5, wallHeight, 26), Vector3.new(17.25, 0, 0))
	wall(Vector3.new(13, wallHeight, 1.5), Vector3.new(-11.5, 0, 12.25))
	wall(Vector3.new(13, wallHeight, 1.5), Vector3.new(11.5, 0, 12.25))
	Util.part({ Name = "DoorTop", Size = Vector3.new(10, 4, 1.5), CFrame = CFrame.new(center + Vector3.new(0, wallHeight - 2, 12.25)), Color = COLORS.Stone, Material = "Slate", Parent = folder })
	Util.part({ Name = "Roof", ClassName = "WedgePart", Size = Vector3.new(38, 8, 14), CFrame = CFrame.new(center + Vector3.new(0, wallHeight + 4, -7)) * CFrame.Angles(0, math.rad(180), 0), Color = COLORS.DarkStone, Material = "Slate", Parent = folder })
	Util.part({ Name = "Roof", ClassName = "WedgePart", Size = Vector3.new(38, 8, 14), CFrame = CFrame.new(center + Vector3.new(0, wallHeight + 4, 7)), Color = COLORS.DarkStone, Material = "Slate", Parent = folder })
	local glow = Util.part({ Name = "DoorGlow", Size = Vector3.new(9, 9.5, 0.3), CFrame = CFrame.new(center + Vector3.new(0, 4.9, 12.2)), Color = COLORS.Purple, Material = "Neon", Transparency = 0.35, CanCollide = false, Parent = folder })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 100, 255)
	light.Range = 30
	light.Brightness = 2
	light.Parent = glow
	sign(folder, CFrame.new(center + Vector3.new(0, wallHeight + 1.5, 13.2)), "⚰️ LA CRYPTE : cercueils", 24, Color3.fromRGB(230, 200, 255))

	local counter = Util.part({ Name = "CryptCounter", Size = Vector3.new(8, 3, 2), CFrame = CFrame.new(center + Vector3.new(0, 1.5, 16)), Color = COLORS.Wood, Material = "Wood", Parent = folder })
	billboard(counter, "Ouvrir des cercueils", UDim2.fromOffset(240, 50), Color3.fromRGB(230, 200, 255), 3.5, 60)
	prompt(counter, "Ouvrir", "La Crypte", 12, function(player)
		S.Net.fire(player, "OpenUI", { Ui = "Coffins" })
	end)
	MapBuilder.Points.Crypt = counter.CFrame

	local displayCount = 0
	for _, coffin in ipairs(CoffinData.List) do
		if not coffin.EventOnly then
			displayCount += 1
		end
	end
	local index = 0
	for _, coffin in ipairs(CoffinData.List) do
		if not coffin.EventOnly then
			local x = (index - (displayCount - 1) / 2) * 9
			index += 1
			local base = center + Vector3.new(x, 0, 24)
			local box = Util.part({ Name = "Coffin_" .. coffin.Id, Size = Vector3.new(4, 7, 2), CFrame = CFrame.new(base + Vector3.new(0, 3.4, 0)) * CFrame.Angles(math.rad(-15), 0, 0), Color = coffin.Color, Material = "Wood", Parent = folder })
			box:SetAttribute("CoffinId", coffin.Id)
			Util.part({ Name = "Lid", Size = Vector3.new(3.2, 6, 0.4), CFrame = box.CFrame * CFrame.new(0, 0, -1.2), Color = coffin.Accent, Material = "Metal", CanCollide = false, Parent = folder })
			local lockText = coffin.RebirthRequired > 0 and ("🔒 Rebirth " .. coffin.RebirthRequired) or ""
			billboard(box, coffin.Name .. "\n" .. Economy.format(coffin.Cost) .. " coins " .. lockText, UDim2.fromOffset(220, 70), Util.color(coffin.Accent), 5.2, 70)
			prompt(box, "Voir", coffin.Name, 10, function(player)
				S.Net.fire(player, "OpenUI", { Ui = "Coffins", Coffin = coffin.Id })
			end)
			MapBuilder.CoffinDisplays[coffin.Id] = box
		end
	end
end

