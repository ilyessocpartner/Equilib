local function buildBossArena(parent)
	local center = Vector3.new(0, 0, -150)
	local folder = Instance.new("Folder")
	folder.Name = "BossArena"
	folder.Parent = parent
	Util.part({ Name = "Floor", Size = Vector3.new(64, 1, 64), CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)), Color = { 40, 44, 40 }, Material = "Ground", Parent = folder })
	local half = 32
	local corners = {
		center + Vector3.new(-half, 0.5, -half),
		center + Vector3.new(half, 0.5, -half),
		center + Vector3.new(half, 0.5, half),
		center + Vector3.new(-half, 0.5, half),
	}
	fenceLine(folder, corners[1], corners[2], 4)
	fenceLine(folder, corners[2], corners[3], 4)
	fenceLine(folder, corners[4], corners[1], 4)
	fenceLine(folder, corners[3], corners[3] + Vector3.new(-22, 0, 0), 4)
	fenceLine(folder, corners[4], corners[4] + Vector3.new(22, 0, 0), 4)
	for _, c in ipairs(corners) do
		deadTree(folder, c + Vector3.new(0, 0, 0), 1.4)
	end
	for _ = 1, 18 do
		local x = rng:NextNumber(-26, 26)
		local z = rng:NextNumber(-26, 26)
		if math.abs(x) > 9 or math.abs(z) > 9 then
			tombstone(folder, CFrame.new(center + Vector3.new(x, 0.8, z)) * CFrame.Angles(0, rng:NextNumber(-0.5, 0.5), 0))
		end
	end
	local platform = Util.part({ Name = "BossSpawn", Shape = "Cylinder", Size = Vector3.new(1, 18, 18), CFrame = CFrame.new(center + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = { 80, 30, 110 }, Material = "Slate", Parent = folder })
	local ring = Util.part({ Name = "Ring", Shape = "Cylinder", Size = Vector3.new(0.4, 20, 20), CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = COLORS.Purple, Material = "Neon", Transparency = 0.4, CanCollide = false, Parent = folder })
	ring.Name = "BossRing"
	sign(folder, CFrame.new(center + Vector3.new(0, 7, 34)), "⚔️ ARÈNE DE MINUIT : le Capitaine Chasseur attaque toutes les 10 min !", 40, Color3.fromRGB(255, 120, 120))
	lamp(folder, center + Vector3.new(-30, 0.6, 30))
	lamp(folder, center + Vector3.new(30, 0.6, 30))
	MapBuilder.Points.BossSpawn = CFrame.new(center + Vector3.new(0, 1.8, 0))
end

local function buildPaths(parent, plotCount, ringRadius)
	for i = 1, plotCount do
		local angle = math.rad(15 + 30 * (i - 1))
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local from = dir * 74
		local to = dir * (ringRadius - 62)
		local mid = (from + to) / 2
		local length = (to - from).Magnitude
		Util.part({ Name = "Path", Size = Vector3.new(8, 0.4, length), CFrame = CFrame.lookAt(mid + Vector3.new(0, 0.2, 0), to + Vector3.new(0, 0.2, 0)), Color = COLORS.Path, Material = "Cobblestone", Parent = parent })
	end
end

function MapBuilder.build(services)
	S = services
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	hub.Parent = mapFolder

	buildAtmosphere()
	buildGround(hub)
	buildSpawn(hub)
	buildCrypt(hub)
	buildShop(hub)
	buildRebirthAltar(hub)
	buildDailyChest(hub)
	buildIndexBoard(hub)
	buildLeaderboards(hub)
	buildBossArena(hub)
	buildPaths(hub, S.Config.Plot.Count, S.Config.Plot.RingRadius)

	mapFolder.Parent = workspace
	return mapFolder
end

function MapBuilder.folder()
	return mapFolder
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Cycle de vie du joueur : chargement, leaderstats, attributs, synchronisation d'etat.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Offers = require(ReplicatedStorage.Shared.Offers)
local MonetizationIds = require(ReplicatedStorage.Shared.MonetizationIds)

local PlayerService = {}
local S

local groupCache = {} -- [player] = bool

local function setupLeaderstats(player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Value = Economy.format(data.Coins)
	coins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths
	rebirths.Parent = stats
	stats.Parent = player
end

function PlayerService.isInGroup(player)
	return groupCache[player] == true
end

local function checkGroup(player)
	if MonetizationIds.GroupId == 0 then
		groupCache[player] = false
		return
	end
	local ok, result = pcall(function()
		return player:IsInGroup(MonetizationIds.GroupId)
	end)
	groupCache[player] = ok and result == true
end

local function addVipTag(character)
	local head = character:FindFirstChild("Head")
	if not head or head:FindFirstChild("VipTag") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.fromOffset(120, 34)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "👑 VIP"
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 215, 60)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = head
end

-- Attributs repliques (le client lit ces valeurs pour le HUD)
function PlayerService.refreshAttributes(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("TotalCoins", data.TotalCoins)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("RebirthCost", Economy.rebirthCost(data.Rebirths))
	player:SetAttribute("NightmareCoffins", data.NightmareCoffins)
	player:SetAttribute("CoinsBoostEnd", data.Boosts.Coins)
	player:SetAttribute("LuckBoostEnd", data.Boosts.Luck)
	player:SetAttribute("DailyLastClaim", data.Daily.LastClaim)
	player:SetAttribute("DailyStreak", data.Daily.Streak)
	player:SetAttribute("SeasonXp", data.Season.Xp)
	player:SetAttribute("StarterRemaining", Offers.starterRemaining(data.Starter.FirstJoin, data.Starter.Purchased, os.time()))
	player:SetAttribute("StarterFirstJoin", data.Starter.FirstJoin)
	player:SetAttribute("StarterPurchased", data.Starter.Purchased)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = Economy.format(data.Coins)
		stats.Rebirths.Value = data.Rebirths
	end
end

-- Etat complet envoye au client (inventaire, index, passes, catalogue, etc.)
function PlayerService.sendState(player)
	local data = S.Data.get(player)
	if not data then
		return
	end
	local state = {
		Monsters = data.Monsters,
		Index = data.Index,
		Rooms = S.Plot.roomInfo(player),
		Passes = S.Shop.ownedPasses(player),
		Catalog = S.Shop.catalog(),
		Season = { Id = data.Season.Id, Xp = data.Season.Xp, ClaimedFree = data.Season.ClaimedFree, ClaimedPremium = data.Season.ClaimedPremium },
		Playtime = S.Playtime.claimedList(player),
		Codes = data.Codes,
		Stats = data.Stats,
		Restricted = S.Shop.isRandomRestricted(player),
		MemoryMode = S.Data.isMemoryMode(),
		InGroup = PlayerService.isInGroup(player),
	}
	S.Net.fire(player, "State", state)
	PlayerService.refreshAttributes(player)
end

function PlayerService.applyVipTag(player)
	local character = player.Character
	if character and S.Shop.ownsPass(player, "VIP") then
		addVipTag(character)
	end
end

local function onCharacterAdded(player, character)
	task.defer(function()
		if S.Shop.ownsPass(player, "VIP") then
			addVipTag(character)
		end
	end)
end

local function onPlayerAdded(player)
	player:SetAttribute("DataLoaded", false)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local data = S.Data.load(player)
	if not data or not player.Parent then
		return
	end
	if data.Starter.FirstJoin == 0 then
		data.Starter.FirstJoin = os.time()
	end
	if data.Season.Id ~= Config.Season.Id then
		data.Season = { Id = Config.Season.Id, Xp = 0, ClaimedFree = {}, ClaimedPremium = {} }
	end

	setupLeaderstats(player, data)
	checkGroup(player)
	S.Shop.setupPlayer(player)
	S.Plot.assign(player)
	S.Economy.recalculate(player)
	S.Playtime.start(player)
	player:SetAttribute("SessionStart", os.time())
	player:SetAttribute("DataLoaded", true)
	PlayerService.sendState(player)

	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	S.Net.notify(player, "Bienvenue " .. player.DisplayName .. " ! Va à la Crypte (bâtiment violet au nord) pour ouvrir ton premier cercueil, puis clique sur les visiteurs de ton manoir pour crier BOO !", "success")
end

function PlayerService.init(services)
	S = services
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		groupCache[player] = nil
	end)

	S.Net.register("TeleportHome", "Default", function(player)
		local cf = S.Plot.homeCFrame(player)
		local character = player.Character
		if cf and character and character:FindFirstChild("HumanoidRootPart") then
			character:PivotTo(cf)
			return { ok = true }
		end
		return { ok = false, message = "Impossible de te téléporter pour l'instant." }
	end)

	S.Net.register("TeleportHub", "Default", function(player)
		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			character:PivotTo(S.Map.Points.Spawn)
			return { ok = true }
		end
		return { ok = false }
	end)

	S.Net.register("GetState", "Default", function(player)
		PlayerService.sendState(player)
		return { ok = true }
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">PlaytimeService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Recompenses de temps de jeu (par session).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)

local PlaytimeService = {}
local S

local sessions = {} -- [player] = { Start = os.clock(), Claimed = { [index] = true } }

function PlaytimeService.start(player)
	sessions[player] = { Start = os.clock(), Claimed = {} }
end

function PlaytimeService.claimedList(player)
	local session = sessions[player]
	local list = {}
	for index = 1, #Config.Playtime do
		list[index] = session ~= nil and session.Claimed[index] == true
	end
	return list
end

function PlaytimeService.claim(player, index)
	local session = sessions[player]
	index = tonumber(index)
	local entry = index and Config.Playtime[index]
	if not session or not entry then
		return { ok = false, message = "Récompense inconnue." }
	end
	if session.Claimed[index] then
		return { ok = false, message = "Déjà récupérée cette session." }
	end
	local elapsed = os.clock() - session.Start
	if elapsed < entry.Minutes * 60 then
		return { ok = false, message = "Encore " .. math.ceil((entry.Minutes * 60 - elapsed) / 60) .. " min de jeu pour cette récompense." }
	end
	session.Claimed[index] = true
	local reward = { Type = entry.Type, Amount = entry.Amount, Minutes = entry.Minutes2 }
	local text = S.Reward.grant(player, reward, true)
	S.Player.sendState(player)
	S.Net.notify(player, "⏱️ Récompense de temps de jeu : " .. tostring(text), "success")
	return { ok = true, message = text }
end

function PlaytimeService.init(services)
	S = services
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
	S.Net.register("ClaimPlaytime", "Shop", function(player, payload)
		return PlaytimeService.claim(player, payload.Index)
	end)
end

return PlaytimeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Manoirs des joueurs : construction, attribution, salles, affichage des monstres.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Util = require(ReplicatedStorage.Shared.Util)
local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local MonsterData = require(ReplicatedStorage.Shared.MonsterData)
local MonsterBuilder = require(ReplicatedStorage.Shared.MonsterBuilder)
local Rarity = require(ReplicatedStorage.Shared.Rarity)

local PlotService = {}
local S

local plots = {} -- [index] = plot
local playerPlot = {} -- [player] = plot

local COLORS = {
	Base = { 48, 44, 60 },
	Floor = { 70, 60, 80 },
	Carpet = { 120, 30, 50 },
	Wall = { 92, 78, 110 },
	WallTrim = { 60, 45, 80 },
	PadOpen = { 90, 60, 140 },
	PadLocked = { 40, 35, 50 },
	Wood = { 88, 58, 36 },
	Gold = { 255, 200, 60 },
}

local function billboard(parent, text, size, color, offsetY, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(200, 50)
	gui.StudsOffset = Vector3.new(0, offsetY or 3, 0)
	gui.MaxDistance = maxDistance or 90
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.Parent = gui
	gui.Parent = parent
	return gui
end

local function setLabel(gui, text, color)
	local label = gui:FindFirstChild("Text")
	if label then
		label.Text = text
		if color then
			label.TextColor3 = color
		end
	end
end

local function buildPlot(index)
	local angle = math.rad(15 + 30 * (index - 1))
	local center = Vector3.new(math.cos(angle) * Config.Plot.RingRadius, 0, math.sin(angle) * Config.Plot.RingRadius)
	local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local cf = CFrame.lookAt(center, center + outward)

	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. index
	local monsters = Instance.new("Folder")
	monsters.Name = "Monsters"
	monsters.Parent = folder

	Util.part({ Name = "Base", Size = Vector3.new(Config.Plot.Width, 1, Config.Plot.Length), CFrame = cf * CFrame.new(0, 0.5, -15), Color = COLORS.Base, Material = "Slate", Parent = folder })
	Util.part({ Name = "MansionFloor", Size = Vector3.new(48, 0.4, 80), CFrame = cf * CFrame.new(0, 1.2, -30), Color = COLORS.Floor, Material = "WoodPlanks", Parent = folder })
	Util.part({ Name = "Carpet", Size = Vector3.new(12, 0.2, 78), CFrame = cf * CFrame.new(0, 1.5, -30), Color = COLORS.Carpet, Material = "Fabric", CanCollide = false, Parent = folder })
	Util.part({ Name = "YardPath", Size = Vector3.new(8, 0.3, 36), CFrame = cf * CFrame.new(0, 1.15, 28), Color = { 92, 86, 100 }, Material = "Cobblestone", Parent = folder })

	local wallHeight = 8
	local function wall(size, offset)
		Util.part({ Name = "Wall", Size = size, CFrame = cf * CFrame.new(offset.X, 1.4 + wallHeight / 2, offset.Z), Color = COLORS.Wall, Material = "Brick", Parent = folder })
		Util.part({ Name = "Trim", Size = Vector3.new(size.X + 0.4, 0.6, size.Z + 0.4), CFrame = cf * CFrame.new(offset.X, 1.4 + wallHeight + 0.3, offset.Z), Color = COLORS.WallTrim, Material = "Slate", CanCollide = false, Parent = folder })
	end
	wall(Vector3.new(48, wallHeight, 1), Vector3.new(0, 0, -70))
	wall(Vector3.new(1, wallHeight, 80), Vector3.new(-24, 0, -30))
	wall(Vector3.new(1, wallHeight, 80), Vector3.new(24, 0, -30))
	wall(Vector3.new(19, wallHeight, 1), Vector3.new(-14.5, 0, 10))
	wall(Vector3.new(19, wallHeight, 1), Vector3.new(14.5, 0, 10))
	Util.part({ Name = "DoorTop", Size = Vector3.new(10, 2, 1), CFrame = cf * CFrame.new(0, 1.4 + wallHeight - 1, 10), Color = COLORS.Wall, Material = "Brick", Parent = folder })
	local doorGlow = Util.part({ Name = "DoorGlow", Size = Vector3.new(9, 5.5, 0.2), CFrame = cf * CFrame.new(0, 4.2, 10), Color = { 150, 80, 255 }, Material = "Neon", Transparency = 0.5, CanCollide = false, Parent = folder })
	local doorLight = Instance.new("PointLight")
	doorLight.Color = Color3.fromRGB(170, 100, 255)
	doorLight.Range = 22
	doorLight.Brightness = 1.5
	doorLight.Parent = doorGlow
	for _, x in ipairs({ -22, 22 }) do
		for _, z in ipairs({ -66, -40, -14 }) do
			local torch = Util.part({ Name = "Torch", Shape = "Ball", Size = Vector3.new(0.9, 0.9, 0.9), CFrame = cf * CFrame.new(x, 7.5, z), Color = { 255, 140, 30 }, Material = "Neon", CanCollide = false, Parent = folder })
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 160, 60)
			light.Range = 18
			light.Brightness = 1.2
			light.Parent = torch
		end
	end

	-- Portail et panneau
	for _, x in ipairs({ -8, 8 }) do
		Util.part({ Name = "GatePost", Size = Vector3.new(1.4, 7, 1.4), CFrame = cf * CFrame.new(x, 4.5, 45), Color = { 58, 58, 70 }, Material = "Slate", Parent = folder })
	end
	local gateSign = Util.part({ Name = "GateSign", Size = Vector3.new(18, 2.4, 0.6), CFrame = cf * CFrame.new(0, 9, 45), Color = COLORS.Wood, Material = "Wood", CanCollide = false, Parent = folder })
	local gateLabel = billboard(gateSign, "Manoir libre", UDim2.fromOffset(300, 60), Color3.fromRGB(230, 220, 255), 2.5, 200)
	for _, x in ipairs({ -29, 29 }) do
		for _, z in ipairs({ 44, 30, 16 }) do
			Util.part({ Name = "FencePost", Size = Vector3.new(0.7, 3, 0.7), CFrame = cf * CFrame.new(x, 2.5, z), Color = { 58, 58, 70 }, Material = "Metal", Parent = folder })
		end
		Util.part({ Name = "FenceRail", Size = Vector3.new(0.3, 0.3, 30), CFrame = cf * CFrame.new(x, 3.4, 30), Color = { 58, 58, 70 }, Material = "Metal", CanCollide = false, Parent = folder })
	end

	-- Caisse (collecte des coins)
	local booth = Util.part({ Name = "Booth", Size = Vector3.new(6, 4, 4), CFrame = cf * CFrame.new(18, 3, 28), Color = COLORS.Wood, Material = "Wood", Parent = folder })
	Util.part({ Name = "BoothRoof", Size = Vector3.new(7, 0.5, 5), CFrame = cf * CFrame.new(18, 5.5, 28), Color = { 255, 140, 30 }, Material = "Fabric", Parent = folder })
	Util.part({ Name = "BoothCoin", Shape = "Cylinder", Size = Vector3.new(0.4, 2.2, 2.2), CFrame = cf * CFrame.new(18, 7, 28) * CFrame.Angles(0, 0, math.rad(90)), Color = COLORS.Gold, Material = "Neon", CanCollide = false, Parent = folder })
	local boothLabel = billboard(booth, "💰 Caisse\n0 coins", UDim2.fromOffset(220, 70), Color3.fromRGB(255, 220, 120), 6, 120)
	local boothPrompt = Instance.new("ProximityPrompt")
	boothPrompt.ActionText = "Collecter"
	boothPrompt.ObjectText = "Caisse"
	boothPrompt.MaxActivationDistance = 12
	boothPrompt.HoldDuration = 0
	boothPrompt.RequiresLineOfSight = false
	boothPrompt.Parent = booth

	-- Salles (pads)
	local pads = {}
	for row = 0, 8 do
		for col = 0, 1 do
			local padIndex = row * 2 + col + 1
			local x = col == 0 and -14 or 14
			local z = 2 - row * 8
			local pad = Util.part({ Name = "Pad" .. padIndex, Size = Vector3.new(9, 0.4, 7), CFrame = cf * CFrame.new(x, 1.6, z), Color = COLORS.PadLocked, Material = "Slate", Parent = folder })
			pad:SetAttribute("PadIndex", padIndex)
			Util.part({ Name = "PadEdge", Size = Vector3.new(9.6, 0.2, 7.6), CFrame = cf * CFrame.new(x, 1.45, z), Color = { 150, 80, 255 }, Material = "Neon", Transparency = 0.6, CanCollide = false, Parent = folder })
			local label = billboard(pad, "🔒", UDim2.fromOffset(200, 60), Color3.fromRGB(200, 190, 220), 3.2, 80)
			local padPrompt = Instance.new("ProximityPrompt")
			padPrompt.ActionText = "Acheter"
			padPrompt.ObjectText = "Salle"
			padPrompt.MaxActivationDistance = 10
			padPrompt.HoldDuration = 0
			padPrompt.RequiresLineOfSight = false
			padPrompt.Enabled = false
			padPrompt.Parent = pad
			pads[padIndex] = { Part = pad, Label = label, Prompt = padPrompt, Face = cf:VectorToWorldSpace(Vector3.new(col == 0 and 1 or -1, 0, 0)) }
		end
	end

	local plot = {
		Index = index,
		CFrame = cf,
		Folder = folder,
		Pads = pads,
		Booth = booth,
		BoothLabel = boothLabel,
		BoothPrompt = boothPrompt,
		GateLabel = gateLabel,
		MonsterFolder = monsters,
		Models = {},
		Owner = nil,
		HomeCFrame = cf * CFrame.new(0, 4, 32),
		Waypoints = {
			cf:PointToWorldSpace(Vector3.new(0, 2.6, 48)),
			cf:PointToWorldSpace(Vector3.new(0, 2.6, 10)),
			cf:PointToWorldSpace(Vector3.new(0, 2.6, -64)),
			cf:PointToWorldSpace(Vector3.new(0, 2.6, 10)),
			cf:PointToWorldSpace(Vector3.new(0, 2.6, 50)),
		},
		DoorPoint = cf:PointToWorldSpace(Vector3.new(0, 2.6, 10)),
		ExitPoint = cf:PointToWorldSpace(Vector3.new(0, 2.6, 50)),
	}

	boothPrompt.Triggered:Connect(function(player)
		if plot.Owner ~= player then
			S.Net.notify(player, "Ce n'est pas ton manoir !", "error")
			return
		end
		S.Economy.collect(player)
	end)
	for padIndex, padInfo in ipairs(pads) do
		padInfo.Prompt.Triggered:Connect(function(player)
			if plot.Owner ~= player then
				return
			end
			PlotService.buyRoom(player)
		end)
	end

	folder.Parent = workspace.Map.Plots
	return plot
end

function PlotService.init(services)
	S = services
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace.Map
	for i = 1, Config.Plot.Count do
		plots[i] = buildPlot(i)
	end

	Players.PlayerRemoving:Connect(function(player)
		PlotService.release(player)
	end)

	S.Net.register("BuyRoom", "Shop", function(player)
		return PlotService.buyRoom(player)
	end)
end

function PlotService.get(player)
	return playerPlot[player]
end

function PlotService.all()
	return plots
end

function PlotService.homeCFrame(player)
	local plot = playerPlot[player]
	return plot and plot.HomeCFrame or nil
end

function PlotService.roomCount(player)
	local data = S.Data.get(player)
	if not data then
		return 0
	end
	return Economy.roomCount(data.Rebirths, data.RoomsPurchased, S.Shop.ownsPass(player, "VIP"), S.Shop.ownsPass(player, "ExtraRooms"))
end

function PlotService.roomInfo(player)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	local count = PlotService.roomCount(player)
	local nextCost = nil
	if data.RoomsPurchased < Config.Plot.MaxPurchasedRooms then
		nextCost = Economy.roomCost(data.RoomsPurchased + 1)
	end
	return {
		Count = count,
		Purchased = data.RoomsPurchased,
		MaxPurchased = Config.Plot.MaxPurchasedRooms,
		NextCost = nextCost,
		Total = Config.Plot.TotalPads,
	}
end

function PlotService.assign(player)
	if playerPlot[player] then
		return playerPlot[player]
	end
	for _, plot in ipairs(plots) do
		if plot.Owner == nil then
			plot.Owner = player
			playerPlot[player] = plot
			setLabel(plot.GateLabel, "🏚️ Manoir de " .. player.DisplayName, Color3.fromRGB(255, 230, 160))
			player:SetAttribute("PlotIndex", plot.Index)
			PlotService.refreshPads(player)
			S.Inventory.renderAll(player)
			return plot
		end
	end
	S.Net.notify(player, "Tous les manoirs sont occupés, réessaie dans un autre serveur.", "error")
	return nil
end

function PlotService.release(player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	PlotService.clearModels(player)
	plot.Owner = nil
	playerPlot[player] = nil
	setLabel(plot.GateLabel, "Manoir libre", Color3.fromRGB(230, 220, 255))
	setLabel(plot.BoothLabel, "💰 Caisse\n0 coins")
	for _, padInfo in ipairs(plot.Pads) do
		padInfo.Part.Color = Util.color(COLORS.PadLocked)
		padInfo.Prompt.Enabled = false
		setLabel(padInfo.Label, "🔒")
	end
end

function PlotService.updateBooth(player, uncollected)
	local plot = playerPlot[player]
	if plot then
		setLabel(plot.BoothLabel, "💰 Caisse\n" .. Economy.format(uncollected) .. " coins")
	end
end

-- Met a jour l'apparence des salles (ouvertes, verrouillees, achetable)
function PlotService.refreshPads(player)
	local plot = playerPlot[player]
	local data = S.Data.get(player)
	if not plot or not data then
		return
	end
	local count = PlotService.roomCount(player)
	local occupied = {}
	for _, entry in ipairs(data.Monsters) do
		if entry.Room > 0 then
			occupied[entry.Room] = true
		end
	end
	for padIndex, padInfo in ipairs(plot.Pads) do
		padInfo.Prompt.Enabled = false
		if padIndex <= count then
			padInfo.Part.Color = Util.color(COLORS.PadOpen)
			padInfo.Part.Transparency = 0
			if occupied[padIndex] then
				setLabel(padInfo.Label, "", Color3.fromRGB(255, 255, 255))
			else
				setLabel(padInfo.Label, "Salle libre", Color3.fromRGB(200, 190, 230))
			end
		else
			padInfo.Part.Color = Util.color(COLORS.PadLocked)
			padInfo.Part.Transparency = 0.2
			if padIndex == count + 1 then
				if data.RoomsPurchased < Config.Plot.MaxPurchasedRooms then
					local cost = Economy.roomCost(data.RoomsPurchased + 1)
					setLabel(padInfo.Label, "🔒 Acheter : " .. Economy.format(cost) .. " coins", Color3.fromRGB(255, 220, 120))
					padInfo.Prompt.ActionText = "Acheter (" .. Economy.format(cost) .. ")"
					padInfo.Prompt.Enabled = true
				elseif data.Rebirths < Config.Plot.MaxRebirthRooms then
					setLabel(padInfo.Label, "🔒 Prochain rebirth", Color3.fromRGB(220, 180, 255))
				elseif not S.Shop.ownsPass(player, "VIP") then
					setLabel(padInfo.Label, "🔒 Pass VIP (boutique)", Color3.fromRGB(255, 215, 60))
				elseif not S.Shop.ownsPass(player, "ExtraRooms") then
					setLabel(padInfo.Label, "🔒 Pass +3 Salles (boutique)", Color3.fromRGB(255, 215, 60))
				else
					setLabel(padInfo.Label, "🔒", Color3.fromRGB(200, 190, 220))
				end
			else
				setLabel(padInfo.Label, "🔒", Color3.fromRGB(200, 190, 220))
			end
		end
	end
end

function PlotService.buyRoom(player)
	local data = S.Data.get(player)
	if not data then
		return { ok = false, message = "Données non chargées." }
	end
	if data.RoomsPurchased >= Config.Plot.MaxPurchasedRooms then
		return { ok = false, message = "Tu as acheté toutes les salles disponibles ! Les suivantes viennent du rebirth et des passes." }
	end
	local cost = Economy.roomCost(data.RoomsPurchased + 1)
	if not S.Economy.spendCoins(player, cost) then
		return { ok = false, message = "Il te manque " .. Economy.format(cost - data.Coins) .. " coins." }
	end
	data.RoomsPurchased += 1
	PlotService.refreshPads(player)
	S.Player.sendState(player)
	S.Net.notify(player, "Nouvelle salle débloquée ! (" .. PlotService.roomCount(player) .. " salles)", "success")
	return { ok = true }
end

-- Affiche le modele d'un monstre place
function PlotService.renderMonster(player, entry)
	local plot = playerPlot[player]
	if not plot or entry.Room <= 0 then
		return
	end
	local padInfo = plot.Pads[entry.Room]
	local def = MonsterData.get(entry.Id)
	if not padInfo or not def then
		return
	end
	PlotService.removeModel(player, entry.Uid)
	local top = padInfo.Part.Position + Vector3.new(0, padInfo.Part.Size.Y / 2, 0)
	local origin = CFrame.lookAt(top, top + padInfo.Face)
	local model = MonsterBuilder.build(def, origin)
	model:SetAttribute("Uid", entry.Uid)
	local r, g, b = Rarity.color(def.Rarity)
	local label = billboard(model.PrimaryPart, string.format('<font color="rgb(%d,%d,%d)">%s</font>\n⚡ %s/s', r, g, b, def.Name, Economy.format(def.Power)), UDim2.fromOffset(200, 56), Color3.fromRGB(255, 255, 255), MonsterBuilder.height(def) + 0.5, 70)
	label.Name = "NameTag"
	CollectionService:AddTag(model, "Monster")
	model.Parent = plot.MonsterFolder
	plot.Models[entry.Uid] = model
end

function PlotService.removeModel(player, uid)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	local model = plot.Models[uid]
	if model then
		model:Destroy()
		plot.Models[uid] = nil
	end
end

function PlotService.clearModels(player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	for uid, model in pairs(plot.Models) do
		model:Destroy()
		plot.Models[uid] = nil
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Rebirth : remise a zero contre un multiplicateur permanent et des deblocages.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)

local RebirthService = {}
local S

function RebirthService.perform(player, free)
	local data = S.Data.get(player)
	if not data then
		return { ok = false, message = "Données non chargées." }
	end
	local cost = Economy.rebirthCost(data.Rebirths)
	if not free and data.Coins < cost then
		return { ok = false, message = "Il te manque " .. Economy.format(cost - data.Coins) .. " coins pour ce rebirth." }
	end
	data.Coins = 0
	data.Rebirths += 1
	S.Inventory.wipeForRebirth(player)
	local st = S.Economy.getState(player)
	st.Uncollected = 0
	S.Plot.updateBooth(player, 0)
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	S.Player.sendState(player)
	S.Net.announce("♻️ " .. player.DisplayName .. " vient de faire son rebirth n°" .. data.Rebirths .. " ! (x" .. Economy.rebirthMultiplier(data.Rebirths) .. " coins)", "rebirth")
	S.Net.fire(player, "RebirthDone", { Rebirths = data.Rebirths, Multiplier = Economy.rebirthMultiplier(data.Rebirths) })
	return { ok = true, data = { Rebirths = data.Rebirths } }
end

function RebirthService.init(services)
	S = services
	S.Net.register("Rebirth", "Shop", function(player)
		return RebirthService.perform(player, false)
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Distribution des recompenses (quotidien, temps de jeu, saison, codes, offres).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local MonsterData = require(ReplicatedStorage.Shared.MonsterData)

local RewardService = {}
local S

function RewardService.init(services)
	S = services
end

-- Applique une recompense et retourne un texte descriptif.
-- reward : { Type = "Coins"|"CoinsBoost"|"LuckBoost"|"NightmareCoffin"|"Monster", ... }
function RewardService.grant(player, reward, scaleWithRebirth)
	local data = S.Data.get(player)
	if not data then
		return nil
	end
	if reward.Type == "Coins" then
		local amount = reward.Amount
		if scaleWithRebirth ~= false then
			amount = math.floor(amount * Economy.rebirthMultiplier(data.Rebirths))
		end
		S.Economy.addCoins(player, amount)
		return "+" .. Economy.format(amount) .. " coins"
	elseif reward.Type == "CoinsBoost" then
		local seconds = reward.Seconds or (reward.Minutes or 0) * 60
		S.Economy.addBoost(player, "Coins", seconds)
		return "2x Coins pendant " .. math.floor(seconds / 60) .. " min"
	elseif reward.Type == "LuckBoost" then
		local seconds = reward.Seconds or (reward.Minutes or 0) * 60
		S.Economy.addBoost(player, "Luck", seconds)
		return "2x Chance pendant " .. math.floor(seconds / 60) .. " min"
	elseif reward.Type == "NightmareCoffin" then
		data.NightmareCoffins += (reward.Amount or 1)
		player:SetAttribute("NightmareCoffins", data.NightmareCoffins)
		return (reward.Amount or 1) .. " Cercueil(s) Cauchemar"
	elseif reward.Type == "Monster" then
		local def = MonsterData.get(reward.Id)
		if not def then
			return nil
		end
		S.Inventory.addMonster(player, reward.Id, true)
		return "Monstre exclusif : " .. def.Name
	end
	return nil
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">SeasonPassService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Passe de saison : XP, paliers, recompenses gratuites et premium.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SeasonPass = require(ReplicatedStorage.Shared.SeasonPass)

local SeasonPassService = {}
local S

function SeasonPassService.addXp(player, amount)
	local data = S.Data.get(player)
	if not data or amount <= 0 then
		return
	end
	if os.time() > Config.Season.EndsAt then
		return
	end
	local before = SeasonPass.tierForXp(data.Season.Xp)
	data.Season.Xp += amount
	player:SetAttribute("SeasonXp", data.Season.Xp)
	local after = SeasonPass.tierForXp(data.Season.Xp)
	if after > before then
		S.Net.notify(player, "🎃 Passe Spooky : palier " .. after .. " atteint ! Récupère ta récompense.", "success")
	end
end

function SeasonPassService.claim(player, tier, premium)
	local data = S.Data.get(player)
	tier = tonumber(tier)
	if not tier or tier < 1 or tier > SeasonPass.TierCount or tier % 1 ~= 0 then
		return { ok = false, message = "Palier invalide." }
	end
	if SeasonPass.tierForXp(data.Season.Xp) < tier then
		return { ok = false, message = "Tu n'as pas encore atteint ce palier." }
	end
	local rewards = SeasonPass.Rewards[tier]
	local claimed = premium and data.Season.ClaimedPremium or data.Season.ClaimedFree
	local key = tostring(tier)
	if claimed[key] then
		return { ok = false, message = "Récompense déjà récupérée." }
	end
	if premium and not S.Shop.ownsPass(player, "SeasonPremium") then
		return { ok = false, message = "Le Passe Spooky Premium est nécessaire pour cette récompense." }
	end
	local reward = premium and rewards.Premium or rewards.Free
	local text = S.Reward.grant(player, reward, true)
	claimed[key] = true
	S.Player.sendState(player)
	S.Net.notify(player, "🎃 Palier " .. tier .. " : " .. tostring(text), "success")
	return { ok = true, message = text }
end

function SeasonPassService.init(services)
	S = services
	S.Net.register("ClaimSeason", "Shop", function(player, payload)
		return SeasonPassService.claim(player, payload.Tier, payload.Premium == true)
	end)
end

return SeasonPassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Boutique : Game Passes, Developer Products, recus, politique des objets aleatoires payants.
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Offers = require(ReplicatedStorage.Shared.Offers)
local MonetizationIds = require(ReplicatedStorage.Shared.MonetizationIds)

local ShopService = {}
local S

local PASS_ORDER = { "DoubleCoins", "AutoCollect", "TripleHatch", "ExtraRooms", "Lucky", "VIP", "Ultimate", "SeasonPremium" }
local PRODUCT_ORDER = { "CoinsSmall", "CoinsMedium", "CoinsLarge", "CoinsHuge", "BoostCoins", "BoostLuck", "ServerLuck", "InstantRebirth", "StarterPack", "FlashCoinVault", "FlashBoostBundle", "FlashRebirthRush" }
local ULTIMATE_INCLUDES = { DoubleCoins = true, AutoCollect = true, TripleHatch = true, ExtraRooms = true, Lucky = true, VIP = true }
-- Articles lies aux objets aleatoires payants (masques dans les regions ou la politique l'exige)
local RANDOM_RELATED = { Lucky = true, Ultimate = true, BoostLuck = true, ServerLuck = true, CoinsSmall = true, CoinsMedium = true, CoinsLarge = true, CoinsHuge = true, StarterPack = true, FlashCoinVault = true, FlashBoostBundle = true }

local passCache = {} -- [player] = { [key] = bool }
local policyCache = {} -- [player] = bool (restreint)
local catalog = { Passes = {}, Products = {} }
local passKeyById = {}
local productKeyById = {}

local function buildCatalog()
	local missing = {}
	for _, key in ipairs(PASS_ORDER) do
		local def = MonetizationIds.GamePasses[key]
		table.insert(catalog.Passes, { Key = key, Id = def.Id, Price = def.Price, Name = def.Name, Desc = def.Desc, Icon = def.Icon, Configured = def.Id > 0, Random = RANDOM_RELATED[key] == true })
		if def.Id > 0 then
			passKeyById[def.Id] = key
		else
			table.insert(missing, "GamePasses." .. key)
		end
	end
	for _, key in ipairs(PRODUCT_ORDER) do
		local def = MonetizationIds.Products[key]
		table.insert(catalog.Products, { Key = key, Id = def.Id, Price = def.Price, Name = def.Name, Configured = def.Id > 0, Random = RANDOM_RELATED[key] == true })
		if def.Id > 0 then
			productKeyById[def.Id] = key
		else
			table.insert(missing, "Products." .. key)
		end
	end
	if #missing > 0 then
		warn("[ShopService] Identifiants non configurés dans ReplicatedStorage/Shared/MonetizationIds : " .. table.concat(missing, ", ") .. ". Ces articles sont désactivés en boutique.")
	end
end

local function fetchRealPrices()
	for _, entry in ipairs(catalog.Passes) do
		if entry.Configured then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(entry.Id, Enum.InfoType.GamePass)
			end)
			if ok and info and info.PriceInRobux then
				entry.Price = info.PriceInRobux
			end
		end
	end
	for _, entry in ipairs(catalog.Products) do
		if entry.Configured then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(entry.Id, Enum.InfoType.Product)
			end)
			if ok and info and info.PriceInRobux then
				entry.Price = info.PriceInRobux
			end
		end
	end
end

function ShopService.catalog()
	return catalog
end

function ShopService.ownsPass(player, key)
	local cache = passCache[player]
	if not cache then
		return false
	end
	if cache[key] then
		return true
	end
	if ULTIMATE_INCLUDES[key] and cache.Ultimate then
		return true
	end
	return false
end

function ShopService.ownedPasses(player)
	local result = {}
	for _, key in ipairs(PASS_ORDER) do
		result[key] = ShopService.ownsPass(player, key)
	end
	return result
end

function ShopService.isRandomRestricted(player)
	return policyCache[player] == true
end

local function grantVipMonster(player)
	local data = S.Data.get(player)
	if data and not data.VipMonsterGranted then
		data.VipMonsterGranted = true
		S.Inventory.addMonster(player, "vip_phantom", true)
		S.Net.notify(player, "👑 Ton Phantom VIP exclusif a rejoint ton manoir !", "success")
	end
end

function ShopService.setupPlayer(player)
	local cache = {}
	passCache[player] = cache
	for _, key in ipairs(PASS_ORDER) do
		local def = MonetizationIds.GamePasses[key]
		if def.Id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.Id)
			end)
			cache[key] = ok and owns == true
		else
			cache[key] = false
		end
	end
	local okPolicy, policy = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if okPolicy and type(policy) == "table" then
		policyCache[player] = policy.ArePaidRandomItemsRestricted == true
	else
		policyCache[player] = true
	end
	player:SetAttribute("PaidRandomRestricted", policyCache[player])
	player:SetAttribute("VIP", ShopService.ownsPass(player, "VIP"))
	if ShopService.ownsPass(player, "VIP") then
		grantVipMonster(player)
	end
end

local function onPassPurchased(player, key)
	local cache = passCache[player]
	if not cache then
		return
	end
	cache[key] = true
	player:SetAttribute("VIP", ShopService.ownsPass(player, "VIP"))
	if ShopService.ownsPass(player, "VIP") then
		grantVipMonster(player)
		S.Player.applyVipTag(player)
	end
	S.Economy.recalculate(player)
	S.Plot.refreshPads(player)
	S.Inventory.renderAll(player)
	S.Player.sendState(player)
	local def = MonetizationIds.GamePasses[key]
	S.Net.notify(player, "✅ Pass " .. def.Name .. " activé ! Merci pour ton soutien.", "success")
	S.Net.announce("🛒 " .. player.DisplayName .. " a acheté le pass " .. def.Name .. " !", "shop")
	S.Data.save(player)
end

local function grantProduct(player, key)
	local data = S.Data.get(player)
	local def = MonetizationIds.Products[key]
	for _, bundle in ipairs(Config.CoinBundles) do
		if bundle.Key == key then
			local amount = Economy.bundleAmount(bundle.Coins, data.Rebirths)
			S.Economy.addCoins(player, amount)
			S.Net.notify(player, "💰 +" .. Economy.format(amount) .. " coins ! Merci pour ton achat.", "success")
			return
		end
	end
	if key == "BoostCoins" then
		S.Economy.addBoost(player, "Coins", Config.Boosts.CoinsBoostSeconds)
		S.Net.notify(player, "⚡ Boost 2x Coins activé pendant 30 min !", "success")
	elseif key == "BoostLuck" then
		S.Economy.addBoost(player, "Luck", Config.Boosts.LuckBoostSeconds)
		S.Net.notify(player, "🍀 Boost 2x Chance activé pendant 30 min !", "success")
	elseif key == "ServerLuck" then
		S.Economy.activateServerLuck(Config.Boosts.ServerLuckSeconds, player)
	elseif key == "InstantRebirth" then
		S.Rebirth.perform(player, true)
		S.Net.notify(player, "♻️ Rebirth instantané effectué !", "success")
	elseif key == "StarterPack" then
		local starter = Config.StarterPack
		S.Economy.addCoins(player, starter.Coins)
		S.Inventory.addMonster(player, starter.MonsterId, true)
		S.Economy.addBoost(player, "Coins", starter.CoinsBoostSeconds)
		data.Starter.Purchased = true
		S.Net.notify(player, "🎁 Pack de démarrage reçu : coins, Ghosty Doré et boost 2x !", "success")
	else
		for _, deal in ipairs(Config.FlashDeals.Deals) do
			if deal.Key == key then
				if deal.Coins then
					S.Economy.addCoins(player, Economy.bundleAmount(deal.Coins, data.Rebirths))
				end
				if deal.CoinsBoostSeconds then
					S.Economy.addBoost(player, "Coins", deal.CoinsBoostSeconds)
				end
				if deal.LuckBoostSeconds then
					S.Economy.addBoost(player, "Luck", deal.LuckBoostSeconds)
				end
				if deal.InstantRebirth then
					S.Rebirth.perform(player, true)
				end
				S.Net.notify(player, "⚡ Offre flash reçue : " .. deal.Title .. " !", "success")
				return
			end
		end
		error("Produit sans effet : " .. tostring(key))
	end
	if def then
		S.Net.announce("🛒 " .. player.DisplayName .. " a acheté " .. def.Name .. " !", "shop")
	end
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = S.Data.get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key = productKeyById[receiptInfo.ProductId]
	if not key then
		warn("[ShopService] Produit inconnu : " .. tostring(receiptInfo.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if S.Data.hasReceipt(data, receiptInfo.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local ok, err = pcall(grantProduct, player, key)
	if not ok then
		warn("[ShopService] Échec d'attribution du produit " .. key .. " : " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	S.Data.recordReceipt(data, receiptInfo.PurchaseId)
	S.Player.sendState(player)
	pcall(S.Data.save, player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function promptHandler(player, payload)
	local kind = payload.Kind
	local key = payload.Key
	if type(kind) ~= "string" or type(key) ~= "string" then
		return { ok = false, message = "Requête invalide." }
	end
	local data = S.Data.get(player)
	if RANDOM_RELATED[key] and ShopService.isRandomRestricted(player) then
		return { ok = false, message = "Cet article n'est pas disponible dans ta région." }
	end
	if kind == "Pass" then
		local def = MonetizationIds.GamePasses[key]
		if not def then
			return { ok = false, message = "Article inconnu." }
		end
		if def.Id <= 0 then
			return { ok = false, message = "Cet article n'est pas encore disponible." }
		end
		if ShopService.ownsPass(player, key) then
			return { ok = false, message = "Tu possèdes déjà ce pass !" }
		end
		local ok = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, def.Id)
		end)
		return { ok = ok }
	elseif kind == "Product" then
		local def = MonetizationIds.Products[key]
		if not def then
			return { ok = false, message = "Article inconnu." }
		end
		if def.Id <= 0 then
			return { ok = false, message = "Cet article n'est pas encore disponible." }
		end
		if key == "StarterPack" and Offers.starterRemaining(data.Starter.FirstJoin, data.Starter.Purchased, os.time()) <= 0 then
			return { ok = false, message = "Cette offre a expiré." }
		end
		if string.sub(key, 1, 5) == "Flash" then
			local _, deal = Offers.getFlashDeal(os.time())
			if deal.Key ~= key then
				return { ok = false, message = "Cette offre flash n'est plus active." }
			end
		end
		local ok = pcall(function()
			MarketplaceService:PromptProductPurchase(player, def.Id)
		end)
		return { ok = ok }
	end
	return { ok = false, message = "Requête invalide." }
end

function ShopService.init(services)
	S = services
	buildCatalog()
	task.spawn(fetchRealPrices)
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById[passId]
		if key and S.Data.get(player) then
			onPassPurchased(player, key)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		passCache[player] = nil
		policyCache[player] = nil
	end)
	S.Net.register("Prompt", "Shop", promptHandler)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">VisitorService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Visiteurs PNJ qui traversent les manoirs. Le proprietaire clique dessus pour leur faire peur.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local VisitorService = {}
local S

local visitors = {} -- [model] = visitor
local plotVisitors = {} -- [plotIndex] = { count, nextSpawn }
local lastScare = {} -- [player] = os.clock

local rng = Random.new(2026)
local SHIRTS = { { 200, 60, 60 }, { 60, 120, 220 }, { 80, 180, 90 }, { 230, 180, 50 }, { 180, 80, 200 }, { 240, 240, 240 } }
local SKINS = { { 255, 220, 180 }, { 220, 170, 130 }, { 160, 110, 80 }, { 110, 70, 50 } }

local function buildVisitor(position)
	local model = Instance.new("Model")
	model.Name = "Visitor"
	local shirt = SHIRTS[rng:NextInteger(1, #SHIRTS)]
	local skin = SKINS[rng:NextInteger(1, #SKINS)]

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 1)
	root.Color = Util.color(shirt)
	root.Material = Enum.Material.Fabric
	root.Anchored = false
	root.CanCollide = false
	root.CanTouch = false
	root.CFrame = CFrame.new(position)
	root.Parent = model
	model.PrimaryPart = root

	local function attach(name, size, offset, color, shape)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = Util.color(color)
		part.Material = Enum.Material.SmoothPlastic
		if shape then
			part.Shape = Enum.PartType[shape]
		end
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = root.CFrame * offset
		part.Parent = model
		Util.weld(root, part)
		return part
	end
	attach("Head", Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 1.65, 0), skin, "Ball")
	attach("LegL", Vector3.new(0.8, 1.8, 0.8), CFrame.new(-0.5, -1.9, 0), { 50, 50, 70 })
	attach("LegR", Vector3.new(0.8, 1.8, 0.8), CFrame.new(0.5, -1.9, 0), { 50, 50, 70 })
	attach("ArmL", Vector3.new(0.7, 1.8, 0.7), CFrame.new(-1.35, -0.1, 0), skin)
	attach("ArmR", Vector3.new(0.7, 1.8, 0.7), CFrame.new(1.35, -0.1, 0), skin)
	attach("EyeL", Vector3.new(0.25, 0.25, 0.25), CFrame.new(-0.28, 1.75, -0.6), { 20, 20, 20 }, "Ball")
	attach("EyeR", Vector3.new(0.25, 0.25, 0.25), CFrame.new(0.28, 1.75, -0.6), { 20, 20, 20 }, "Ball")
	if rng:NextNumber() < 0.5 then
		attach("Hat", Vector3.new(1.4, 0.5, 1.4), CFrame.new(0, 2.45, 0), { rng:NextInteger(30, 220), rng:NextInteger(30, 220), rng:NextInteger(30, 220) })
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "MoveAttachment"
	attachment.Parent = root

	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "Move"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.MaxForce = math.huge
	alignPosition.MaxVelocity = Config.Visitors.Speed
	alignPosition.Responsiveness = 40
	alignPosition.RigidityEnabled = false
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.Position = position
	alignPosition.Parent = root

	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "Face"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.MaxTorque = math.huge
	alignOrientation.Responsiveness = 40
	alignOrientation.RigidityEnabled = true
	alignOrientation.CFrame = CFrame.new(position)
	alignOrientation.Parent = root

	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = Config.Income.ScareRange
	click.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "Emote"
	gui.Size = UDim2.fromOffset(80, 50)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 60
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "😱"
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Parent = gui
	gui.Parent = root

	return model, root, alignPosition, alignOrientation, click, gui
end

local function setTarget(visitor, target)
	visitor.Target = target
	visitor.AlignPosition.Position = target
	local from = visitor.Root.Position
	local flat = Vector3.new(target.X, from.Y, target.Z)
	if (flat - from).Magnitude > 0.5 then
		visitor.AlignOrientation.CFrame = CFrame.lookAt(from, flat)
	end
end

local function despawn(visitor)
	visitors[visitor.Model] = nil
	local info = plotVisitors[visitor.Plot.Index]
	if info then
		info.Count = math.max(0, info.Count - 1)
		info.NextSpawn = os.clock() + Config.Visitors.SpawnDelay
	end
	visitor.Model:Destroy()
end

local function spawnVisitor(plot)
	local start = plot.Waypoints[1]
	local model, root, alignPosition, alignOrientation, click, emote = buildVisitor(start)
	local visitor = {
		Model = model,
		Root = root,
		AlignPosition = alignPosition,
		AlignOrientation = alignOrientation,
		Emote = emote,
		Plot = plot,
		WaypointIndex = 1,
		Fleeing = false,
		Scared = false,
		Path = plot.Waypoints,
	}
	visitors[model] = visitor
	model.Parent = workspace.Map.Visitors
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	click.MouseClick:Connect(function(player)
		VisitorService.onScare(player, visitor)
	end)
	visitor.WaypointIndex = 2
	setTarget(visitor, plot.Waypoints[2])
	local info = plotVisitors[plot.Index]
	info.Count += 1
end

local function step()
	local now = os.clock()
	for _, plot in ipairs(S.Plot.all()) do
		local info = plotVisitors[plot.Index]
		if not info then
			info = { Count = 0, NextSpawn = 0 }
			plotVisitors[plot.Index] = info
		end
		if plot.Owner and info.Count < Config.Visitors.PerPlot and now >= info.NextSpawn then
			spawnVisitor(plot)
			info.NextSpawn = now + Config.Visitors.SpawnDelay
		end
	end
	for model, visitor in pairs(visitors) do
		if not visitor.Plot.Owner or not model.Parent then
			despawn(visitor)
		else
			local pos = visitor.Root.Position
			if pos.Y < -20 or (pos - visitor.Target).Magnitude > 200 then
				despawn(visitor)
			else
				local flatDistance = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(visitor.Target.X, 0, visitor.Target.Z)).Magnitude
				if flatDistance < 2 then
					visitor.WaypointIndex += 1
					local nextPoint = visitor.Path[visitor.WaypointIndex]
					if nextPoint then
						setTarget(visitor, nextPoint)
					else
						despawn(visitor)
					end
				end
			end
		end
	end
end

function VisitorService.onScare(player, visitor)
	local data = S.Data.get(player)
	if not data or visitor.Scared then
		return
	end
	if visitor.Plot.Owner ~= player then
		S.Net.notify(player, "Fais peur aux visiteurs de TON manoir !", "error")
		return
	end
	local now = os.clock()
	if lastScare[player] and now - lastScare[player] < Config.Income.ScareCooldown then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - visitor.Root.Position).Magnitude > Config.Income.ScareRange + 6 then
		return
	end
	lastScare[player] = now
	visitor.Scared = true
	visitor.Fleeing = true
	visitor.Emote.Enabled = true
	visitor.AlignPosition.MaxVelocity = Config.Visitors.Speed * 2.2
	visitor.Path = { visitor.Plot.DoorPoint, visitor.Plot.ExitPoint }
	visitor.WaypointIndex = 1
	local pos = visitor.Root.Position
	if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(visitor.Plot.DoorPoint.X, 0, visitor.Plot.DoorPoint.Z)).Magnitude < 3 or (pos - visitor.Plot.ExitPoint).Magnitude < (pos - visitor.Plot.DoorPoint).Magnitude then
		visitor.WaypointIndex = 2
	end
	setTarget(visitor, visitor.Path[visitor.WaypointIndex])

	local st = S.Economy.getState(player)
	local coins = math.max(Config.Income.ScareBaseCoins * S.Economy.getState(player).Multiplier, st.Income * Config.Income.ScareIncomeSeconds)
	coins = math.floor(coins)
	S.Economy.addCoins(player, coins)
	data.Stats.Scares += 1
	S.Season.addXp(player, Config.Season.XpScare)
	S.Net.fire(player, "ScarePopup", { Amount = coins, Position = visitor.Root.Position })
end

function VisitorService.init(services)
	S = services
	local folder = Instance.new("Folder")
	folder.Name = "Visitors"
	folder.Parent = workspace.Map
	Players.PlayerRemoving:Connect(function(player)
		lastScare[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(step)
			if not ok then
				warn("[VisitorService] " .. tostring(err))
			end
		end
	end)
end

return VisitorService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
