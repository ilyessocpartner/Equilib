      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">DailyRewards</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Recompenses quotidiennes avec serie (streak). Logique pure.
local DailyRewards = {}

DailyRewards.Cycle = {
	{ Day = 1, Type = "Coins", Amount = 500, Label = "500 coins" },
	{ Day = 2, Type = "Coins", Amount = 1000, Label = "1 000 coins" },
	{ Day = 3, Type = "Coins", Amount = 2500, Label = "2 500 coins" },
	{ Day = 4, Type = "CoinsBoost", Minutes = 20, Label = "2x Coins 20 min" },
	{ Day = 5, Type = "Coins", Amount = 8000, Label = "8 000 coins" },
	{ Day = 6, Type = "LuckBoost", Minutes = 20, Label = "2x Chance 20 min" },
	{ Day = 7, Type = "NightmareCoffin", Amount = 1, Coins = 30000, Label = "Cercueil Cauchemar + 30 000 coins" },
}

DailyRewards.ClaimInterval = 20 * 3600 -- on peut reclamer apres 20h (tolerance)
DailyRewards.StreakBreak = 48 * 3600 -- serie perdue apres 48h sans reclamer

-- Retourne { CanClaim, SecondsUntil, Streak (serie apres reclamation), Reset }
function DailyRewards.evaluate(lastClaim, streak, now)
	lastClaim = lastClaim or 0
	streak = streak or 0
	if lastClaim <= 0 then
		return { CanClaim = true, SecondsUntil = 0, Streak = 1, Reset = false }
	end
	local elapsed = now - lastClaim
	if elapsed < DailyRewards.ClaimInterval then
		return { CanClaim = false, SecondsUntil = DailyRewards.ClaimInterval - elapsed, Streak = streak, Reset = false }
	end
	if elapsed > DailyRewards.StreakBreak then
		return { CanClaim = true, SecondsUntil = 0, Streak = 1, Reset = true }
	end
	return { CanClaim = true, SecondsUntil = 0, Streak = streak + 1, Reset = false }
end

-- Jour du cycle (1..7) pour une serie donnee
function DailyRewards.dayForStreak(streak)
	local cycle = #DailyRewards.Cycle
	local day = ((math.max(1, streak) - 1) % cycle) + 1
	return day
end

function DailyRewards.rewardForStreak(streak)
	return DailyRewards.Cycle[DailyRewards.dayForStreak(streak)]
end

return DailyRewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Fonctions pures d'economie : couts, multiplicateurs, formatage.
local Config = require(script.Parent.Config)
local Rarity = require(script.Parent.Rarity)

local Economy = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Economy.format(n)
	n = tonumber(n) or 0
	if n ~= n or n == math.huge then
		return "∞"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		return (negative and "-" or "") .. tostring(math.floor(n))
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n = n / 1000
		index += 1
	end
	local text
	if n >= 100 then
		text = string.format("%.0f", n)
	elseif n >= 10 then
		text = string.format("%.1f", n)
	else
		text = string.format("%.2f", n)
	end
	text = text:gsub("%.?0+$", "")
	return (negative and "-" or "") .. text .. SUFFIXES[index]
end

function Economy.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Cout de la N-ieme salle achetee (1 = premiere)
function Economy.roomCost(purchasedIndex)
	return Config.RoomCosts[purchasedIndex]
end

-- Nombre total de salles disponibles pour un etat de joueur
function Economy.roomCount(rebirths, roomsPurchased, hasVip, hasExtraRooms)
	local rooms = Config.Plot.BaseRooms
	rooms += math.min(rebirths, Config.Plot.MaxRebirthRooms)
	rooms += math.min(roomsPurchased, Config.Plot.MaxPurchasedRooms)
	if hasVip then
		rooms += Config.Plot.VipRooms
	end
	if hasExtraRooms then
		rooms += Config.Plot.ExtraRoomsPass
	end
	return math.min(rooms, Config.Plot.TotalPads)
end

-- Cout du prochain rebirth quand on en a deja `rebirths`
function Economy.rebirthCost(rebirths)
	local costs = Config.Rebirth.Costs
	local index = rebirths + 1
	if costs[index] then
		return costs[index]
	end
	local last = costs[#costs]
	local extra = index - #costs
	return last * (Config.Rebirth.CostGrowthAfterTable ^ extra)
end

function Economy.rebirthMultiplier(rebirths)
	return 1 + Config.Rebirth.MultiplierPerRebirth * rebirths
end

-- Prix de revente d'un monstre
function Economy.sellPrice(rarityName, coffinCost)
	local info = Rarity.Info[rarityName]
	local factor = info and info.SellFactor or 0.1
	return math.floor(coffinCost * factor)
end

-- Montant d'un bundle de coins selon le rebirth du joueur
function Economy.bundleAmount(baseCoins, rebirths)
	return math.floor(baseCoins * Economy.rebirthMultiplier(rebirths))
end

-- Multiplicateur final applique aux gains.
-- flags : { Rebirths, DoubleCoins, VIP, CoinsBoost, IndexCount, InGroup }
function Economy.incomeMultiplier(flags)
	local mult = Economy.rebirthMultiplier(flags.Rebirths or 0)
	if flags.DoubleCoins then
		mult *= 2
	end
	if flags.VIP then
		mult *= 1 + Config.Income.VipBonus
	end
	if flags.CoinsBoost then
		mult *= Config.Boosts.CoinsBoostMultiplier
	end
	mult *= 1 + Config.Income.IndexBonusPerMonster * (flags.IndexCount or 0)
	if flags.InGroup then
		mult *= 1 + Config.Income.GroupBonus
	end
	return mult
end

-- Multiplicateur de chance final (affiche dans les odds)
function Economy.luckMultiplier(flags)
	local luck = 1
	if flags.LuckyPass then
		luck *= 2
	end
	if flags.LuckBoost then
		luck *= Config.Boosts.LuckBoostMultiplier
	end
	if flags.ServerLuck then
		luck *= Config.Boosts.ServerLuckMultiplier
	end
	return luck
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GachaMath</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Tirage pondere avec chance. Module pur (aucune dependance).
-- entries : { { Id = string, Weight = number, Rank = number } }
-- La chance multiplie le poids des raretes de rang >= 3 (Rare et au-dela).
local GachaMath = {}

GachaMath.LuckMinRank = 3

function GachaMath.weighted(entries, luck)
	luck = math.max(1, luck or 1)
	local total = 0
	local result = {}
	for _, entry in ipairs(entries) do
		local weight = entry.Weight
		if entry.Rank >= GachaMath.LuckMinRank then
			weight = weight * luck
		end
		total += weight
		table.insert(result, { Id = entry.Id, Weight = weight, Rank = entry.Rank })
	end
	for _, entry in ipairs(result) do
		entry.Chance = total > 0 and entry.Weight / total or 0
	end
	return result, total
end

-- rng : fonction retournant un nombre dans [0, 1)
function GachaMath.roll(entries, luck, rng)
	local weighted, total = GachaMath.weighted(entries, luck)
	local r = (rng or math.random)() * total
	local acc = 0
	for _, entry in ipairs(weighted) do
		acc += entry.Weight
		if r < acc then
			return entry.Id
		end
	end
	return weighted[#weighted].Id
end

-- Pourcentage lisible (ex : 0.00123 -> "0.12%")
function GachaMath.formatChance(chance)
	local pct = chance * 100
	if pct >= 10 then
		return string.format("%.0f%%", pct)
	elseif pct >= 1 then
		return string.format("%.1f%%", pct)
	elseif pct >= 0.01 then
		return string.format("%.2f%%", pct)
	else
		return string.format("%.4f%%", pct)
	end
end

return GachaMath
]]></string>
        </Properties>
      </Item>
