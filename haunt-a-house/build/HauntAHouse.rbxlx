          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">AnimController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Animations locales : flottement des monstres et du boss (aucun cout reseau).
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local AnimController = {}

function AnimController.init(ctx)
	local tracked = {} -- [model] = { Base = CFrame, Phase = number, Boss = bool }
	local function track(model, isBoss)
		if tracked[model] then
			return
		end
		local root = model.PrimaryPart or model:FindFirstChild("Root")
		if not root then
			task.delay(0.2, function()
				if model.Parent then
					track(model, isBoss)
				end
			end)
			return
		end
		tracked[model] = { Base = model:GetPivot(), Phase = math.random() * math.pi * 2, Boss = isBoss }
	end
	local function untrack(model)
		tracked[model] = nil
	end
	for _, model in ipairs(CollectionService:GetTagged("Monster")) do
		track(model, false)
	end
	for _, model in ipairs(CollectionService:GetTagged("Boss")) do
		track(model, true)
	end
	CollectionService:GetInstanceAddedSignal("Monster"):Connect(function(model)
		track(model, false)
	end)
	CollectionService:GetInstanceRemovedSignal("Monster"):Connect(untrack)
	CollectionService:GetInstanceAddedSignal("Boss"):Connect(function(model)
		track(model, true)
	end)
	CollectionService:GetInstanceRemovedSignal("Boss"):Connect(untrack)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		local camera = workspace.CurrentCamera
		local cameraPosition = camera and camera.CFrame.Position or Vector3.new()
		local t = os.clock()
		for model, info in pairs(tracked) do
			if not model.Parent then
				tracked[model] = nil
			else
				local distance = (info.Base.Position - cameraPosition).Magnitude
				if distance < 160 then
					local offset
					if info.Boss then
						offset = CFrame.new(0, math.sin(t * 1.5 + info.Phase) * 0.6, 0) * CFrame.Angles(0, math.sin(t * 0.7) * 0.15, 0)
					else
						offset = CFrame.new(0, 0.25 + math.sin(t * 2.2 + info.Phase) * 0.25, 0) * CFrame.Angles(0, math.sin(t * 1.1 + info.Phase) * 0.12, 0)
					end
					model:PivotTo(info.Base * offset)
				end
			end
		end
	end)
end

return AnimController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">BossController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Barre de vie du boss et avertissements.
local CollectionService = game:GetService("CollectionService")

local BossController = {}

function BossController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local screen = UI.screen()

	local frame = UI.new("Frame", { Name = "BossBar", Size = UDim2.fromOffset(460, 76), Position = UDim2.new(0.5, 0, 0, 14), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(60, 20, 30), Visible = false, ZIndex = 8, Parent = screen }, { UI.corner(14), UI.stroke(UI.Colors.Red, 3), UI.padding(10, 6) })
	local nameLabel = UI.label({ Text = "", Font = UI.Font, TextSize = 18, Size = UDim2.new(0.7, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Red, ZIndex = 9, Parent = frame })
	local timerLabel = UI.label({ Text = "", Font = UI.Font, TextSize = 16, Size = UDim2.new(0.3, 0, 0, 24), Position = UDim2.new(0.7, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 9, Parent = frame })
	local bar = UI.progress(frame, UI.Colors.Red, UDim2.new(1, 0, 0, 26), UDim2.new(0, 0, 0, 30))
	local state = { Active = false, Hp = 0, MaxHp = 1, EndsAt = 0 }

	local function apply(payload)
		state = payload
		frame.Visible = payload.Active
		if payload.Active then
			nameLabel.Text = "⚔️ " .. payload.Name .. "  (clique dessus à l'Arène !)"
			bar.Set(payload.Hp / math.max(1, payload.MaxHp), Economy.format(payload.Hp) .. " / " .. Economy.format(payload.MaxHp) .. " PV")
		end
	end

	ctx.on("Boss", apply)
	ctx.on("BossWarning", function(payload)
		UI.toast("🌙 Minuit dans " .. payload.Seconds .. " s : rejoins l'Arène (au nord de la place) pour le raid !", "boss", 8)
	end)
	ctx.on("BossHit", function(payload)
		local bossModel = CollectionService:GetTagged("Boss")[1]
		if bossModel and bossModel.PrimaryPart then
			ctx.popup3D(bossModel.PrimaryPart.Position + Vector3.new(0, 8, 0), "-" .. Economy.format(payload.Damage), UI.Colors.Red)
		end
	end)
	task.spawn(function()
		local synced = false
		while true do
			task.wait(1)
			if not synced and ctx.attr("DataLoaded") == true then
				local result = ctx.requestSilent("BossState")
				if result.ok and result.data then
					synced = true
					apply(result.data)
				end
			end
			if state.Active then
				timerLabel.Text = "⏳ " .. Economy.formatTime(state.EndsAt - os.time())
				if os.time() > state.EndsAt + 3 then
					frame.Visible = false
					state.Active = false
				end
			end
		end
	end)
end

return BossController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">CodesController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Codes promotionnels.
local CodesController = {}

function CodesController.init(ctx)
	local UI = ctx.UI
	local window = UI.window("Codes", "Codes", { Icon = "🔑", Size = UDim2.fromScale(0.42, 0.42), MaxSize = Vector2.new(520, 320) })
	local body = window.Body
	UI.label({ Text = "Entre un code pour recevoir des coins ou des boosts. Suis les réseaux du jeu pour découvrir les nouveaux codes !", TextSize = 15, Size = UDim2.new(1, 0, 0, 60), TextColor3 = UI.Colors.Muted, ZIndex = 23, Parent = body })
	local box = UI.new("TextBox", { Size = UDim2.new(1, 0, 0, 48), Position = UDim2.new(0, 0, 0, 70), BackgroundColor3 = UI.Colors.Panel2, Text = "", PlaceholderText = "TAPE TON CODE ICI", PlaceholderColor3 = UI.Colors.Muted, TextColor3 = UI.Colors.Text, Font = UI.Font, TextSize = 22, ClearTextOnFocus = false, ZIndex = 23, Parent = body }, { UI.corner(10), UI.stroke(UI.Colors.Accent2, 2), UI.padding(10, 4) })
	local function submit()
		local code = box.Text
		if #code == 0 then
			return
		end
		local result = ctx.request("RedeemCode", { Code = code })
		if result.ok then
			box.Text = ""
		end
	end
	UI.button({ Text = "✅ Valider", Color = UI.Colors.Green, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.new(0, 0, 0, 128), ZIndex = 24, Parent = body, OnClick = submit })
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
end

return CodesController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">CoffinController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Crypte : liste des cercueils, probabilites affichees, ouverture et animation de resultat.
local CoffinController = {}

function CoffinController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local CoffinData = ctx.CoffinData
	local MonsterData = ctx.MonsterData
	local Rarity = ctx.Rarity
	local GachaMath = ctx.GachaMath
	local MonsterBuilder = ctx.MonsterBuilder

	local window = UI.window("Coffins", "La Crypte : cercueils", { Icon = "⚰️" })
	local body = window.Body
	local selected = "wooden"
	local busy = false

	local listFrame = UI.scroll(body, { Size = UDim2.new(0.36, -6, 1, 0) })
	local detail = UI.new("Frame", { Name = "Detail", Size = UDim2.new(0.64, -6, 1, 0), Position = UDim2.new(0.36, 6, 0, 0), BackgroundColor3 = UI.Colors.Panel, ZIndex = 22, Parent = body }, { UI.corner(12), UI.padding(12, 10) })
	local title = UI.label({ Text = "", Font = UI.Font, TextSize = 26, TextScaled = true, Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23, Parent = detail })
	UI.new("UITextSizeConstraint", { MaxTextSize = 28, Parent = title })
	local subtitle = UI.label({ Text = "", TextSize = 15, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UI.Colors.Muted, ZIndex = 23, Parent = detail })
	local luckLabel = UI.label({ Text = "", TextSize = 14, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 76), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Green, ZIndex = 23, Parent = detail })
	local contents = UI.scroll(detail, { Size = UDim2.new(1, 0, 1, -170), Position = UDim2.new(0, 0, 0, 100), Background = UI.Colors.Bg })
	local buttonRow = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 56), Position = UDim2.new(0, 0, 1, -58), BackgroundTransparency = 1, ZIndex = 23, Parent = detail })
	local openOne = UI.button({ Text = "Ouvrir x1", Color = UI.Colors.Green, Size = UDim2.new(0.48, 0, 1, 0), ZIndex = 24, Parent = buttonRow })
	local openThree = UI.button({ Text = "Ouvrir x3", Color = UI.Colors.Accent2, Size = UDim2.new(0.48, 0, 1, 0), Position = UDim2.new(0.52, 0, 0, 0), ZIndex = 24, Parent = buttonRow })

	local function rarityText(def)
		local r, g, b = Rarity.color(def.Rarity)
		return string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, Rarity.label(def.Rarity))
	end

	local function coffinLocked(coffin)
		local rebirths = tonumber(ctx.attr("Rebirths")) or 0
		return rebirths < (coffin.RebirthRequired or 0)
	end

	local function nightmareCount()
		return tonumber(ctx.attr("NightmareCoffins")) or 0
	end

	local function buildList()
		UI.clear(listFrame)
		local order = 0
		for _, coffin in ipairs(CoffinData.List) do
			order += 1
			local locked = coffinLocked(coffin)
			local color = Color3.fromRGB(coffin.Color[1], coffin.Color[2], coffin.Color[3])
			local button = UI.new("TextButton", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = selected == coffin.Id and UI.Colors.Panel2 or UI.Colors.Bg, Text = "", AutoButtonColor = true, LayoutOrder = order, ZIndex = 23, Parent = listFrame }, { UI.corner(10), UI.stroke(selected == coffin.Id and UI.Colors.Accent or Color3.fromRGB(0, 0, 0), 2, 0.3), UI.padding(8, 6) })
			UI.new("Frame", { Size = UDim2.fromOffset(34, 48), BackgroundColor3 = color, ZIndex = 24, Parent = button }, { UI.corner(6), UI.stroke(Color3.fromRGB(0, 0, 0), 1, 0.4) })
			UI.label({ Text = coffin.Name, Font = UI.Font, TextSize = 16, Size = UDim2.new(1, -44, 0, 22), Position = UDim2.new(0, 44, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24, Parent = button })
			local info
			if coffin.EventOnly then
				info = "🎟️ " .. nightmareCount() .. " ticket(s)"
			elseif locked then
				info = "🔒 Rebirth " .. coffin.RebirthRequired
			else
				info = "🪙 " .. Economy.format(coffin.Cost)
			end
			UI.label({ Text = info, TextSize = 14, Size = UDim2.new(1, -44, 0, 20), Position = UDim2.new(0, 44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = locked and UI.Colors.Red or UI.Colors.Gold, ZIndex = 24, Parent = button })
			button.MouseButton1Click:Connect(function()
				selected = coffin.Id
				buildList()
				CoffinController.refreshDetail()
			end)
		end
	end

	function CoffinController.refreshDetail()
		local coffin = CoffinData.get(selected)
		if not coffin then
			return
		end
		local luck = tonumber(ctx.attr("Luck")) or 1
		local locked = coffinLocked(coffin)
		title.Text = coffin.Name
		if coffin.EventOnly then
			subtitle.Text = "Non achetable. Gagne des tickets lors des raids de Minuit, au jour 7 de ta série quotidienne, dans le Passe Spooky et les récompenses de temps de jeu."
		elseif locked then
			subtitle.Text = "🔒 Se débloque au rebirth " .. coffin.RebirthRequired .. ". Continue à progresser !"
		else
			subtitle.Text = "Coût : " .. Economy.format(coffin.Cost) .. " coins. Les monstres obtenus sont placés automatiquement s'il reste une salle libre."
		end
		luckLabel.Text = luck > 1 and ("🍀 Chance actuelle : x" .. luck .. " (probabilités des raretés Rare et + multipliées)") or "🍀 Chance : x1 (les boosts et le pass Chance augmentent les raretés Rare et +)"
		UI.clear(contents)
		local entries = {}
		for _, item in ipairs(coffin.Contents) do
			local def = MonsterData.get(item.Id)
			table.insert(entries, { Id = item.Id, Weight = item.Weight, Rank = Rarity.rank(def.Rarity) })
		end
		local weighted = GachaMath.weighted(entries, luck)
		for index, entry in ipairs(weighted) do
			local def = MonsterData.get(entry.Id)
			local discovered = ctx.state and ctx.state.Index and ctx.state.Index[entry.Id]
			local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = UI.Colors.Panel2, LayoutOrder = index, ZIndex = 23, Parent = contents }, { UI.corner(8), UI.padding(8, 4) })
			UI.label({ Text = (discovered and "" or "❔ ") .. def.Name .. "  <font size=\"12\">" .. rarityText(def) .. "</font>", TextSize = 15, Size = UDim2.new(0.6, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24, Parent = row })
			UI.label({ Text = "⚡ " .. Economy.format(def.Power) .. "/s", TextSize = 14, Size = UDim2.new(0.2, 0, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), TextColor3 = UI.Colors.Green, ZIndex = 24, Parent = row })
			UI.label({ Text = GachaMath.formatChance(entry.Chance), Font = UI.Font, TextSize = 15, Size = UDim2.new(0.2, 0, 1, 0), Position = UDim2.new(0.8, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UI.Colors.Gold, ZIndex = 24, Parent = row })
		end
		local hasTriple = ctx.ownsPass("TripleHatch")
		if coffin.EventOnly then
			openOne.Text = "Ouvrir x1 (1 ticket)"
			openThree.Text = hasTriple and "Ouvrir x3 (3 tickets)" or "🔒 x3 : pass Triple"
			UI.setEnabled(openOne, nightmareCount() >= 1)
		else
			openOne.Text = "Ouvrir x1 (" .. Economy.format(coffin.Cost) .. ")"
			openThree.Text = hasTriple and ("Ouvrir x3 (" .. Economy.format(coffin.Cost * 3) .. ")") or "🔒 x3 : pass Triple"
			UI.setEnabled(openOne, not locked)
		end
		UI.setEnabled(openThree, not locked)
	end

	-- Animation d'ouverture
	local function showResults(coffin, results)
		local overlay = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 70, Parent = UI.modalLayer() })
		local coffinFrame = UI.new("Frame", { Size = UDim2.fromOffset(120, 200), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(coffin.Color[1], coffin.Color[2], coffin.Color[3]), ZIndex = 71, Parent = overlay }, { UI.corner(14), UI.stroke(Color3.fromRGB(coffin.Accent[1], coffin.Accent[2], coffin.Accent[3]), 4) })
		UI.label({ Text = "⚰️", TextSize = 64, TextScaled = true, ZIndex = 72, Parent = coffinFrame })
		for i = 1, 6 do
			UI.tween(coffinFrame, { Rotation = (i % 2 == 0 and 8 or -8) }, 0.09)
			task.wait(0.1)
		end
		UI.tween(coffinFrame, { Rotation = 0, Size = UDim2.fromOffset(150, 240) }, 0.15)
		task.wait(0.2)
		coffinFrame:Destroy()
		local container = UI.new("Frame", { Size = UDim2.fromScale(0.9, 0.7), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 71, Parent = overlay }, {
			UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 14) }),
		})
		for _, result in ipairs(results) do
			local def = MonsterData.get(result.Id)
			local r, g, b = Rarity.color(def.Rarity)
			local card = UI.new("Frame", { Size = UDim2.new(0.28, 0, 1, 0), BackgroundColor3 = UI.Colors.Panel, ZIndex = 72, Parent = container }, { UI.corner(16), UI.stroke(Color3.fromRGB(r, g, b), 4), UI.padding(10, 8), UI.new("UISizeConstraint", { MaxSize = Vector2.new(300, 420) }) })
			local viewport = UI.new("ViewportFrame", { Size = UDim2.new(1, 0, 0.55, 0), BackgroundTransparency = 1, Ambient = Color3.fromRGB(200, 200, 220), LightColor = Color3.fromRGB(255, 255, 255), LightDirection = Vector3.new(-1, -1, -1), ZIndex = 73, Parent = card })
			local model = MonsterBuilder.build(def, CFrame.new())
			model.Parent = viewport
			local height = MonsterBuilder.height(def)
			local camera = Instance.new("Camera")
			camera.FieldOfView = 50
			camera.CFrame = CFrame.lookAt(Vector3.new(2.5, height * 0.55, -height * 1.8 - 2), Vector3.new(0, height * 0.45, 0))
			camera.Parent = viewport
			viewport.CurrentCamera = camera
			task.spawn(function()
				local t = 0
				while viewport.Parent do
					t += 0.03
					model:PivotTo(CFrame.new(0, math.sin(t * 3) * 0.15, 0) * CFrame.Angles(0, math.sin(t) * 0.5, 0))
					task.wait(0.03)
				end
			end)
			UI.label({ Text = def.Name, Font = UI.Font, TextSize = 22, TextScaled = true, Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.fromScale(0, 0.56), ZIndex = 73, Parent = card })
			UI.label({ Text = rarityText(def) .. "  ⚡ " .. Economy.format(def.Power) .. "/s", TextSize = 16, TextScaled = true, Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.fromScale(0, 0.68), ZIndex = 73, Parent = card })
			local status = result.New and "✨ NOUVEAU ! Ajouté au Bestiaire" or (result.Placed and "Placé dans une salle" or "Dans ton inventaire (salles pleines)")
			UI.label({ Text = status, TextSize = 14, TextScaled = true, Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.fromScale(0, 0.8), TextColor3 = result.New and UI.Colors.Gold or UI.Colors.Muted, ZIndex = 73, Parent = card })
			card.Size = UDim2.new(0.28, 0, 0.9, 0)
			UI.tween(card, { Size = UDim2.new(0.28, 0, 1, 0) }, 0.2, Enum.EasingStyle.Back)
		end
		local buttons = UI.new("Frame", { Size = UDim2.fromOffset(420, 50), Position = UDim2.fromScale(0.5, 0.88), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 72, Parent = overlay })
		UI.button({ Text = "Continuer", Color = Color3.fromRGB(90, 85, 110), Size = UDim2.new(0.48, 0, 1, 0), ZIndex = 73, Parent = buttons, OnClick = function()
			overlay:Destroy()
		end })
		UI.button({ Text = "Ouvrir encore x" .. #results, Color = UI.Colors.Green, Size = UDim2.new(0.48, 0, 1, 0), Position = UDim2.new(0.52, 0, 0, 0), ZIndex = 73, Parent = buttons, OnClick = function()
			overlay:Destroy()
			CoffinController.open(coffin.Id, #results)
		end })
	end

	function CoffinController.open(coffinId, count)
		if busy then
			return
		end
		local coffin = CoffinData.get(coffinId)
		if not coffin then
			return
		end
		if count == 3 and not ctx.ownsPass("TripleHatch") then
			UI.toast("Le pass Triple Cercueil permet d'ouvrir 3 cercueils d'un coup !", "info")
			ctx.prompt("Pass", "TripleHatch")
			return
		end
		busy = true
		local result
		if coffin.EventOnly then
			result = ctx.request("OpenNightmare", { Count = count })
		else
			result = ctx.request("BuyCoffin", { CoffinId = coffinId, Count = count })
		end
		busy = false
		if result.ok and result.data and result.data.Results then
			task.spawn(showResults, coffin, result.data.Results)
		end
	end

	openOne.MouseButton1Click:Connect(function()
		CoffinController.open(selected, 1)
	end)
	openThree.MouseButton1Click:Connect(function()
		CoffinController.open(selected, 3)
	end)

	window.OnOpen = function(context)
		if context and context.Coffin then
			selected = context.Coffin
		end
		buildList()
		CoffinController.refreshDetail()
	end
	ctx.onState(function()
		if window.Frame.Visible then
			buildList()
			CoffinController.refreshDetail()
		end
	end)
	ctx.onAttr("Luck", function()
		if window.Frame.Visible then
			CoffinController.refreshDetail()
		end
	end)
	ctx.onAttr("NightmareCoffins", function()
		if window.Frame.Visible then
			buildList()
			CoffinController.refreshDetail()
		end
	end)
end

return CoffinController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">DailyController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Recompense quotidienne avec serie de 7 jours.
local DailyController = {}

function DailyController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local DailyRewards = ctx.DailyRewards

	local window = UI.window("Daily", "Récompense quotidienne", { Icon = "🎁", Size = UDim2.fromScale(0.62, 0.66), MaxSize = Vector2.new(820, 520) })
	local body = window.Body
	local streakLabel = UI.label({ Text = "", Font = UI.Font, TextSize = 22, TextScaled = true, Size = UDim2.new(1, 0, 0, 30), ZIndex = 23, Parent = body })
	UI.new("UITextSizeConstraint", { MaxTextSize = 24, Parent = streakLabel })
	local grid = UI.new("Frame", { Size = UDim2.new(1, 0, 1, -110), Position = UDim2.new(0, 0, 0, 36), BackgroundTransparency = 1, ZIndex = 22, Parent = body }, {
		UI.new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0.5, -8), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local claimButton = UI.button({ Text = "Récupérer", Color = UI.Colors.Green, Size = UDim2.new(0.6, 0, 0, 50), Position = UDim2.new(0.2, 0, 1, -54), ZIndex = 24, MaxTextSize = 22, Parent = body, OnClick = function()
		ctx.request("ClaimDaily")
	end })

	local function refresh()
		local lastClaim = tonumber(ctx.attr("DailyLastClaim")) or 0
		local streak = tonumber(ctx.attr("DailyStreak")) or 0
		local now = os.time()
		local eval = DailyRewards.evaluate(lastClaim, streak, now)
		local todayDay = DailyRewards.dayForStreak(eval.CanClaim and eval.Streak or streak)
		local effectiveStreak = eval.CanClaim and eval.Streak or streak
		streakLabel.Text = "🔥 Série : " .. effectiveStreak .. " jour(s)" .. (eval.Reset and "  (série perdue, on recommence !)" or "")
		UI.clear(grid)
		for _, reward in ipairs(DailyRewards.Cycle) do
			local state
			if eval.CanClaim then
				state = reward.Day == todayDay and "today" or (reward.Day < todayDay and "done" or "locked")
			else
				local currentDay = DailyRewards.dayForStreak(streak)
				state = reward.Day <= currentDay and "done" or "locked"
			end
			local color = state == "today" and Color3.fromRGB(60, 140, 80) or (state == "done" and Color3.fromRGB(50, 45, 70) or UI.Colors.Panel2)
			local card = UI.new("Frame", { BackgroundColor3 = color, LayoutOrder = reward.Day, ZIndex = 23, Parent = grid }, { UI.corner(12), UI.stroke(state == "today" and UI.Colors.Gold or Color3.fromRGB(0, 0, 0), state == "today" and 3 or 1, 0.3), UI.padding(8, 6) })
			UI.label({ Text = "Jour " .. reward.Day .. (reward.Day == 7 and " 👑" or ""), Font = UI.Font, TextSize = 16, TextScaled = true, Size = UDim2.new(1, 0, 0.3, 0), ZIndex = 24, Parent = card })
			UI.label({ Text = reward.Label, TextSize = 14, TextScaled = true, Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.fromScale(0, 0.3), TextColor3 = state == "done" and UI.Colors.Muted or UI.Colors.Text, ZIndex = 24, Parent = card })
			UI.label({ Text = state == "done" and "✅" or (state == "today" and "🎁 AUJOURD'HUI" or "🔒"), TextSize = 13, TextScaled = true, Size = UDim2.new(1, 0, 0.22, 0), Position = UDim2.fromScale(0, 0.76), ZIndex = 24, Parent = card })
		end
		if eval.CanClaim then
			claimButton.Text = "🎁 Récupérer (jour " .. todayDay .. ")"
			UI.setEnabled(claimButton, true)
		else
			claimButton.Text = "⏳ Prochaine dans " .. Economy.formatTime(eval.SecondsUntil)
			UI.setEnabled(claimButton, false)
		end
	end

	window.OnOpen = refresh
	ctx.onAttr("DailyLastClaim", function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if window.Frame.Visible then
				refresh()
			end
		end
	end)
end

return DailyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- HUD : coins, revenus, menus, boosts, offres, popups.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local HudController = {}

function HudController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local Config = ctx.Config
	local Offers = ctx.Offers
	local screen = UI.screen()

	-- Panneau coins (haut gauche)
	local topLeft = UI.new("Frame", { Name = "TopLeft", Size = UDim2.fromOffset(300, 92), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = UI.Colors.Bg, BackgroundTransparency = 0.15, ZIndex = 5, Parent = screen }, { UI.corner(16), UI.stroke(UI.Colors.Accent2, 2, 0.3), UI.padding(12, 8) })
	local coinsLabel = UI.label({ Name = "Coins", Text = "🪙 0", Font = UI.Font, TextSize = 34, TextScaled = true, Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Gold, ZIndex = 6, Parent = topLeft })
	UI.new("UITextSizeConstraint", { MaxTextSize = 36, MinTextSize = 16, Parent = coinsLabel })
	local incomeLabel = UI.label({ Name = "Income", Text = "+0/s", TextSize = 16, Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 0, 0, 42), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Green, ZIndex = 6, Parent = topLeft })
	local multLabel = UI.label({ Name = "Mult", Text = "x1", TextSize = 16, Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0.5, 0, 0, 42), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UI.Colors.Accent2, ZIndex = 6, Parent = topLeft })
	local rebirthLabel = UI.label({ Name = "Rebirth", Text = "♻️ Rebirth 0", TextSize = 14, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 62), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Muted, ZIndex = 6, Parent = topLeft })

	-- Boosts actifs
	local boosts = UI.new("Frame", { Name = "Boosts", Size = UDim2.fromOffset(300, 30), Position = UDim2.fromOffset(12, 110), BackgroundTransparency = 1, ZIndex = 5, Parent = screen }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function chip(name, color)
		local frame = UI.new("Frame", { Name = name, Size = UDim2.fromOffset(96, 28), BackgroundColor3 = color, Visible = false, ZIndex = 6, Parent = boosts }, { UI.corner(8) })
		local label = UI.label({ Text = "", Font = UI.Font, TextSize = 14, TextScaled = true, ZIndex = 7, Parent = frame })
		UI.new("UITextSizeConstraint", { MaxTextSize = 15, Parent = label })
		return frame, label
	end
	local coinsChip, coinsChipLabel = chip("CoinsBoost", Color3.fromRGB(200, 120, 20))
	local luckChip, luckChipLabel = chip("LuckBoost", Color3.fromRGB(40, 140, 70))
	local serverChip, serverChipLabel = chip("ServerLuck", Color3.fromRGB(30, 110, 160))

	-- Menu gauche
	local menu = UI.new("Frame", { Name = "Menu", Size = UDim2.fromOffset(74, 460), Position = UDim2.new(0, 12, 0.5, -200), BackgroundTransparency = 1, ZIndex = 5, Parent = screen }, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local menuItems = {
		{ Key = "Shop", Icon = "🛒", Text = "Boutique", Color = UI.Colors.Robux },
		{ Key = "Coffins", Icon = "⚰️", Text = "Cercueils", Color = Color3.fromRGB(120, 70, 40) },
		{ Key = "Inventory", Icon = "👻", Text = "Monstres", Color = UI.Colors.Accent2 },
		{ Key = "Rebirth", Icon = "♻️", Text = "Rebirth", Color = Color3.fromRGB(110, 60, 190) },
		{ Key = "Daily", Icon = "🎁", Text = "Quotidien", Color = Color3.fromRGB(200, 60, 90) },
		{ Key = "Index", Icon = "📖", Text = "Bestiaire", Color = Color3.fromRGB(50, 120, 200) },
		{ Key = "Season", Icon = "🎃", Text = "Passe", Color = UI.Colors.Accent },
		{ Key = "Codes", Icon = "🔑", Text = "Codes", Color = Color3.fromRGB(80, 80, 110) },
	}
	for index, item in ipairs(menuItems) do
		local button = UI.button({ Name = item.Key, Text = item.Icon, Color = item.Color, Size = UDim2.fromOffset(52, 52), LayoutOrder = index, Radius = 14, ZIndex = 6, MaxTextSize = 28, Parent = menu, OnClick = function()
			UI.toggle(item.Key)
		end })
		UI.label({ Text = item.Text, Font = UI.Font, TextSize = 11, Size = UDim2.new(0, 70, 0, 14), Position = UDim2.new(0, -9, 1, -2), TextStrokeTransparency = 0.3, ZIndex = 7, Parent = button })
	end

	-- Boutons bas droite
	local bottomRight = UI.new("Frame", { Name = "BottomRight", Size = UDim2.fromOffset(160, 150), Position = UDim2.new(1, -12, 1, -12), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1, ZIndex = 5, Parent = screen }, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Bottom }),
	})
	local playtimeButton = UI.button({ Name = "Playtime", Text = "⏱️ Récompenses", Color = Color3.fromRGB(60, 140, 90), Size = UDim2.fromOffset(160, 42), LayoutOrder = 1, ZIndex = 6, MaxTextSize = 18, Parent = bottomRight, OnClick = function()
		UI.toggle("Playtime")
	end })
	UI.button({ Name = "Home", Text = "🏚️ Mon manoir", Color = Color3.fromRGB(120, 70, 40), Size = UDim2.fromOffset(160, 42), LayoutOrder = 2, ZIndex = 6, MaxTextSize = 18, Parent = bottomRight, OnClick = function()
		ctx.requestSilent("TeleportHome")
	end })
	UI.button({ Name = "Hub", Text = "🏛️ Place centrale", Color = Color3.fromRGB(70, 70, 110), Size = UDim2.fromOffset(160, 42), LayoutOrder = 3, ZIndex = 6, MaxTextSize = 18, Parent = bottomRight, OnClick = function()
		ctx.requestSilent("TeleportHub")
	end })

	-- Badges d'offres (haut droite)
	local offersFrame = UI.new("Frame", { Name = "Offers", Size = UDim2.fromOffset(190, 120), Position = UDim2.new(1, -12, 0, 12), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 5, Parent = screen }, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }),
	})
	local starterBadge = UI.button({ Name = "Starter", Text = "🎁 PACK DÉMARRAGE\n00:00:00", Color = Color3.fromRGB(220, 60, 100), Size = UDim2.fromOffset(190, 50), LayoutOrder = 1, ZIndex = 6, MaxTextSize = 16, Parent = offersFrame, OnClick = function()
		UI.open("Shop", { Tab = "Offers" })
	end })
	starterBadge.Visible = false
	local flashBadge = UI.button({ Name = "Flash", Text = "⚡ OFFRE FLASH\n00:00:00", Color = Color3.fromRGB(200, 120, 20), Size = UDim2.fromOffset(190, 50), LayoutOrder = 2, ZIndex = 6, MaxTextSize = 16, Parent = offersFrame, OnClick = function()
		UI.open("Shop", { Tab = "Offers" })
	end })

	-- Popup 3D
	function ctx.popup3D(position, text, color)
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.CFrame = CFrame.new(position + Vector3.new(math.random(-10, 10) / 10, 2, math.random(-10, 10) / 10))
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 50)
		gui.AlwaysOnTop = true
		gui.StudsOffset = Vector3.new(0, 0, 0)
		local label = UI.label({ Text = text, Font = UI.Font, TextSize = 26, TextScaled = true, TextColor3 = color or UI.Colors.Gold, TextStrokeTransparency = 0.2, Parent = gui })
		gui.Parent = part
		part.Parent = workspace
		UI.tween(gui, { StudsOffset = Vector3.new(0, 4, 0) }, 1.0)
		task.delay(0.6, function()
			UI.tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.4)
		end)
		Debris:AddItem(part, 1.2)
	end

	-- Popup de collecte (2D)
	local function collectPopup(amount)
		local label = UI.label({ Text = "+" .. Economy.format(amount) .. " 🪙", Font = UI.Font, TextSize = 40, TextScaled = true, TextColor3 = UI.Colors.Gold, TextStrokeTransparency = 0.2, Size = UDim2.fromOffset(300, 60), Position = UDim2.fromScale(0.5, 0.55), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 40, Parent = screen })
		UI.tween(label, { Position = UDim2.fromScale(0.5, 0.35) }, 1.2)
		task.delay(0.7, function()
			UI.tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
		end)
		Debris:AddItem(label, 1.3)
	end

	ctx.on("Collected", function(payload)
		collectPopup(payload.Amount)
	end)
	ctx.on("ScarePopup", function(payload)
		ctx.popup3D(payload.Position, "BOO ! +" .. Economy.format(payload.Amount) .. " 🪙", UI.Colors.Gold)
	end)
	ctx.on("RebirthDone", function(payload)
		UI.toast("♻️ Rebirth " .. payload.Rebirths .. " ! Tes gains sont maintenant x" .. payload.Multiplier .. ". Nouvelles salles et cercueils débloqués !", "rebirth", 7)
	end)

	-- Compteur anime de coins
	local displayed = 0
	local target = 0
	ctx.onAttr("Coins", function(value)
		target = tonumber(value) or 0
	end)
	ctx.onAttr("Income", function(value)
		incomeLabel.Text = "+" .. Economy.format(tonumber(value) or 0) .. "/s"
	end)
	ctx.onAttr("Multiplier", function(value)
		local mult = tonumber(value) or 1
		multLabel.Text = "x" .. string.format(mult % 1 == 0 and "%d" or "%.2f", mult)
	end)
	ctx.onAttr("Rebirths", function(value)
		rebirthLabel.Text = "♻️ Rebirth " .. tostring(value or 0)
	end)

	local starterConfigured = ctx.MonetizationIds.Products.StarterPack.Id > 0
	local lastSecond = 0
	RunService.RenderStepped:Connect(function(dt)
		if math.abs(target - displayed) > 0.5 then
			displayed += (target - displayed) * math.min(1, dt * 8)
			if math.abs(target - displayed) < 1 then
				displayed = target
			end
			coinsLabel.Text = "🪙 " .. Economy.format(displayed)
		end
		local now = os.time()
		if now ~= lastSecond then
			lastSecond = now
			local coinsEnd = tonumber(ctx.attr("CoinsBoostEnd")) or 0
			local luckEnd = tonumber(ctx.attr("LuckBoostEnd")) or 0
			local serverEnd = tonumber(ReplicatedStorage:GetAttribute("ServerLuckEnd")) or 0
			coinsChip.Visible = coinsEnd > now
			luckChip.Visible = luckEnd > now
			serverChip.Visible = serverEnd > now
			if coinsChip.Visible then
				coinsChipLabel.Text = "⚡2x " .. Economy.formatTime(coinsEnd - now)
			end
			if luckChip.Visible then
				luckChipLabel.Text = "🍀2x " .. Economy.formatTime(luckEnd - now)
			end
			if serverChip.Visible then
				serverChipLabel.Text = "🌐🍀 " .. Economy.formatTime(serverEnd - now)
			end
			local restricted = ctx.attr("PaidRandomRestricted") == true
			local remaining = Offers.starterRemaining(tonumber(ctx.attr("StarterFirstJoin")) or 0, ctx.attr("StarterPurchased") == true, now)
			starterBadge.Visible = starterConfigured and not restricted and remaining > 0 and ctx.attr("DataLoaded") == true
			if starterBadge.Visible then
				starterBadge.Text = "🎁 PACK DÉMARRAGE " .. ctx.MonetizationIds.Products.StarterPack.Price .. " R$\n⏳ " .. Economy.formatTime(remaining)
			end
			local _, deal, rotationLeft = Offers.getFlashDeal(now)
			local dealConfigured = ctx.MonetizationIds.Products[deal.Key].Id > 0
			flashBadge.Visible = dealConfigured and not (restricted and deal.Key ~= "FlashRebirthRush")
			if flashBadge.Visible then
				flashBadge.Text = "⚡ " .. string.upper(deal.Title) .. "\n⏳ " .. Economy.formatTime(rotationLeft)
			end
			-- Prochaine recompense de temps de jeu
			local sessionStart = tonumber(ctx.attr("SessionStart")) or now
			local elapsed = now - sessionStart
			local claimed = ctx.state and ctx.state.Playtime or {}
			local nextText = nil
			for index, entry in ipairs(Config.Playtime) do
				if not claimed[index] then
					local left = entry.Minutes * 60 - elapsed
					if left <= 0 then
						nextText = "⏱️ RÉCOMPENSE PRÊTE !"
					else
						nextText = "⏱️ Bonus dans " .. Economy.formatTime(left)
					end
					break
				end
			end
			playtimeButton.Text = nextText or "⏱️ Récompenses"
			playtimeButton.BackgroundColor3 = (nextText and string.find(nextText, "PRÊTE")) and UI.Colors.Green or Color3.fromRGB(60, 140, 90)
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">IndexController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Bestiaire : collection des monstres decouverts (teasing des monstres verrouilles).
local IndexController = {}

function IndexController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local MonsterData = ctx.MonsterData
	local CoffinData = ctx.CoffinData
	local Rarity = ctx.Rarity
	local Config = ctx.Config

	local window = UI.window("Index", "Bestiaire", { Icon = "📖" })
	local body = window.Body
	local header = UI.label({ Text = "", Font = UI.Font, TextSize = 20, TextScaled = true, Size = UDim2.new(1, 0, 0, 34), ZIndex = 23, Parent = body })
	UI.new("UITextSizeConstraint", { MaxTextSize = 22, Parent = header })
	local grid = UI.scroll(body, { Size = UDim2.new(1, 0, 1, -40), Position = UDim2.new(0, 0, 0, 40), Grid = true, CellSize = UDim2.fromOffset(150, 110) })

	local function sourceOf(def)
		local coffinId = CoffinData.CoffinOfMonster[def.Id]
		if coffinId then
			return CoffinData.get(coffinId).Name
		end
		return def.Exclusive or "Exclusif"
	end

	local function refresh()
		local state = ctx.state
		if not state then
			return
		end
		local discovered = 0
		for _ in pairs(state.Index or {}) do
			discovered += 1
		end
		local total = #MonsterData.List
		header.Text = string.format("📖 %d / %d monstres découverts  ·  Bonus : +%d%% coins", discovered, total, math.floor(discovered * Config.Income.IndexBonusPerMonster * 100 + 0.5))
		UI.clear(grid)
		for index, def in ipairs(MonsterData.List) do
			local known = state.Index and state.Index[def.Id]
			local r, g, b = Rarity.color(def.Rarity)
			local rarityColor = Color3.fromRGB(r, g, b)
			local card = UI.new("Frame", { BackgroundColor3 = known and UI.Colors.Panel2 or Color3.fromRGB(20, 16, 34), LayoutOrder = index, ZIndex = 23, Parent = grid }, { UI.corner(10), UI.stroke(known and rarityColor or Color3.fromRGB(60, 55, 80), 2, 0.2), UI.padding(8, 6) })
			local face = UI.new("Frame", { Size = UDim2.fromOffset(32, 32), BackgroundColor3 = known and Color3.fromRGB(def.Visual.Color[1], def.Visual.Color[2], def.Visual.Color[3]) or Color3.fromRGB(40, 35, 60), ZIndex = 24, Parent = card }, { UI.corner(16) })
			UI.label({ Text = known and "👀" or "❔", TextSize = 16, ZIndex = 25, Parent = face })
			UI.label({ Text = known and def.Name or "???", Font = UI.Font, TextSize = 14, TextScaled = true, Size = UDim2.new(1, -38, 0, 20), Position = UDim2.new(0, 38, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = known and UI.Colors.Text or UI.Colors.Muted, ZIndex = 24, Parent = card })
			UI.label({ Text = Rarity.label(def.Rarity), TextSize = 12, Size = UDim2.new(1, -38, 0, 16), Position = UDim2.new(0, 38, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarityColor, ZIndex = 24, Parent = card })
			UI.label({ Text = "⚡ " .. Economy.format(def.Power) .. "/s", TextSize = 12, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, 42), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Green, ZIndex = 24, Parent = card })
			UI.label({ Text = "📦 " .. sourceOf(def), TextSize = 11, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 60), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UI.Colors.Muted, ZIndex = 24, Parent = card })
		end
	end

	window.OnOpen = refresh
	ctx.onState(function()
		if window.Frame.Visible then
			refresh()
		end
	end)
end

return IndexController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Inventaire : placement, retrait, vente, auto-placement, achat de salles.
local InventoryController = {}

function InventoryController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local MonsterData = ctx.MonsterData
	local CoffinData = ctx.CoffinData
	local Rarity = ctx.Rarity

	local window = UI.window("Inventory", "Mes monstres", { Icon = "👻" })
	local body = window.Body
	local header = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = UI.Colors.Panel, ZIndex = 22, Parent = body }, { UI.corner(12), UI.padding(10, 8) })
	local info = UI.label({ Text = "", Font = UI.Font, TextSize = 18, Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23, Parent = header })
	local actions = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 30), BackgroundTransparency = 1, ZIndex = 23, Parent = header }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	UI.button({ Text = "⭐ Auto-placer les meilleurs", Color = UI.Colors.Accent2, Size = UDim2.new(0.34, -8, 1, 0), LayoutOrder = 1, ZIndex = 24, MaxTextSize = 16, Parent = actions, OnClick = function()
		ctx.request("AutoEquip")
	end })
	UI.button({ Text = "💸 Vendre non-placés (≤ Rare)", Color = Color3.fromRGB(160, 70, 60), Size = UDim2.new(0.33, -8, 1, 0), LayoutOrder = 2, ZIndex = 24, MaxTextSize = 16, Parent = actions, OnClick = function()
		UI.confirm("Vendre les non-placés ?", "Tous tes monstres NON placés de rareté Commun, Peu commun ou Rare seront vendus. Les Epiques et plus rares, ainsi que les exclusifs, sont conservés.", function()
			ctx.request("SellUnplaced")
		end, "Vendre")
	end })
	local roomButton = UI.button({ Text = "🏚️ Acheter une salle", Color = UI.Colors.Green, Size = UDim2.new(0.33, -8, 1, 0), LayoutOrder = 3, ZIndex = 24, MaxTextSize = 16, Parent = actions, OnClick = function()
		ctx.request("BuyRoom")
	end })
	local grid = UI.scroll(body, { Size = UDim2.new(1, 0, 1, -92), Position = UDim2.new(0, 0, 0, 92), Grid = true, CellSize = UDim2.fromOffset(172, 150) })

	local function refresh()
		local state = ctx.state
		if not state then
			return
		end
		local rooms = state.Rooms or { Count = 0, Total = 18 }
		local placed = 0
		for _, entry in ipairs(state.Monsters) do
			if entry.Room > 0 then
				placed += 1
			end
		end
		info.Text = string.format("Salles : %d/%d occupées (%d au total)  ·  Monstres : %d/%d  ·  ⚡ %s/s", placed, rooms.Count, rooms.Total, #state.Monsters, ctx.Config.Inventory.MaxMonsters, Economy.format(tonumber(ctx.attr("Income")) or 0))
		if rooms.NextCost then
			roomButton.Text = "🏚️ Salle : " .. Economy.format(rooms.NextCost) .. " 🪙"
			UI.setEnabled(roomButton, true)
		else
			roomButton.Text = "🏚️ Salles : rebirth / passes"
			UI.setEnabled(roomButton, false)
		end
		UI.clear(grid)
		local sorted = table.clone(state.Monsters)
		table.sort(sorted, function(a, b)
			local pa = MonsterData.get(a.Id).Power
			local pb = MonsterData.get(b.Id).Power
			if (a.Room > 0) ~= (b.Room > 0) then
				return a.Room > 0
			end
			if pa == pb then
				return a.Uid < b.Uid
			end
			return pa > pb
		end)
		for index, entry in ipairs(sorted) do
			local def = MonsterData.get(entry.Id)
			local r, g, b = Rarity.color(def.Rarity)
			local rarityColor = Color3.fromRGB(r, g, b)
			local card = UI.new("Frame", { BackgroundColor3 = entry.Room > 0 and UI.Colors.Panel2 or UI.Colors.Bg, LayoutOrder = index, ZIndex = 23, Parent = grid }, { UI.corner(12), UI.stroke(rarityColor, 2, 0.2), UI.padding(8, 6) })
			local face = UI.new("Frame", { Size = UDim2.fromOffset(40, 40), BackgroundColor3 = Color3.fromRGB(def.Visual.Color[1], def.Visual.Color[2], def.Visual.Color[3]), ZIndex = 24, Parent = card }, { UI.corner(20), UI.stroke(rarityColor, 3) })
			UI.label({ Text = "👀", TextSize = 18, ZIndex = 25, Parent = face })
			UI.label({ Text = def.Name, Font = UI.Font, TextSize = 15, Size = UDim2.new(1, -46, 0, 20), Position = UDim2.new(0, 46, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true, ZIndex = 24, Parent = card })
			UI.label({ Text = Rarity.label(def.Rarity) .. "  ⚡" .. Economy.format(def.Power) .. "/s", TextSize = 12, Size = UDim2.new(1, -46, 0, 18), Position = UDim2.new(0, 46, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarityColor, ZIndex = 24, Parent = card })
			UI.label({ Text = entry.Room > 0 and ("🏚️ Salle " .. entry.Room) or "🎒 Inventaire", TextSize = 12, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 46), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = UI.Colors.Muted, ZIndex = 24, Parent = card })
			local mainButton = UI.button({
				Text = entry.Room > 0 and "Retirer" or "Placer",
				Color = entry.Room > 0 and Color3.fromRGB(110, 60, 190) or UI.Colors.Green,
				Size = UDim2.new(0.55, -4, 0, 34), Position = UDim2.new(0, 0, 1, -36), ZIndex = 24, MaxTextSize = 15, Parent = card,
				OnClick = function()
					ctx.request(entry.Room > 0 and "Unequip" or "Equip", { Uid = entry.Uid })
				end,
			})
			mainButton.Name = "Main"
			local sellValue = Economy.sellPrice(def.Rarity, CoffinData.referenceCost(entry.Id))
			local sellButton = UI.button({
				Text = "💸 " .. Economy.format(sellValue),
				Color = Color3.fromRGB(150, 70, 60),
				Size = UDim2.new(0.45, -4, 0, 34), Position = UDim2.new(0.55, 4, 1, -36), ZIndex = 24, MaxTextSize = 14, Parent = card,
				OnClick = function()
					if Rarity.rank(def.Rarity) >= Rarity.rank("Epic") then
						UI.confirm("Vendre " .. def.Name .. " ?", "Ce monstre est " .. Rarity.label(def.Rarity) .. ". Tu recevras " .. Economy.format(sellValue) .. " coins. Cette action est définitive.", function()
							ctx.request("Sell", { Uid = entry.Uid })
						end, "Vendre")
					else
						ctx.request("Sell", { Uid = entry.Uid })
					end
				end,
			})
			if def.Exclusive then
				UI.setEnabled(sellButton, false)
				sellButton.Text = "Exclusif"
			end
		end
		if #sorted == 0 then
			local empty = UI.new("Frame", { Size = UDim2.fromOffset(340, 120), BackgroundTransparency = 1, ZIndex = 23, Parent = grid })
			UI.label({ Text = "Aucun monstre pour l'instant.\nVa à la Crypte pour ouvrir ton premier cercueil !", TextSize = 16, TextColor3 = UI.Colors.Muted, ZIndex = 24, Parent = empty })
		end
	end

	window.OnOpen = refresh
	ctx.onState(function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	ctx.onAttr("Income", function()
		if window.Frame.Visible then
			refresh()
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">OffersController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Fenetre du pack de demarrage (affichee une fois par session tant que l'offre est active).
local OffersController = {}

function OffersController.init(ctx)
	local UI = ctx.UI
	local Config = ctx.Config
	local Economy = ctx.Economy
	local Offers = ctx.Offers
	local shown = false

	local function showStarter()
		if shown then
			return
		end
		shown = true
		local overlay = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, ZIndex = 60, Parent = UI.modalLayer() })
		local box = UI.new("Frame", { Size = UDim2.fromScale(0.5, 0.62), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(60, 25, 55), ZIndex = 61, Parent = overlay }, {
			UI.corner(20), UI.stroke(UI.Colors.Accent, 4), UI.padding(18, 14),
			UI.new("UISizeConstraint", { MaxSize = Vector2.new(560, 460), MinSize = Vector2.new(300, 300) }),
		})
		UI.label({ Text = "🎁 PACK DE DÉMARRAGE", Font = UI.Font, TextSize = 32, TextScaled = true, Size = UDim2.new(1, 0, 0.14, 0), TextColor3 = UI.Colors.Gold, ZIndex = 62, Parent = box })
		UI.label({ Text = "Offre unique pour les nouveaux hanteurs !", TextSize = 16, TextScaled = true, Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.fromScale(0, 0.14), TextColor3 = UI.Colors.Muted, ZIndex = 62, Parent = box })
		local contents = "🪙 " .. Economy.format(Config.StarterPack.Coins) .. " coins\n👻 Ghosty Doré (monstre EPIQUE exclusif, conservé au rebirth)\n⚡ 2x Coins pendant 30 min"
		UI.label({ Text = contents, TextSize = 18, TextScaled = true, Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.24), ZIndex = 62, Parent = box })
		local timer = UI.label({ Text = "", Font = UI.Font, TextSize = 18, TextScaled = true, Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.fromScale(0, 0.6), TextColor3 = UI.Colors.Red, ZIndex = 62, Parent = box })
		local price = ctx.MonetizationIds.Products.StarterPack.Price
		UI.label({ Text = "<s>Valeur R$ " .. Config.StarterPack.WorthRobux .. "</s>", TextSize = 16, TextScaled = true, Size = UDim2.new(1, 0, 0.07, 0), Position = UDim2.fromScale(0, 0.7), TextColor3 = UI.Colors.Muted, ZIndex = 62, Parent = box })
		UI.button({ Text = "ACHETER  R$ " .. price, Color = UI.Colors.Robux, Size = UDim2.new(0.6, 0, 0.13, 0), Position = UDim2.fromScale(0.2, 0.78), ZIndex = 62, MaxTextSize = 26, Parent = box, OnClick = function()
			ctx.prompt("Product", "StarterPack")
			overlay:Destroy()
		end })
		UI.button({ Text = "Plus tard", Color = Color3.fromRGB(90, 85, 110), Size = UDim2.new(0.3, 0, 0.09, 0), Position = UDim2.fromScale(0.35, 0.92), ZIndex = 62, MaxTextSize = 16, Parent = box, OnClick = function()
			overlay:Destroy()
		end })
		task.spawn(function()
			while overlay.Parent do
				local remaining = Offers.starterRemaining(tonumber(ctx.attr("StarterFirstJoin")) or 0, ctx.attr("StarterPurchased") == true, os.time())
				if remaining <= 0 then
					overlay:Destroy()
					break
				end
				timer.Text = "⏳ Expire dans " .. Economy.formatTime(remaining)
				task.wait(1)
			end
		end)
	end

	task.spawn(function()
		task.wait(Config.StarterPack.PopupDelay)
		while ctx.attr("DataLoaded") ~= true or ctx.state == nil do
			task.wait(1)
		end
		local configured = ctx.MonetizationIds.Products.StarterPack.Id > 0
		local remaining = Offers.starterRemaining(tonumber(ctx.attr("StarterFirstJoin")) or 0, ctx.attr("StarterPurchased") == true, os.time())
		if configured and remaining > 0 and not ctx.state.Restricted then
			showStarter()
		end
	end)
end

return OffersController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">PlaytimeController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Recompenses de temps de jeu (session).
local PlaytimeController = {}

function PlaytimeController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local Config = ctx.Config

	local window = UI.window("Playtime", "Récompenses de temps de jeu", { Icon = "⏱️", Size = UDim2.fromScale(0.5, 0.7), MaxSize = Vector2.new(640, 560) })
	local body = window.Body
	UI.label({ Text = "Reste connecté pour débloquer ces bonus (réinitialisés à chaque session).", TextSize = 14, Size = UDim2.new(1, 0, 0, 30), TextColor3 = UI.Colors.Muted, ZIndex = 23, Parent = body })
	local list = UI.scroll(body, { Size = UDim2.new(1, 0, 1, -36), Position = UDim2.new(0, 0, 0, 36) })

	local function describe(entry)
		if entry.Type == "Coins" then
			return "🪙 " .. Economy.format(entry.Amount) .. " coins (x rebirth)"
		elseif entry.Type == "CoinsBoost" then
			return "⚡ 2x Coins " .. entry.Minutes2 .. " min"
		elseif entry.Type == "LuckBoost" then
			return "🍀 2x Chance " .. entry.Minutes2 .. " min"
		elseif entry.Type == "NightmareCoffin" then
			return "⚰️ " .. entry.Amount .. " Cercueil Cauchemar"
		end
		return "?"
	end

	local function refresh()
		UI.clear(list)
		local now = os.time()
		local sessionStart = tonumber(ctx.attr("SessionStart")) or now
		local elapsed = now - sessionStart
		local claimed = ctx.state and ctx.state.Playtime or {}
		for index, entry in ipairs(Config.Playtime) do
			local done = claimed[index] == true
			local ready = elapsed >= entry.Minutes * 60
			local card = UI.card(list, { Size = UDim2.new(1, 0, 0, 62), LayoutOrder = index, Color = done and Color3.fromRGB(45, 40, 65) or UI.Colors.Panel2 })
			UI.label({ Text = "⏱️ " .. entry.Minutes .. " min", Font = UI.Font, TextSize = 18, Size = UDim2.new(0.25, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24, Parent = card })
			UI.label({ Text = describe(entry), TextSize = 15, Size = UDim2.new(0.45, 0, 1, 0), Position = UDim2.new(0.25, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24, Parent = card })
			local button = UI.button({ Text = done and "✅" or (ready and "Récupérer" or Economy.formatTime(entry.Minutes * 60 - elapsed)), Color = (ready and not done) and UI.Colors.Green or Color3.fromRGB(90, 85, 110), Size = UDim2.new(0.28, 0, 0, 40), Position = UDim2.new(0.72, 0, 0.5, -20), ZIndex = 24, MaxTextSize = 16, Parent = card, OnClick = function()
				ctx.request("ClaimPlaytime", { Index = index })
			end })
			UI.setEnabled(button, ready and not done)
		end
	end

	window.OnOpen = refresh
	ctx.onState(function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if window.Frame.Visible then
				refresh()
			end
		end
	end)
end

return PlaytimeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">RebirthController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Rebirth : progression, benefices et confirmation.
local RebirthController = {}

function RebirthController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local Config = ctx.Config
	local CoffinData = ctx.CoffinData

	local window = UI.window("Rebirth", "Autel de Rebirth", { Icon = "♻️", Size = UDim2.fromScale(0.55, 0.7), MaxSize = Vector2.new(700, 560) })
	local body = window.Body
	local current = UI.label({ Text = "", Font = UI.Font, TextSize = 24, TextScaled = true, Size = UDim2.new(1, 0, 0, 34), ZIndex = 23, Parent = body })
	UI.new("UITextSizeConstraint", { MaxTextSize = 26, Parent = current })
	local benefits = UI.label({ Text = "", TextSize = 16, Size = UDim2.new(1, 0, 0, 150), Position = UDim2.new(0, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 23, Parent = body })
	local bar = UI.progress(body, UI.Colors.Accent2, UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 0, 200))
	local rebirthButton = UI.button({ Text = "♻️ REBIRTH", Color = Color3.fromRGB(110, 60, 190), Size = UDim2.new(1, 0, 0, 54), Position = UDim2.new(0, 0, 0, 244), ZIndex = 24, MaxTextSize = 26, Parent = body, OnClick = function()
		UI.confirm("Faire un rebirth ?", "Tes coins et tes monstres issus des cercueils seront réinitialisés. Tu gardes : monstres exclusifs et Cauchemar, salles achetées, bestiaire, boosts et passes. Tu gagnes un multiplicateur permanent, une salle et de nouveaux cercueils.", function()
			ctx.request("Rebirth")
		end, "Rebirth !")
	end })
	local instant = UI.button({ Text = "⚡ Rebirth instantané  R$ " .. ctx.MonetizationIds.Products.InstantRebirth.Price, Color = UI.Colors.Robux, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.new(0, 0, 0, 306), ZIndex = 24, MaxTextSize = 18, Parent = body, OnClick = function()
		ctx.prompt("Product", "InstantRebirth")
	end })
	UI.setEnabled(instant, ctx.MonetizationIds.Products.InstantRebirth.Id > 0)

	local function nextUnlock(rebirths)
		local unlocks = {}
		for _, coffin in ipairs(CoffinData.List) do
			if coffin.RebirthRequired == rebirths + 1 then
				table.insert(unlocks, coffin.Name)
			end
		end
		return unlocks
	end

	local function refresh()
		local rebirths = tonumber(ctx.attr("Rebirths")) or 0
		local coins = tonumber(ctx.attr("Coins")) or 0
		local cost = Economy.rebirthCost(rebirths)
		current.Text = "Rebirth actuel : " .. rebirths .. "  (gains x" .. Economy.rebirthMultiplier(rebirths) .. ")"
		local lines = {
			"✅ Multiplicateur : x" .. Economy.rebirthMultiplier(rebirths) .. "  →  <b>x" .. Economy.rebirthMultiplier(rebirths + 1) .. "</b>",
		}
		if rebirths < Config.Plot.MaxRebirthRooms then
			table.insert(lines, "✅ +1 salle permanente dans ton manoir")
		end
		local unlocks = nextUnlock(rebirths)
		if #unlocks > 0 then
			table.insert(lines, "✅ Débloque : <b>" .. table.concat(unlocks, ", ") .. "</b>")
		else
			local futureNames = {}
			for _, coffin in ipairs(CoffinData.List) do
				if coffin.RebirthRequired > rebirths + 1 then
					table.insert(futureNames, coffin.Name .. " (rebirth " .. coffin.RebirthRequired .. ")")
				end
			end
			if #futureNames > 0 then
				table.insert(lines, "🔒 Bientôt : " .. table.concat(futureNames, ", "))
			end
		end
		table.insert(lines, "✅ Les bundles de coins de la boutique deviennent plus gros")
		table.insert(lines, "❌ Coins remis à 0 et monstres des cercueils retirés (les exclusifs restent)")
		benefits.Text = table.concat(lines, "\n")
		bar.Set(coins / cost, Economy.format(coins) .. " / " .. Economy.format(cost) .. " coins")
		UI.setEnabled(rebirthButton, coins >= cost)
		rebirthButton.Text = coins >= cost and "♻️ REBIRTH MAINTENANT !" or ("♻️ REBIRTH (" .. Economy.format(cost) .. " coins)")
	end

	window.OnOpen = refresh
	ctx.onAttr("Coins", function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	ctx.onAttr("Rebirths", function()
		if window.Frame.Visible then
			refresh()
		end
	end)
end

return RebirthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">SeasonController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Passe de saison : piste gratuite et premium, XP, reclamation.
local SeasonController = {}

function SeasonController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local Config = ctx.Config
	local SeasonPass = ctx.SeasonPass

	local window = UI.window("Season", Config.Season.Name, { Icon = "🎃" })
	local body = window.Body
	local header = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = UI.Colors.Panel, ZIndex = 22, Parent = body }, { UI.corner(12), UI.padding(10, 8) })
	local tierLabel = UI.label({ Text = "", Font = UI.Font, TextSize = 20, Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 23, Parent = header })
	local endLabel = UI.label({ Text = "", TextSize = 14, Size = UDim2.new(0.4, 0, 0, 26), Position = UDim2.new(0.6, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = UI.Colors.Muted, ZIndex = 23, Parent = header })
	local bar = UI.progress(header, UI.Colors.Accent, UDim2.new(0.62, 0, 0, 26), UDim2.new(0, 0, 0, 36))
	local premiumButton = UI.button({ Text = "🎃 Passe Premium  R$ " .. ctx.MonetizationIds.GamePasses.SeasonPremium.Price, Color = UI.Colors.Robux, Size = UDim2.new(0.36, 0, 0, 40), Position = UDim2.new(0.64, 0, 0, 30), ZIndex = 24, MaxTextSize = 16, Parent = header, OnClick = function()
		ctx.prompt("Pass", "SeasonPremium")
	end })
	local track = UI.new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -92), Position = UDim2.new(0, 0, 0, 92), BackgroundColor3 = UI.Colors.Panel, BackgroundTransparency = 0.2, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = UI.Colors.Accent2, AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(), ZIndex = 22, Parent = body }, {
		UI.corner(12), UI.padding(8),
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local function rewardCard(parent, tier, reward, premium, reached, claimed, hasPremium, order)
		local locked = premium and not hasPremium
		local color = claimed and Color3.fromRGB(45, 40, 65) or (premium and Color3.fromRGB(80, 40, 30) or UI.Colors.Panel2)
		local card = UI.new("Frame", { Size = UDim2.new(1, 0, 0.5, -4), BackgroundColor3 = color, LayoutOrder = order, ZIndex = 23, Parent = parent }, { UI.corner(10), UI.stroke(premium and UI.Colors.Accent or Color3.fromRGB(0, 0, 0), premium and 2 or 1, 0.3), UI.padding(6, 4) })
		local text = SeasonPass.describe(reward)
		if reward.Type == "Monster" then
			local def = ctx.MonsterData.get(reward.Id)
			text = "👻 " .. (def and def.Name or "Monstre") .. " (exclusif)"
		elseif reward.Type == "Coins" then
			text = "🪙 " .. Economy.format(reward.Amount) .. " coins"
		elseif reward.Type == "NightmareCoffin" then
			text = "⚰️ " .. reward.Amount .. " Cauchemar"
		elseif reward.Type == "CoinsBoost" then
			text = "⚡ 2x Coins " .. reward.Minutes .. " min"
		elseif reward.Type == "LuckBoost" then
			text = "🍀 2x Chance " .. reward.Minutes .. " min"
		end
		UI.label({ Text = (premium and "PREMIUM\n" or "GRATUIT\n") .. text, TextSize = 13, TextScaled = true, Size = UDim2.new(1, 0, 0.6, 0), TextColor3 = premium and UI.Colors.Gold or UI.Colors.Text, ZIndex = 24, Parent = card })
		local buttonText = claimed and "✅" or (locked and "🔒 Premium" or (reached and "Récupérer" or "🔒"))
		local button = UI.button({ Text = buttonText, Color = (reached and not claimed and not locked) and UI.Colors.Green or Color3.fromRGB(90, 85, 110), Size = UDim2.new(1, 0, 0.36, 0), Position = UDim2.fromScale(0, 0.64), ZIndex = 24, MaxTextSize = 14, Parent = card, OnClick = function()
			if locked then
				ctx.prompt("Pass", "SeasonPremium")
			elseif reached and not claimed then
				ctx.request("ClaimSeason", { Tier = tier, Premium = premium })
			end
		end })
		UI.setEnabled(button, not claimed and (locked or reached))
	end

	local function refresh()
		local state = ctx.state
		if not state then
			return
		end
		local xp = tonumber(ctx.attr("SeasonXp")) or 0
		local tier, cur, need = SeasonPass.progress(xp)
		local hasPremium = ctx.ownsPass("SeasonPremium")
		tierLabel.Text = "🎃 Palier " .. tier .. " / " .. SeasonPass.TierCount .. "   ·   XP total : " .. Economy.format(xp)
		local left = Config.Season.EndsAt - os.time()
		endLabel.Text = left > 0 and ("Fin dans " .. math.floor(left / 86400) .. "j " .. Economy.formatTime(left % 86400)) or "Saison terminée"
		if tier >= SeasonPass.TierCount then
			bar.Set(1, "Passe terminé ! 🎉")
		else
			bar.Set(cur / need, Economy.format(cur) .. " / " .. Economy.format(need) .. " XP")
		end
		premiumButton.Visible = not hasPremium
		UI.setEnabled(premiumButton, ctx.MonetizationIds.GamePasses.SeasonPremium.Id > 0)
		UI.clear(track)
		for t = 1, SeasonPass.TierCount do
			local column = UI.new("Frame", { Size = UDim2.new(0, 150, 1, 0), BackgroundTransparency = 1, LayoutOrder = t, ZIndex = 23, Parent = track }, {
				UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			local reached = tier >= t
			UI.label({ Text = "Palier " .. t, Font = UI.Font, TextSize = 15, Size = UDim2.new(1, 0, 0, 20), TextColor3 = reached and UI.Colors.Green or UI.Colors.Muted, LayoutOrder = 0, ZIndex = 24, Parent = column })
			local rewards = SeasonPass.Rewards[t]
			local cards = UI.new("Frame", { Size = UDim2.new(1, 0, 1, -28), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 23, Parent = column }, {
				UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			rewardCard(cards, t, rewards.Free, false, reached, state.Season.ClaimedFree[tostring(t)] == true, hasPremium, 1)
			rewardCard(cards, t, rewards.Premium, true, reached, state.Season.ClaimedPremium[tostring(t)] == true, hasPremium, 2)
		end
	end

	window.OnOpen = refresh
	ctx.onState(function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	ctx.onAttr("SeasonXp", function()
		if window.Frame.Visible then
			refresh()
		end
	end)
end

return SeasonController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Boutique Robux : offres, passes, boosts, coins.
local ShopController = {}

function ShopController.init(ctx)
	local UI = ctx.UI
	local Economy = ctx.Economy
	local Config = ctx.Config
	local Offers = ctx.Offers

	local window = UI.window("Shop", "Boutique", { Icon = "🛒" })
	local body = window.Body
	local content = UI.new("Frame", { Name = "Content", Size = UDim2.new(1, 0, 1, -48), Position = UDim2.new(0, 0, 0, 48), BackgroundTransparency = 1, ZIndex = 22, Parent = body })
	local list = UI.scroll(content, {})
	local currentTab = "Offers"
	local refreshing = false

	local function priceText(entry)
		return "R$ " .. tostring(entry.Price)
	end

	local function findCatalog(kind, key)
		if not ctx.state or not ctx.state.Catalog then
			return nil
		end
		local items = kind == "Pass" and ctx.state.Catalog.Passes or ctx.state.Catalog.Products
		for _, entry in ipairs(items) do
			if entry.Key == key then
				return entry
			end
		end
		return nil
	end

	local function isHidden(entry)
		return entry.Random and ctx.state and ctx.state.Restricted
	end

	-- Carte d'article
	local function itemCard(options)
		local card = UI.card(list, { Size = UDim2.new(1, 0, 0, options.Height or 92), LayoutOrder = options.LayoutOrder, Color = options.Color, Stroke = options.Stroke })
		UI.label({ Text = options.Icon or "🛒", TextSize = 34, TextScaled = true, Size = UDim2.new(0, 56, 0, 56), Position = UDim2.new(0, 0, 0.5, -28), ZIndex = 24, Parent = card })
		UI.label({ Text = options.Title, Font = UI.Font, TextSize = 20, Size = UDim2.new(1, -220, 0, 26), Position = UDim2.new(0, 64, 0, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24, Parent = card })
		UI.label({ Text = options.Desc or "", TextSize = 14, Size = UDim2.new(1, -220, 1, -34), Position = UDim2.new(0, 64, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = UI.Colors.Muted, ZIndex = 24, Parent = card })
		if options.Badge then
			local badge = UI.new("Frame", { Size = UDim2.fromOffset(150, 24), Position = UDim2.new(1, -160, 0, -14), BackgroundColor3 = options.BadgeColor or UI.Colors.Red, ZIndex = 26, Parent = card }, { UI.corner(8) })
			UI.label({ Text = options.Badge, Font = UI.Font, TextSize = 13, TextScaled = true, ZIndex = 27, Parent = badge })
		end
		local buttonText = options.ButtonText
		local color = UI.Colors.Robux
		local enabled = true
		if options.Owned then
			buttonText = "✅ Possédé"
			color = Color3.fromRGB(70, 110, 80)
			enabled = false
		elseif not options.Configured then
			buttonText = "Bientôt"
			enabled = false
		end
		local button = UI.button({ Text = buttonText, Color = color, Size = UDim2.fromOffset(140, 48), Position = UDim2.new(1, -144, 0.5, -24), ZIndex = 25, Parent = card, OnClick = function()
			if enabled and options.OnBuy then
				options.OnBuy()
			end
		end })
		UI.setEnabled(button, enabled)
		if options.Worth and enabled then
			UI.label({ Text = "<s>R$ " .. options.Worth .. "</s>", TextSize = 13, Size = UDim2.fromOffset(140, 16), Position = UDim2.new(1, -144, 0.5, 26), TextColor3 = UI.Colors.Muted, ZIndex = 25, Parent = card })
		end
		return card
	end

	local function buildOffers()
		local order = 0
		local now = os.time()
		local starter = findCatalog("Product", "StarterPack")
		local remaining = Offers.starterRemaining(tonumber(ctx.attr("StarterFirstJoin")) or 0, ctx.attr("StarterPurchased") == true, now)
		if starter and remaining > 0 and not isHidden(starter) then
			order += 1
			itemCard({
				LayoutOrder = order, Icon = "🎁", Title = "Pack de démarrage : " .. priceText(starter), Height = 110,
				Desc = Economy.format(Config.StarterPack.Coins) .. " coins + Ghosty Doré (monstre exclusif, conservé au rebirth) + 2x Coins 30 min.\n⏳ Disponible encore " .. Economy.formatTime(remaining),
				ButtonText = priceText(starter), Configured = starter.Configured, Worth = Config.StarterPack.WorthRobux, Badge = "-75% · UNE SEULE FOIS", BadgeColor = UI.Colors.Red, Color = Color3.fromRGB(70, 30, 60), Stroke = UI.Colors.Accent,
				OnBuy = function() ctx.prompt("Product", "StarterPack") end,
			})
		end
		local _, deal, rotationLeft = Offers.getFlashDeal(now)
		local dealEntry = findCatalog("Product", deal.Key)
		if dealEntry and not isHidden(dealEntry) then
			order += 1
			itemCard({
				LayoutOrder = order, Icon = "⚡", Title = "Offre flash : " .. deal.Title, Height = 110,
				Desc = deal.Desc .. "\n⏳ Change dans " .. Economy.formatTime(rotationLeft),
				ButtonText = priceText(dealEntry), Configured = dealEntry.Configured, Worth = deal.WorthRobux, Badge = "TEMPS LIMITÉ", BadgeColor = Color3.fromRGB(200, 120, 20), Color = Color3.fromRGB(60, 40, 30), Stroke = Color3.fromRGB(255, 180, 60),
				OnBuy = function() ctx.prompt("Product", deal.Key) end,
			})
		end
		local ultimate = findCatalog("Pass", "Ultimate")
		if ultimate and not isHidden(ultimate) then
			order += 1
			itemCard({
				LayoutOrder = order, Icon = "🌟", Title = "Pack Ultime : tous les passes", Height = 100,
				Desc = "2x Coins + Auto Collect + Triple Cercueil + 3 Salles + Chance x2 + VIP. Le meilleur rapport qualité-prix du jeu.",
				ButtonText = priceText(ultimate), Configured = ultimate.Configured, Owned = ctx.ownsPass("Ultimate"), Worth = 2144, Badge = "-30% · MEILLEURE VALEUR", BadgeColor = UI.Colors.Accent2, Color = Color3.fromRGB(50, 30, 80), Stroke = UI.Colors.Gold,
				OnBuy = function() ctx.prompt("Pass", "Ultimate") end,
			})
		end
		local season = findCatalog("Pass", "SeasonPremium")
		if season then
			order += 1
			itemCard({
				LayoutOrder = order, Icon = "🎃", Title = "Passe Spooky Premium", Desc = "Débloque 20 récompenses premium : coins, boosts, 11 Cercueils Cauchemar et 2 monstres exclusifs.",
				ButtonText = priceText(season), Configured = season.Configured, Owned = ctx.ownsPass("SeasonPremium"),
				OnBuy = function() ctx.prompt("Pass", "SeasonPremium") end,
			})
		end
	end

	local function buildPasses()
		if not ctx.state or not ctx.state.Catalog then
			return
		end
		local order = 0
		for _, entry in ipairs(ctx.state.Catalog.Passes) do
			if entry.Key ~= "SeasonPremium" and not isHidden(entry) then
				order += 1
				local def = ctx.MonetizationIds.GamePasses[entry.Key]
				itemCard({
					LayoutOrder = entry.Key == "Ultimate" and 0 or order, Icon = def.Icon, Title = def.Name, Desc = def.Desc,
					ButtonText = priceText(entry), Configured = entry.Configured, Owned = ctx.ownsPass(entry.Key),
					Badge = entry.Key == "Ultimate" and "-30% · TOUT INCLUS" or (entry.Key == "DoubleCoins" and "LE PLUS POPULAIRE" or nil), BadgeColor = entry.Key == "Ultimate" and UI.Colors.Accent2 or UI.Colors.Red,
					Stroke = entry.Key == "Ultimate" and UI.Colors.Gold or nil,
					OnBuy = function() ctx.prompt("Pass", entry.Key) end,
				})
			end
		end
	end

	local function buildBoosts()
		local items = {
			{ Key = "BoostCoins", Icon = "⚡", Title = "Boost 2x Coins (30 min)", Desc = "Double tous tes gains pendant 30 minutes. Se cumule avec les passes." },
			{ Key = "BoostLuck", Icon = "🍀", Title = "Boost 2x Chance (30 min)", Desc = "Double tes chances de monstres rares pendant 30 minutes (odds affichées dans la Crypte)." },
			{ Key = "ServerLuck", Icon = "🌐", Title = "Chance x2 pour TOUT le serveur (30 min)", Desc = "Tout le monde en profite et ton nom est annoncé. Parfait pour jouer entre amis." },
			{ Key = "InstantRebirth", Icon = "♻️", Title = "Rebirth instantané", Desc = "Effectue un rebirth immédiatement, sans avoir les coins nécessaires (mêmes effets qu'un rebirth normal)." },
		}
		local order = 0
		for _, item in ipairs(items) do
			local entry = findCatalog("Product", item.Key)
			if entry and not isHidden(entry) then
				order += 1
				itemCard({ LayoutOrder = order, Icon = item.Icon, Title = item.Title, Desc = item.Desc, ButtonText = priceText(entry), Configured = entry.Configured, OnBuy = function()
					ctx.prompt("Product", item.Key)
				end })
			end
		end
	end

	local function buildCoins()
		local rebirths = tonumber(ctx.attr("Rebirths")) or 0
		local order = 0
		for _, bundle in ipairs(Config.CoinBundles) do
			local entry = findCatalog("Product", bundle.Key)
			if entry and not isHidden(entry) then
				order += 1
				local amount = Economy.bundleAmount(bundle.Coins, rebirths)
				itemCard({
					LayoutOrder = order, Icon = "🪙", Title = bundle.Title .. " : " .. Economy.format(amount) .. " coins",
					Desc = rebirths > 0 and ("Bonus rebirth inclus (x" .. Economy.rebirthMultiplier(rebirths) .. "). Plus tu as de rebirths, plus tu reçois de coins !") or "Le montant augmente avec tes rebirths.",
					ButtonText = priceText(entry), Configured = entry.Configured, Badge = bundle.BestValue and "MEILLEURE VALEUR" or nil, BadgeColor = UI.Colors.Green, Stroke = bundle.BestValue and UI.Colors.Green or nil,
					OnBuy = function() ctx.prompt("Product", bundle.Key) end,
				})
			end
		end
		if ctx.state and ctx.state.Restricted then
			order += 1
			local card = UI.card(list, { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 60) })
			UI.label({ Text = "Certains articles ne sont pas disponibles dans ta région.", TextSize = 14, TextColor3 = UI.Colors.Muted, ZIndex = 24, Parent = card })
		end
	end

	local function refresh()
		if refreshing then
			return
		end
		refreshing = true
		UI.clear(list)
		if currentTab == "Offers" then
			buildOffers()
		elseif currentTab == "Passes" then
			buildPasses()
		elseif currentTab == "Boosts" then
			buildBoosts()
		elseif currentTab == "Coins" then
			buildCoins()
		end
		refreshing = false
	end

	local tabs = UI.tabs(body, {
		{ Key = "Offers", Text = "⚡ Offres" },
		{ Key = "Passes", Text = "🎟️ Passes" },
		{ Key = "Boosts", Text = "🚀 Boosts" },
		{ Key = "Coins", Text = "🪙 Coins" },
	}, function(key)
		currentTab = key
		refresh()
	end)

	window.OnOpen = function(context)
		tabs.Select(context and context.Tab or "Offers")
	end
	ctx.onState(function()
		if window.Frame.Visible then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			if window.Frame.Visible and currentTab == "Offers" then
				refresh()
			end
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Bibliotheque d'interface : styles, fenetres, boutons, listes, notifications.
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(24, 18, 44),
	Panel = Color3.fromRGB(36, 28, 62),
	Panel2 = Color3.fromRGB(48, 38, 80),
	Header = Color3.fromRGB(70, 40, 130),
	Accent = Color3.fromRGB(255, 140, 30),
	Accent2 = Color3.fromRGB(155, 92, 255),
	Green = Color3.fromRGB(94, 224, 122),
	Red = Color3.fromRGB(255, 92, 92),
	Gold = Color3.fromRGB(255, 209, 102),
	Blue = Color3.fromRGB(80, 160, 255),
	Text = Color3.fromRGB(244, 240, 255),
	Muted = Color3.fromRGB(184, 176, 208),
	Robux = Color3.fromRGB(0, 176, 111),
}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamBold
UI.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local screenGui = nil
local windows = {}
local currentWindow = nil
local toastContainer = nil
local modalLayer = nil

function UI.new(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", { Color = color or Color3.fromRGB(0, 0, 0), Thickness = thickness or 2, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.padding(px, py)
	py = py or px
	return UI.new("UIPadding", { PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px), PaddingTop = UDim.new(0, py), PaddingBottom = UDim.new(0, py) })
end

function UI.gradient(c1, c2, rotation)
	return UI.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 })
end

function UI.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.FontBody,
		TextColor3 = UI.Colors.Text,
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.fromScale(1, 1),
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults)
end

function UI.tween(instance, props, duration, style)
	local tween = TweenService:Create(instance, TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Bouton stylise. props : Text, Color, Size, Position, Parent, TextSize, OnClick
-- L'etat (couleur de base, actif) est stocke dans des attributs de l'instance.
function UI.button(props)
	local color = props.Color or UI.Colors.Accent
	local textColor = props.TextColor or Color3.fromRGB(255, 255, 255)
	local button = UI.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = color,
		Text = props.Text or "",
		Font = UI.Font,
		TextColor3 = textColor,
		TextScaled = props.TextScaled ~= false,
		TextSize = props.TextSize or 18,
		AutoButtonColor = false,
		LayoutOrder = props.LayoutOrder or 0,
		RichText = true,
		ZIndex = props.ZIndex or 1,
	}, {
		UI.corner(props.Radius or 12),
		UI.stroke(Color3.fromRGB(0, 0, 0), 2, 0.6),
		UI.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 22, MinTextSize = 10 }),
		UI.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
	})
	UI.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 190, 190), 90).Parent = button
	button:SetAttribute("BaseColor", color)
	button:SetAttribute("BaseTextColor", textColor)
	button:SetAttribute("Enabled", true)
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Enabled") then
			local base = button:GetAttribute("BaseColor")
			UI.tween(button, { BackgroundColor3 = base:Lerp(Color3.fromRGB(255, 255, 255), 0.15) }, 0.1)
		end
	end)
	button.MouseLeave:Connect(function()
		if button:GetAttribute("Enabled") then
			UI.tween(button, { BackgroundColor3 = button:GetAttribute("BaseColor") }, 0.1)
		end
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Enabled") then
			UI.tween(button, { TextTransparency = 0.35 }, 0.06)
		end
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(button, { TextTransparency = 0 }, 0.1)
	end)
	if props.OnClick then
		button.MouseButton1Click:Connect(function()
			if button:GetAttribute("Enabled") then
				props.OnClick(button)
			end
		end)
	end
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

-- Active ou desactive un bouton cree par UI.button
function UI.setEnabled(button, enabled)
	button:SetAttribute("Enabled", enabled == true)
	button.Active = enabled == true
	if enabled then
		button.BackgroundColor3 = button:GetAttribute("BaseColor") or UI.Colors.Accent
		button.TextColor3 = button:GetAttribute("BaseTextColor") or Color3.fromRGB(255, 255, 255)
	else
		button.BackgroundColor3 = Color3.fromRGB(90, 85, 110)
		button.TextColor3 = Color3.fromRGB(190, 185, 205)
	end
end

function UI.setButtonColor(button, color)
	button:SetAttribute("BaseColor", color)
	if button:GetAttribute("Enabled") then
		button.BackgroundColor3 = color
	end
end

function UI.screen()
	return screenGui
end

function UI.init(playerGui)
	screenGui = UI.new("ScreenGui", {
		Name = "HauntAHouseUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
		Parent = playerGui,
	})
	modalLayer = UI.new("Frame", { Name = "Modals", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50, Parent = screenGui })
	toastContainer = UI.new("Frame", {
		Name = "Toasts",
		Size = UDim2.new(0.5, 0, 0, 200),
		Position = UDim2.new(0.5, 0, 1, -30),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		ZIndex = 90,
		Parent = screenGui,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 200) }),
	})
	return screenGui
end

-- Fenetre modale centrale. Retourne { Frame, Body, Title }
function UI.window(name, title, options)
	options = options or {}
	local frame = UI.new("Frame", {
		Name = name,
		Size = options.Size or UDim2.fromScale(0.68, 0.76),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.Colors.Bg,
		Visible = false,
		ZIndex = 20,
		Parent = screenGui,
	}, {
		UI.corner(18),
		UI.stroke(UI.Colors.Accent2, 3, 0.2),
		UI.new("UISizeConstraint", { MaxSize = options.MaxSize or Vector2.new(980, 640), MinSize = Vector2.new(300, 240) }),
	})
	local header = UI.new("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = UI.Colors.Header, ZIndex = 21, Parent = frame }, { UI.corner(18) })
	UI.new("Frame", { Name = "HeaderFix", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), BackgroundColor3 = UI.Colors.Header, BorderSizePixel = 0, ZIndex = 21, Parent = header })
	local titleLabel = UI.label({ Name = "Title", Text = title, Font = UI.Font, TextSize = 28, TextScaled = true, Size = UDim2.new(1, -120, 1, 0), Position = UDim2.new(0, 60, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22, Parent = header })
	UI.new("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 14, Parent = titleLabel })
	if options.Icon then
		UI.label({ Name = "Icon", Text = options.Icon, TextSize = 30, TextScaled = true, Size = UDim2.new(0, 44, 1, 0), Position = UDim2.new(0, 12, 0, 0), ZIndex = 22, Parent = header })
	end
	local close = UI.button({
		Name = "Close",
		Text = "✕",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -46, 0, 6),
		ZIndex = 23,
		Parent = header,
		OnClick = function()
			UI.close(name)
		end,
	})
	close.TextScaled = true
	local body = UI.new("Frame", { Name = "Body", Size = UDim2.new(1, -20, 1, -64), Position = UDim2.new(0, 10, 0, 58), BackgroundTransparency = 1, ZIndex = 21, Parent = frame })
	local window = { Frame = frame, Body = body, Title = titleLabel, Name = name, OnOpen = nil, OnClose = nil }
	windows[name] = window
	return window
end

function UI.open(name, context)
	local window = windows[name]
	if not window then
		return
	end
	if currentWindow and currentWindow ~= window then
		UI.close(currentWindow.Name)
	end
	currentWindow = window
	window.Frame.Visible = true
	local target = window.Frame.Size
	window.Frame.Size = UDim2.new(target.X.Scale * 0.9, target.X.Offset * 0.9, target.Y.Scale * 0.9, target.Y.Offset * 0.9)
	UI.tween(window.Frame, { Size = target }, 0.18, Enum.EasingStyle.Back)
	if window.OnOpen then
		task.spawn(window.OnOpen, context)
	end
end

function UI.close(name)
	local window = windows[name]
	if not window then
		return
	end
	window.Frame.Visible = false
	if currentWindow == window then
		currentWindow = nil
	end
	if window.OnClose then
		task.spawn(window.OnClose)
	end
end

function UI.toggle(name, context)
	local window = windows[name]
	if window and window.Frame.Visible then
		UI.close(name)
	else
		UI.open(name, context)
	end
end

function UI.isOpen(name)
	local window = windows[name]
	return window ~= nil and window.Frame.Visible
end

function UI.closeAll()
	if currentWindow then
		UI.close(currentWindow.Name)
	end
end

-- Onglets : tabs = { { Key, Text } } ; onSelect(key)
function UI.tabs(parent, tabs, onSelect)
	local bar = UI.new("Frame", { Name = "Tabs", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 22, Parent = parent }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local buttons = {}
	local selected = nil
	local function select(key)
		selected = key
		for tabKey, button in pairs(buttons) do
			UI.setButtonColor(button, tabKey == key and UI.Colors.Accent or UI.Colors.Panel2)
		end
		onSelect(key)
	end
	for index, tab in ipairs(tabs) do
		local button = UI.button({
			Name = tab.Key,
			Text = tab.Text,
			Color = UI.Colors.Panel2,
			Size = UDim2.new(1 / #tabs, -6, 1, 0),
			LayoutOrder = index,
			ZIndex = 23,
			Radius = 10,
			Parent = bar,
			OnClick = function()
				select(tab.Key)
			end,
		})
		buttons[tab.Key] = button
	end
	return { Bar = bar, Select = select, Selected = function() return selected end, Buttons = buttons }
end

-- Liste defilante verticale avec disposition automatique
function UI.scroll(parent, options)
	options = options or {}
	local scroll = UI.new("ScrollingFrame", {
		Name = options.Name or "Scroll",
		Size = options.Size or UDim2.fromScale(1, 1),
		Position = options.Position or UDim2.new(),
		BackgroundColor3 = options.Background or UI.Colors.Panel,
		BackgroundTransparency = options.Background and 0 or 0.2,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UI.Colors.Accent2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = options.ZIndex or 22,
		Parent = parent,
	}, { UI.corner(12), UI.padding(8) })
	if options.Grid then
		UI.new("UIGridLayout", { CellSize = options.CellSize or UDim2.fromOffset(150, 150), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = scroll })
	else
		UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = scroll })
	end
	return scroll
end

function UI.clear(container, keepClass)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIBase") and not (keepClass and child:IsA(keepClass)) then
			child:Destroy()
		end
	end
end

-- Barre de progression. Retourne { Frame, Set = function(fraction, text) }
function UI.progress(parent, color, size, position)
	local frame = UI.new("Frame", { Name = "Progress", Size = size or UDim2.new(1, 0, 0, 24), Position = position or UDim2.new(), BackgroundColor3 = Color3.fromRGB(20, 15, 35), ZIndex = 23, Parent = parent }, { UI.corner(12), UI.stroke(Color3.fromRGB(0, 0, 0), 1, 0.5) })
	local fill = UI.new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or UI.Colors.Green, ZIndex = 24, Parent = frame }, { UI.corner(12) })
	local text = UI.label({ Name = "Text", Text = "", Font = UI.Font, TextSize = 16, TextScaled = true, ZIndex = 25, Parent = frame })
	UI.new("UITextSizeConstraint", { MaxTextSize = 18, Parent = text })
	local bar = { Frame = frame }
	function bar.Set(fraction, label)
		fraction = math.clamp(fraction or 0, 0, 1)
		UI.tween(fill, { Size = UDim2.fromScale(fraction, 1) }, 0.2)
		text.Text = label or ""
	end
	return bar
end

-- Notifications (toasts)
local TOAST_COLORS = { info = Color3.fromRGB(70, 60, 120), success = Color3.fromRGB(40, 130, 80), error = Color3.fromRGB(160, 50, 60), rare = Color3.fromRGB(190, 120, 20), boss = Color3.fromRGB(150, 40, 60), luck = Color3.fromRGB(40, 130, 60), shop = Color3.fromRGB(0, 120, 90), rebirth = Color3.fromRGB(110, 60, 190) }

function UI.toast(text, kind, duration)
	if not toastContainer then
		return
	end
	local color = TOAST_COLORS[kind or "info"] or TOAST_COLORS.info
	local frame = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		ZIndex = 91,
		LayoutOrder = math.floor(os.clock() * 1000),
		Parent = toastContainer,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(0, 0, 0), 1, 0.5), UI.padding(12, 8) })
	local label = UI.label({ Text = text, Font = UI.FontBody, TextSize = 16, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 92, Parent = frame })
	label.TextXAlignment = Enum.TextXAlignment.Center
	frame.BackgroundTransparency = 1
	label.TextTransparency = 1
	UI.tween(frame, { BackgroundTransparency = 0.1 }, 0.2)
	UI.tween(label, { TextTransparency = 0 }, 0.2)
	task.delay(duration or 4, function()
		UI.tween(frame, { BackgroundTransparency = 1 }, 0.3)
		UI.tween(label, { TextTransparency = 1 }, 0.3)
		task.wait(0.35)
		frame:Destroy()
	end)
	local children = toastContainer:GetChildren()
	local count = 0
	for _, child in ipairs(children) do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count > 5 then
		for _, child in ipairs(children) do
			if child:IsA("Frame") then
				child:Destroy()
				break
			end
		end
	end
end

-- Boite de confirmation
function UI.confirm(title, text, onYes, yesText)
	local overlay = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, ZIndex = 60, Parent = modalLayer })
	local box = UI.new("Frame", { Size = UDim2.fromOffset(380, 220), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = UI.Colors.Panel, ZIndex = 61, Parent = overlay }, { UI.corner(16), UI.stroke(UI.Colors.Accent, 3), UI.padding(16) })
	UI.label({ Text = title, Font = UI.Font, TextSize = 26, Size = UDim2.new(1, 0, 0, 40), ZIndex = 62, Parent = box })
	UI.label({ Text = text, TextSize = 16, Size = UDim2.new(1, 0, 0, 90), Position = UDim2.new(0, 0, 0, 44), ZIndex = 62, Parent = box })
	UI.button({ Text = "Annuler", Color = Color3.fromRGB(90, 85, 110), Size = UDim2.new(0.48, 0, 0, 44), Position = UDim2.new(0, 0, 1, -44), ZIndex = 62, Parent = box, OnClick = function()
		overlay:Destroy()
	end })
	UI.button({ Text = yesText or "Confirmer", Color = UI.Colors.Green, Size = UDim2.new(0.48, 0, 0, 44), Position = UDim2.new(0.52, 0, 1, -44), ZIndex = 62, Parent = box, OnClick = function()
		overlay:Destroy()
		onYes()
	end })
	return overlay
end

function UI.modalLayer()
	return modalLayer
end

-- Carte d'article generique (fond, titre, description). Retourne le frame.
function UI.card(parent, options)
	local frame = UI.new("Frame", {
		Name = options.Name or "Card",
		Size = options.Size or UDim2.new(1, 0, 0, 96),
		BackgroundColor3 = options.Color or UI.Colors.Panel2,
		LayoutOrder = options.LayoutOrder or 0,
		ZIndex = options.ZIndex or 23,
		Parent = parent,
	}, { UI.corner(12), UI.stroke(options.Stroke or Color3.fromRGB(0, 0, 0), 2, 0.5), UI.padding(10, 8) })
	return frame
end

function UI.safeInsetTop()
	local inset = GuiService:GetGuiInset()
	return inset.Y
end

return UI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Point d'entree client : contexte partage, evenements serveur, initialisation des controleurs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Net = require(Shared:WaitForChild("Net"))
local Controllers = script.Parent:WaitForChild("Controllers")
local UI = require(Controllers:WaitForChild("UI"))

UI.init(playerGui)

local function shared(name)
	return require(Shared:WaitForChild(name))
end

local ctx = {
	Player = player,
	PlayerGui = playerGui,
	UI = UI,
	Config = shared("Config"),
	Economy = shared("Economy"),
	MonsterData = shared("MonsterData"),
	CoffinData = shared("CoffinData"),
	Rarity = shared("Rarity"),
	GachaMath = shared("GachaMath"),
	SeasonPass = shared("SeasonPass"),
	DailyRewards = shared("DailyRewards"),
	Offers = shared("Offers"),
	MonsterBuilder = shared("MonsterBuilder"),
	MonetizationIds = shared("MonetizationIds"),
	state = nil,
}

local eventHandlers = {}
local stateHandlers = {}

function ctx.on(name, fn)
	eventHandlers[name] = eventHandlers[name] or {}
	table.insert(eventHandlers[name], fn)
end

function ctx.onState(fn)
	table.insert(stateHandlers, fn)
	if ctx.state then
		task.spawn(fn, ctx.state)
	end
end

function ctx.attr(name)
	return player:GetAttribute(name)
end

function ctx.onAttr(name, fn)
	local connection = player:GetAttributeChangedSignal(name):Connect(function()
		fn(player:GetAttribute(name))
	end)
	task.spawn(fn, player:GetAttribute(name))
	return connection
end

function ctx.request(action, payload)
	local ok, result = pcall(function()
		return Net.request():InvokeServer(action, payload)
	end)
	if not ok then
		UI.toast("Connexion au serveur impossible, réessaie.", "error")
		return { ok = false }
	end
	if type(result) ~= "table" then
		return { ok = false }
	end
	if result.message then
		UI.toast(result.message, result.ok and "success" or "error")
	end
	return result
end

function ctx.requestSilent(action, payload)
	local ok, result = pcall(function()
		return Net.request():InvokeServer(action, payload)
	end)
	if not ok or type(result) ~= "table" then
		return { ok = false }
	end
	return result
end

function ctx.prompt(kind, key)
	return ctx.request("Prompt", { Kind = kind, Key = key })
end

function ctx.ownsPass(key)
	return ctx.state ~= nil and ctx.state.Passes ~= nil and ctx.state.Passes[key] == true
end

function ctx.systemMessage(text)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(text)
		end
	end)
end

Net.serverEvent().OnClientEvent:Connect(function(name, payload)
	local handlers = eventHandlers[name]
	if not handlers then
		return
	end
	for _, fn in ipairs(handlers) do
		task.spawn(fn, payload)
	end
end)

ctx.on("State", function(payload)
	ctx.state = payload
	for _, fn in ipairs(stateHandlers) do
		task.spawn(fn, payload)
	end
end)
ctx.on("Notify", function(payload)
	UI.toast(payload.Text, payload.Kind)
end)
ctx.on("Announce", function(payload)
	UI.toast(payload.Text, payload.Kind, 6)
	ctx.systemMessage(payload.Text)
end)
ctx.on("OpenUI", function(payload)
	UI.open(payload.Ui, payload)
end)

-- Ecran de chargement
local loading = UI.new("Frame", { Name = "Loading", Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Colors.Bg, ZIndex = 100, Parent = UI.screen() })
UI.label({ Text = "👻 Haunt a House", Font = UI.Font, TextSize = 48, TextScaled = true, Size = UDim2.new(0.8, 0, 0.2, 0), Position = UDim2.fromScale(0.1, 0.3), ZIndex = 101, Parent = loading })
local loadingText = UI.label({ Text = "Chargement de ton manoir...", TextSize = 22, TextScaled = true, Size = UDim2.new(0.8, 0, 0.08, 0), Position = UDim2.fromScale(0.1, 0.52), ZIndex = 101, TextColor3 = UI.Colors.Muted, Parent = loading })

local controllerOrder = { "HudController", "AnimController", "ShopController", "OffersController", "CoffinController", "InventoryController", "IndexController", "RebirthController", "DailyController", "SeasonController", "CodesController", "PlaytimeController", "BossController" }
for _, name in ipairs(controllerOrder) do
	local module = Controllers:WaitForChild(name)
	local ok, err = pcall(function()
		require(module).init(ctx)
	end)
	if not ok then
		warn("[Client] Erreur d'initialisation de " .. name .. " : " .. tostring(err))
	end
end

task.spawn(function()
	local waited = 0
	while player:GetAttribute("DataLoaded") ~= true do
		task.wait(0.25)
		waited += 0.25
		if waited > 20 then
			loadingText.Text = "Le chargement prend plus de temps que prévu... patience !"
		end
	end
	ctx.requestSilent("GetState")
	local tries = 0
	while ctx.state == nil and tries < 20 do
		task.wait(0.5)
		tries += 1
		if ctx.state == nil then
			ctx.requestSilent("GetState")
		end
	end
	UI.tween(loading, { BackgroundTransparency = 1 }, 0.4)
	for _, child in ipairs(loading:GetChildren()) do
		if child:IsA("TextLabel") then
			UI.tween(child, { TextTransparency = 1 }, 0.3)
		end
	end
	task.wait(0.45)
	loading:Destroy()
	if ctx.state and ctx.state.MemoryMode then
		UI.toast("Mode Studio : les données ne sont pas sauvegardées (active l'accès API dans Game Settings > Security).", "error", 8)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
