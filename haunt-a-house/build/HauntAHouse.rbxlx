	{ Id = "dracula", Name = "Dracula", Rarity = "Legendary", Power = 3000, Visual = V("Block", { 240, 235, 240 }, "SmoothPlastic", "angry", "fangs", "top", "glow", { 200, 20, 40 }, 1.2) },

	-- Cercueil Maudit
