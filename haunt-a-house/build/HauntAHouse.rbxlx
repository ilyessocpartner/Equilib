	{ Id = "old_one", Name = "L'Ancien", Rarity = "Secret", Power = 10000000, Visual = V("Ball", { 5, 5, 5 }, "Neon", "glow", "fangs", "crown", "void", { 255, 255, 255 }, 1.6) },

